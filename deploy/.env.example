# Copy to .env beside this file, on the server only, and fill in. Never share this file or put it in a repository.

# The server's name, as Hostinger shows it. Caddy's certificate is made for this name (https://<name>:8443), and
# ci-key.sh writes it into the VPS_KNOWN_HOSTS secret.
SERVER_NAME=srv2055591.hstgr.cloud

# The password of People System's own database inside the server. Letters and digits only:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs the sign-in sessions. A long random string:  openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=

# The first admin account, created by `npm run db:seed` (see DEPLOY.md). Remove the password from this file afterwards.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# How many days of daily database saves are kept in backups/.
BACKUP_KEEP_DAYS=14

# Email, for sending job offers: your email provider's SMTP settings. Leave SMTP_HOST empty and nothing is emailed;
# HR then copies each offer's link and sends it from their own mailbox. Port 587 (STARTTLS) unless your provider says
# 465. For Google Workspace: smtp.gmail.com, the sending account, and an app password; for Microsoft 365:
# smtp.office365.com with SMTP AUTH turned on for the account. MAIL_FROM is the sender as candidates see it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TrendLIX HR <hr@trendlix.com>"

# The key the website (on Vercel) and the API share to sign the address a check-in comes from, so Attendance → Check-in
# Setup can lock Office staff's check-ins to the office network (owner, 20 October 2026). Leave it empty here and run
# ./web-key.sh: it fills it in (never replacing one) and prints the value to save as WEB_KEY in Vercel too. Without it
# on both sides the lock can't be switched on. A secret, like JWT_SECRET.
WEB_KEY=

# Push notifications to the employee app, TrendLIX People (owner, 20 October 2026: "Push notifications: yes"): the
# Firebase project's service account, from Firebase → Project settings → Service accounts → Generate new private key (a
# JSON file). Copy three of its values: project_id, client_email and private_key. The private key may be pasted as it is
# in the file, one line with \n in it, in double quotes; the API reads it either way. Without all three, push is off:
# the API says so once in its log, and notifications are kept in the inbox (the bell) only. Secrets, like JWT_SECRET:
# never in the repository or a chat.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
