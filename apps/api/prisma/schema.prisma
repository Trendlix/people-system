// People System database schema.
// Starting point: trendlix-hrms-handoff/db/schema.sql. Tables and columns keep its snake_case names.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- users & access ----------

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  key   String     @unique // employee, manager, hr, finance, ceo, admin, super_admin
  name  String
  users UserRole[]

  @@map("roles")
}

model User {
  id                String                 @id @default(uuid()) @db.Uuid
  email             String                 @unique
  passwordHash      String?                @map("password_hash")
  mfaEnabled        Boolean                @default(false) @map("mfa_enabled")
  isActive          Boolean                @default(true) @map("is_active")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  roles             UserRole[]
  auditEntries      AuditLog[]
  uploads           PaperworkItem[]
  corrections       OcrCorrection[]
  endingsHrApproved EmploymentEnding[]     @relation("EndingHrApproval") // endings this user recorded (and so approved) for HR
  endingsCeoDecided EmploymentEnding[]     @relation("EndingCeoDecision") // endings this user approved or rejected as CEO
  confirmations     ProfileConfirmation[] // the times this user confirmed their own details
  changesRequested  ProfileChangeRequest[] @relation("ChangeRequester") // changes this user asked for to their own details
  changesDecided    ProfileChangeRequest[] @relation("ChangeDecision") // change requests this user approved, rejected or cancelled
  uploadedVersions  TemplateVersion[]      @relation("TemplateUpload") // template versions this user uploaded
  publishedVersions TemplateVersion[]      @relation("TemplatePublication") // template versions this user published
  documentsMade     GeneratedDocument[]    @relation("DocumentGeneration") // documents this user generated from templates
  documentsPrinted  GeneratedDocument[]    @relation("DocumentPrinting") // documents this user marked printed
  documentsSigned   GeneratedDocument[]    @relation("DocumentSignedUpload") // documents whose signed scan this user uploaded
  documentsVerified GeneratedDocument[]    @relation("DocumentVerification") // documents this user verified
  offersCreated     JobOffer[]             @relation("OfferCreation") // job offers this user drafted
  offersSent        JobOffer[]             @relation("OfferSending") // job offers this user sent last
  offersAnswered    JobOffer[]             @relation("OfferAnswer") // job offers whose answer this user recorded
  payrollsCreated   PayrollRun[]           @relation("PayrollCreation") // payroll runs this user started
  payrollsApproved  PayrollRun[]           @relation("PayrollApproval") // payroll runs this user approved as CEO
  payslipsDrawn     Payslip[]              @relation("PayslipGeneration") // payslips drawn when this user marked a run paid or downloaded one

  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------- company profile (one row) ----------

model Company {
  id                  Int       @id @default(1) // always 1: one company per installation
  nameEn              String    @map("name_en")
  nameAr              String?   @map("name_ar") // as printed on contracts
  activity            String? // business activity, e.g. the contract preamble
  commercialRegNo     String?   @map("commercial_reg_no") // السجل التجاري
  taxRegNo            String?   @map("tax_reg_no")
  insuranceEmployerNo String?   @map("insurance_employer_no") // رقم المنشأة في التأمينات
  // social insurance Forms 1 and 6 (owner, 15 October 2026): the office (مكتب التأمينات), up to 120 characters, and the
  // sector code (قطاع المنشأة), one or two digits as the office gave it; both checked by the database too
  insuranceOffice     String?   @map("insurance_office")
  insuranceSectorCode String?   @map("insurance_sector_code")
  addressAr           String?   @map("address_ar") // as printed on contracts
  addressEn           String?   @map("address_en")
  city                String?
  phone               String?
  email               String?
  website             String?
  emailDomain         String?   @map("email_domain") // the domain every work email must use, e.g. trendlix.com
  repName             String?   @map("rep_name") // company representative who signs documents, in Arabic
  repTitle            String?   @map("rep_title") // in Arabic
  repNameEn           String?   @map("rep_name_en") // the same in English (owner, 15 October 2026: bilingual documents)
  repTitleEn          String?   @map("rep_title_en")
  repNationalId       String?   @map("rep_national_id") @db.Char(14) // RESTRICTED: never returned in full
  logo                Bytes?
  logoMimeType        String?   @map("logo_mime_type")
  logoUpdatedAt       DateTime? @map("logo_updated_at") @db.Timestamptz
  // the square brand mark beside the wide logo: the browser tab icon, and where the logo has no room (owner, 15 October 2026)
  thumbnail           Bytes?
  thumbnailMimeType   String?   @map("thumbnail_mime_type")
  thumbnailUpdatedAt  DateTime? @map("thumbnail_updated_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("company")
}

// ---------- organisation ----------

// A department (parent_id empty) or one of its teams (parent_id = the department), e.g. Marketing → Content Team.
// One level only: a team has no teams of its own. Job titles and employees can belong to either (job titles directly
// in a department, e.g. Head of Marketing: owner's decision, 15 October 2026).
model Department {
  id          String       @id @default(uuid()) @db.Uuid
  nameEn      String       @map("name_en") // unique among a department's teams; among departments, checked by the API
  nameAr      String?      @map("name_ar")
  parentId    String?      @map("parent_id") @db.Uuid
  sortOrder   Int          @default(0) @map("sort_order") // the order set by an Admin, among departments or among one department's teams
  parent      Department?  @relation("SubDepartments", fields: [parentId], references: [id], onDelete: Restrict)
  children    Department[] @relation("SubDepartments")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  jobTitles   JobTitle[]
  employments Employment[]
  offers      JobOffer[]

  @@unique([parentId, nameEn])
  @@map("departments")
}

model Shift {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique // A, B
  startTime    DateTime     @map("start_time") @db.Time(0)
  endTime      DateTime     @map("end_time") @db.Time(0)
  graceMinutes Int          @default(15) @map("grace_minutes")
  workingDays  Int[]        @default([0, 1, 2, 3, 4]) @map("working_days") @db.SmallInt // 0 = Sun … 6 = Sat
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  employments  Employment[]
  offers       JobOffer[]

  @@map("shifts")
}

// A job title takes a range of grades, not one grade (owner's decision, 15 October 2026): a Junior and a Senior Account
// Manager are both Account Managers, at different grades. The range is the lowest and the highest grade, either or
// both optional (none: any grade); each employment has the person's own grade within it.
// The job description (purpose, duties, requirements) is simple rich text, saved as cleaned HTML (owner's request, 15
// October 2026); the duty rows, which KPIs will be linked to, are read from the duties' HTML.
model JobTitle {
  id             String         @id @default(uuid()) @db.Uuid
  departmentId   String         @map("department_id") @db.Uuid
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  titleEn        String         @map("title_en")
  titleAr        String?        @map("title_ar")
  minGradeId     String?        @map("min_grade_id") @db.Uuid // the lowest grade it takes; empty: no lower limit
  minGrade       Grade?         @relation("JobTitleMinGrade", fields: [minGradeId], references: [id], onDelete: Restrict)
  maxGradeId     String?        @map("max_grade_id") @db.Uuid // the highest grade it takes; empty: no upper limit
  maxGrade       Grade?         @relation("JobTitleMaxGrade", fields: [maxGradeId], references: [id], onDelete: Restrict)
  jdPurpose      String?        @map("jd_purpose") // HTML
  jdDuties       String?        @map("jd_duties") // HTML; the duty rows are its list items and paragraphs
  jdRequirements String?        @map("jd_requirements") // HTML
  jdVersion      Int            @default(1) @map("jd_version")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  duties         JobTitleDuty[]
  employments    Employment[]
  offers         JobOffer[]

  @@unique([departmentId, titleEn])
  @@map("job_titles")
}

// The grading system (owner's table, 14 October 2026): G1 Entry Level … G9 Executive. The rank orders the hierarchy
// (1 = entry level). Job title and grade apart (owner's decision, 15 October 2026): a job title takes a range of grades,
// and an employee's grade is their employment's own, within the range of their job title.
model Grade {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique // G1 … G9
  rank        Int          @unique // 1 = lowest level
  levelEn     String       @map("level_en") // Entry Level, Junior, … Executive
  levelAr     String?      @map("level_ar")
  description String? // e.g. example job titles
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  lowestOf    JobTitle[]   @relation("JobTitleMinGrade") // job titles whose range starts at this grade
  highestOf   JobTitle[]   @relation("JobTitleMaxGrade") // job titles whose range ends at this grade
  employments Employment[]
  offers      JobOffer[]

  @@map("grades")
}

model JobTitleDuty {
  id         String   @id @default(uuid()) @db.Uuid
  jobTitleId String   @map("job_title_id") @db.Uuid
  jobTitle   JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
  position   Int
  duty       String

  @@map("job_title_duties")
}

// ---------- employees ----------

enum EmploymentType {
  full_time
  part_time
  internship
  freelance
  sales

  @@map("employment_type")
}

enum EmployeeStatus {
  active
  probation
  on_leave
  notice_period
  resigned
  terminated

  @@map("employee_status")
}

enum WorkArrangement {
  office // indoor, at the office
  wfh
  hybrid // office days and home days
  outdoor // field work: shoots, sales visits … (owner, 15 October 2026)
  indoor_outdoor // part at the office, part in the field

  @@map("work_arrangement")
}

// Lists stored as text (gender, marital status, degree …) take their values from packages/shared.
model Employee {
  id                         String                 @id @default(uuid()) @db.Uuid
  employeeCode               String                 @unique @map("employee_code") // EMP-0142: shown everywhere, different from the national ID
  insuranceNo                String?                @unique @map("insurance_no") // الرقم التأميني, the social insurance number: digits only
  // the occupation in the social insurance table (packages/shared occupations.ts), printed on Form 1 as كود المهنة: six
  // digits, checked by the database too; the name is the table's, never stored. HR sets it on the profile's Social
  // Insurance tab (owner's decision, 16 October 2026: the employee's, no longer their job title's)
  occupationCode             String?                @map("occupation_code") @db.Char(6)
  // what Form 1 prints that is the employee's own, set by HR on the Social Insurance tab (owner, 16 October 2026): the
  // subscription start (تاريخ بدء الاشتراك; none: the current employment's join date), and the wages, salary data, each
  // more than 0: the basic wage (أجر أساسي; none: the default in the contract settings) and the comprehensive wage
  // (الأجر الشامل; none: the contract's gross and allowances). The insured wage (أجر الاشتراك) is not kept: it is the
  // comprehensive wage within the year's insurable limits (owner's decision, 16 October 2026)
  insuranceStartDate         DateTime?              @map("insurance_start_date") @db.Date
  insuranceBasicWage         Decimal?               @map("insurance_basic_wage") @db.Decimal(12, 2)
  insuranceComprehensiveWage Decimal?               @map("insurance_comprehensive_wage") @db.Decimal(12, 2)
  // registered with social insurance (owner's decision, 16 October 2026): payroll deducts the employee's share and
  // counts the company's only for those registered. HR sets it on the Social Insurance tab; the payroll migration set
  // it for everyone with a social insurance number
  socialInsured              Boolean                @default(false) @map("social_insured")
  fullNameEn                 String                 @map("full_name_en")
  fullNameAr                 String                 @map("full_name_ar") // as printed on contracts
  displayName                String?                @map("display_name") // the short name the person goes by (e.g. Hazem Magdy), for the email signature
  dateOfBirth                DateTime?              @map("date_of_birth") @db.Date
  gender                     String?
  nationality                String?
  maritalStatus              String?                @map("marital_status")
  militaryStatus             String?                @map("military_status")
  // contact: phones are text, so the leading 0 is kept
  workEmail                  String?                @unique @map("work_email") // lower case; a sign-in account with this email is this employee
  personalEmail              String?                @map("personal_email")
  mobile                     String?
  mobile2                    String? // a second mobile number
  addressAr                  String?                @map("address_ar")
  city                       String? // the city or district, in Arabic as on the ID card (e.g. مدينة نصر)
  governorate                String?
  buildingNo                 String?                @map("building_no") // the address's building number (عقار رقم) on social insurance Forms 1 and 6, up to 10 characters (owner, 15 October 2026)
  emergencyName              String?                @map("emergency_name")
  emergencyRelation          String?                @map("emergency_relation")
  emergencyMobile            String?                @map("emergency_mobile")
  // education (the main qualification; qualification_ar is printed on contracts)
  university                 String?
  faculty                    String?
  degree                     String?
  major                      String?
  graduationYear             Int?                   @map("graduation_year") @db.SmallInt
  educationGrade             String?                @map("education_grade")
  qualificationAr            String?                @map("qualification_ar")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  identity                   EmployeeIdentity?
  bank                       EmployeeBank?
  paperwork                  PaperworkItem[]
  employments                Employment[]           @relation("Employments")
  managing                   Employment[]           @relation("Manager") // the employments this person is the manager of
  confirmations              ProfileConfirmation[]
  changeRequests             ProfileChangeRequest[]
  documents                  GeneratedDocument[]
  offers                     JobOffer[]             @relation("OfferPerson") // offers made to this person: as a former employee, or the offer they were hired from
  offersManaging             JobOffer[]             @relation("OfferManager") // offers whose position reports to this person
  payrollLines               PayrollLine[] // the person's pay, month by month

  @@map("employees")
}

// One period of employment, from hiring to its end (resignation, termination …). The profile (Employee) is kept for
// good; a person hired again gets a new employment and the earlier ones stay as their history (owner's decision,
// 14 October 2026). At most one employment per person is current: the one without an end date (checked by the API).
// The person's grade is the employment's own, within the range of grades its job title takes (owner's decision,
// 15 October 2026; checked by the API).
model Employment {
  id               String              @id @default(uuid()) @db.Uuid
  employeeId       String              @map("employee_id") @db.Uuid
  employee         Employee            @relation("Employments", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentType   EmploymentType      @map("employment_type")
  status           EmployeeStatus      @default(probation) // resigned or terminated once ended
  departmentId     String?             @map("department_id") @db.Uuid // a team, or a department
  department       Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitleId       String?             @map("job_title_id") @db.Uuid
  jobTitle         JobTitle?           @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  gradeId          String?             @map("grade_id") @db.Uuid // the person's own grade, within the job title's range
  grade            Grade?              @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  managerId        String?             @map("manager_id") @db.Uuid
  manager          Employee?           @relation("Manager", fields: [managerId], references: [id], onDelete: Restrict)
  joinDate         DateTime            @map("join_date") @db.Date
  probationEnd     DateTime?           @map("probation_end") @db.Date
  workArrangement  WorkArrangement     @default(office) @map("work_arrangement")
  officeDays       Int[]               @default([]) @map("office_days") @db.SmallInt // Hybrid only; 0 = Sun … 6 = Sat
  shiftId          String?             @map("shift_id") @db.Uuid
  shift            Shift?              @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  jdAcknowledgedAt DateTime?           @map("jd_acknowledged_at") @db.Date
  endDate          DateTime?           @map("end_date") @db.Date // empty while current
  endReason        String?             @map("end_reason") // packages/shared END_REASONS: resigned, terminated, contract_ended …
  endNote          String?             @map("end_note")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  contracts        Contract[]
  endings          EmploymentEnding[]
  documents        GeneratedDocument[]
  payrollLines     PayrollLine[]

  @@index([employeeId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([gradeId])
  @@index([managerId])
  @@map("employments")
}

// RESTRICTED (HR, CEO). Kept apart from employees so it is never loaded by accident; the full numbers are only
// returned by GET /employees/:id/identity, and every such view is written to the audit log.
model EmployeeIdentity {
  employeeId    String    @id @map("employee_id") @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nationalId    String?   @unique @map("national_id") @db.Char(14)
  printedNo     String?   @map("printed_no") // الرقم المطبوع
  issueDate     DateTime? @map("issue_date") @db.Date // printed as MM/YYYY
  expiryDate    DateTime? @map("expiry_date") @db.Date
  // No longer used (owner, 15 October 2026: not on the card); kept so nothing already typed in is lost.
  issuingOffice String?   @map("issuing_office")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("employee_identity")
}

// RESTRICTED (HR, Finance, CEO). Account number and IBAN are only returned in full by GET /employees/:id/bank,
// and every such view is written to the audit log.
model EmployeeBank {
  employeeId String   @id @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bankName   String?  @map("bank_name")
  branch     String?
  accountNo  String?  @map("account_no")
  iban       String? // EG + 27 digits
  holderName String?  @map("holder_name")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("employee_bank")
}

// Scanned paperwork in the employee file (spec §8.5): national ID front and back, certificates, Form 1 …
// The file is kept in the database, so the daily backup includes it. Its text, read by the OCR service, makes it
// searchable. National ID scans are restricted like the national ID itself (HR, CEO).
model PaperworkItem {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind         String // packages/shared PAPERWORK_KINDS
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  data         Bytes
  ocrStatus    String    @default("pending") @map("ocr_status") // pending, done, failed, unavailable
  ocrText      String?   @map("ocr_text")
  ocrAt        DateTime? @map("ocr_at") @db.Timestamptz
  documentNo   String?   @map("document_no") // the number printed on the paper, if any
  expiresOn    DateTime? @map("expires_on") @db.Date // when the paper stops being valid, if it does
  // a personal photo's square shown in the circle beside the name (PhotoCrop, packages/shared), as fractions of the
  // photo as shown; null: the whole photo, centred. The file itself is never changed by it.
  photoCrop    Json?     @map("photo_crop")
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz

  @@index([employeeId, kind])
  @@map("paperwork_items")
}

// Fixes learned from HR's corrections to ID card readings (src/paperwork/corrections.ts): whole words of the Arabic
// name or the address as read, and as HR corrected them. Applied to the next readings. Never national ID numbers or
// dates.
model OcrCorrection {
  id          String   @id @default(uuid()) @db.Uuid
  field       String // fullNameAr, addressAr
  wrong       String // the word(s) as read
  right       String // as HR corrected them
  timesSeen   Int      @default(1) @map("times_seen") // how often HR made this same correction
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([field, wrong])
  @@map("ocr_corrections")
}

// ---------- contracts and how an employment ends ----------
// The owner's decisions of 15 October 2026, checked against Labour Law No. 14 of 2025: every employment type has a
// fixed-term contract of a year, renewed in writing before it expires; the first months are probation, once per
// employer (Art. 90); an ending is recorded and approved by HR, then approved by the CEO, and takes effect when HR
// completes it on or after the last working day. Lists stored as text take their values from packages/shared
// (contracts.ts).

// The defaults for new contracts (one row, id 1): how many months of probation (the law's cap is 3, Art. 90) and how
// long a fixed term runs.
model ContractSettings {
  id                    Int      @id @default(1) // always 1
  probationMonths       Int      @default(3) @map("probation_months") // 0–3
  durationMonths        Int      @default(12) @map("duration_months") // 1–60
  // the basic wage social insurance Form 1 prints for an employee who has none of their own (owner, 16 October 2026)
  insuranceBasicDefault Decimal  @default(410) @map("insurance_basic_default") @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("contract_settings")
}

// The ways an employment can end (ENDING_RULES), seeded from ENDING_RULE_DEFAULTS. HR tunes the label, the notice,
// pay in lieu and whether it is offered; who starts it, how it ends the employment and its legal source stay as seeded.
model EndingRule {
  key          String             @id // ENDING_RULES, e.g. resignation
  label        String
  initiator    String // INITIATORS: employee, company, either, none
  noticeAmount Int                @map("notice_amount") // 0–365
  noticeUnit   String             @map("notice_unit") // NOTICE_UNITS: days, working_days, weeks, months
  payInLieu    Boolean            @map("pay_in_lieu") // whether the notice may be paid instead of worked
  endReason    String             @map("end_reason") // END_REASONS: what the employment's end reason becomes
  source       String // the article of the law or the contract clause it comes from
  active       Boolean            @default(true) // offered when ending an employment
  sortOrder    Int                @map("sort_order") // ENDING_RULES order
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  endings      EmploymentEnding[]

  @@map("ending_rules")
}

// One version of an employment's contract. Version 1 is the first; a renewal or a change of terms is a new version,
// and signing it replaces (supersedes) the one before. A signed version is never edited, except the dates it was
// signed and filed and its note. The job title, grade, department and shift are copied from the employment when it is
// signed, so the contract keeps what was agreed.
model Contract {
  id                  String              @id @default(uuid()) @db.Uuid
  number              String              @unique // CON-<start year>-<4-digit sequence per year>, e.g. CON-2026-0007
  employmentId        String              @map("employment_id") @db.Uuid
  employment          Employment          @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  version             Int // 1, 2 … within the employment
  form                String              @default("fixed") // always fixed: the company has no open-ended contracts (owner, 15 October 2026)
  startDate           DateTime            @map("start_date") @db.Date
  endDate             DateTime?           @map("end_date") @db.Date // start + duration − 1 day
  durationMonths      Int?                @map("duration_months")
  probationMonths     Int                 @default(0) @map("probation_months") // 0–3, and 0 on a renewal (Art. 90)
  probationEnd        DateTime?           @map("probation_end") @db.Date // start + probation − 1 day; empty without probation
  // RESTRICTED (HR, Finance, CEO), like bank details
  grossSalary         Decimal             @map("gross_salary") @db.Decimal(12, 2)
  basicPercent        Int                 @default(80) @map("basic_percent") // the basic salary's share of the gross; the rest is variable
  netSalary           Decimal?            @map("net_salary") @db.Decimal(12, 2) // the approximate net, typed by HR
  insuredSalary       Decimal             @map("insured_salary") @db.Decimal(12, 2) // the gross and insured allowances, within the start year's insurable wage limits
  // how the pay is set (owner's request, 15 October 2026): a monthly salary, or by the hour (part-time), when the gross
  // is the monthly estimate, hourly rate × hours a week × 52 ÷ 12
  payBasis            String              @default("monthly") @map("pay_basis") // PAY_BASES: monthly, hourly
  hourlyRate          Decimal?            @map("hourly_rate") @db.Decimal(10, 2) // hourly only
  hoursPerWeek        Decimal?            @map("hours_per_week") @db.Decimal(4, 1) // hourly only: the contracted hours
  daysPerWeek         Int?                @map("days_per_week") // working days a week (part-time: 2, 3 …); empty: the shift's week
  allowances          ContractAllowance[] // RESTRICTED like the salary
  // copied from the employment when signed
  jobTitleEn          String?             @map("job_title_en")
  jobTitleAr          String?             @map("job_title_ar")
  gradeCode           String?             @map("grade_code")
  departmentName      String?             @map("department_name") // a team as "Department › Team"
  shiftCode           String?             @map("shift_code")
  status              String              @default("draft") // CONTRACT_STATUSES: draft, active (signed), ended, superseded
  signedOn            DateTime?           @map("signed_on") @db.Date
  insuranceFiledOn    DateTime?           @map("insurance_filed_on") @db.Date
  labourOfficeFiledOn DateTime?           @map("labour_office_filed_on") @db.Date
  note                String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  documents           GeneratedDocument[] // its printed copies (the contract slots), generated from templates
  payrollLines        PayrollLine[] // the months paid on its terms

  @@unique([employmentId, version])
  @@index([status, endDate])
  @@map("contracts")
}

// How an employment ends: resignation, non-renewal, an ending during probation … (one of the ending rules). HR
// records it, which counts as HR's approval; the CEO approves or rejects it; HR completes it on or after the last
// working day, which ends the employment.
model EmploymentEnding {
  id              String              @id @default(uuid()) @db.Uuid
  employmentId    String              @map("employment_id") @db.Uuid
  employment      Employment          @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  ruleKey         String              @map("rule_key")
  rule            EndingRule          @relation(fields: [ruleKey], references: [key], onDelete: Restrict)
  initiator       String? // employee or company; empty for death and disability
  noticeGivenOn   DateTime            @map("notice_given_on") @db.Date // the day the notice was received, or the event date
  payInLieu       Boolean             @default(false) @map("pay_in_lieu")
  lastWorkingDay  DateTime            @map("last_working_day") @db.Date // worked out from the rule's notice
  // resignation only: certified at the labour office (Decree 187/2025); the company decides within 10 days
  certifiedOffice String?             @map("certified_office")
  certifiedSerial String?             @map("certified_serial")
  certifiedOn     DateTime?           @map("certified_on") @db.Date
  decisionDueOn   DateTime?           @map("decision_due_on") @db.Date
  reason          String?
  note            String?
  status          String              @default("pending_ceo") // ENDING_STATUSES
  hrApprovedById  String?             @map("hr_approved_by") @db.Uuid // who recorded it
  hrApprovedBy    User?               @relation("EndingHrApproval", fields: [hrApprovedById], references: [id], onDelete: SetNull)
  hrApprovedAt    DateTime?           @map("hr_approved_at") @db.Timestamptz
  ceoDecidedById  String?             @map("ceo_decided_by") @db.Uuid
  ceoDecidedBy    User?               @relation("EndingCeoDecision", fields: [ceoDecidedById], references: [id], onDelete: SetNull)
  ceoDecidedAt    DateTime?           @map("ceo_decided_at") @db.Timestamptz
  ceoNote         String?             @map("ceo_note")
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  documents       GeneratedDocument[] // the resignation request, the clearance and Form 6 generated for it

  @@index([employmentId])
  @@index([status])
  @@index([ruleKey])
  @@map("employment_endings")
}

// ---------- the employee's own check of their details ----------
// Owner's decision, 15 October 2026: an employee confirms their personal, contact, emergency contact and education
// details (packages/shared CONFIRM_FIELDS) once, and again after every change, accepting the statement that they are
// responsible for what they confirmed (PROFILE_DISCLAIMER). They don't edit the data: they ask for a change, which HR
// or an Admin approves (the change is then made as an HR edit) or rejects.

// One confirmation, with the values confirmed. The confirmation is up to date while every confirmed field still has
// the value in the snapshot: a change by HR makes it stale, and changing the field back makes it up to date again.
model ProfileConfirmation {
  id                String   @id @default(uuid()) @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId            String   @map("user_id") @db.Uuid // who confirmed: the employee's own sign-in account
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  confirmedAt       DateTime @default(now()) @map("confirmed_at") @db.Timestamptz
  disclaimerVersion Int      @map("disclaimer_version") // the PROFILE_DISCLAIMER version accepted
  snapshot          Json // { field: value } for every CONFIRM_FIELDS key, dates as YYYY-MM-DD, empty as null

  @@index([employeeId, confirmedAt])
  @@map("profile_confirmations")
}

// A change the employee asked for to their own details. HR or an Admin approves it (the change is made) or rejects
// it; the employee may cancel it while it waits. One waits per employee at a time (checked by the API).
model ProfileChangeRequest {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedById String    @map("requested_by") @db.Uuid // the employee's own sign-in account
  requestedBy   User      @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  changes       Json // [{ field, from, to }] in CONFIRM_FIELDS order, values as an HR edit would save them
  note          String?
  status        String    @default("pending") // CHANGE_REQUEST_STATUSES: pending, approved, rejected, cancelled
  decidedById   String?   @map("decided_by") @db.Uuid // who approved or rejected it, or the employee who cancelled it
  decidedBy     User?     @relation("ChangeDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz
  decisionNote  String?   @map("decision_note")

  @@index([status])
  @@index([employeeId])
  @@map("profile_change_requests")
}

// ---------- document templates ----------
// The template library (spec §8; owner's request, 15 October 2026: "Start working on the templates tab; I need to
// upload the templates"). HR uploads each Word file exactly as used today, with merge tags such as {{full_name_ar}}
// where the data goes; the system never changes the wording, it only replaces the tags. Each upload is a new version
// of its slot (packages/shared TEMPLATE_SLOTS): a draft until it is published, and publishing retires the version in
// use. A version that was in use is kept, so documents made from it keep their version; only a draft can be deleted.

// One uploaded version of a template. The tags are read from the file when it is uploaded; a version with tags the
// dictionary doesn't have (unknown_tags) or with broken ones can't be published. At most one version per slot is
// published (checked by the API, in a transaction).
model TemplateVersion {
  id            String              @id @default(uuid()) @db.Uuid
  slotKey       String              @map("slot_key") // a TEMPLATE_SLOTS key (checked by the API); never a copy's (copyOf)
  version       Int // 1, 2 … within the slot
  fileName      String              @map("file_name")
  mimeType      String              @map("mime_type") // a Word document (.docx) or a PDF, checked by its content
  sizeBytes     Int                 @map("size_bytes")
  data          Bytes
  format        String              @default("docx") // docx: a Word template with {{tags}}; pdf: a form with its fields placed on it
  pdfPages      Json?               @map("pdf_pages") // a PDF's pages as shown (PdfPageSize[], packages/shared), read at upload
  pdfFields     Json?               @map("pdf_fields") // the fields placed on a PDF (PdfField[]); [] until HR places them
  language      String // TEMPLATE_LANGUAGES: ar, en
  tags          String[] // the dictionary's tags found (a PDF: its fields' tags), in order of first appearance
  unknownTags   String[]            @map("unknown_tags") // well-formed tags the dictionary doesn't have
  broken        String[] // fragments that look like a tag but aren't one, e.g. "{{ full_name_ar" (at most 20)
  status        String              @default("draft") // TEMPLATE_VERSION_STATUSES: draft, published, retired
  note          String?
  uploadedById  String?             @map("uploaded_by") @db.Uuid
  uploadedBy    User?               @relation("TemplateUpload", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt    DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz
  publishedById String?             @map("published_by") @db.Uuid
  publishedBy   User?               @relation("TemplatePublication", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz
  documents     GeneratedDocument[] // the documents filled in from this version
  offers        JobOffer[] // the job offers filled in from this version

  @@unique([slotKey, version])
  @@map("template_versions")
}

// ---------- documents generated from templates ----------
// The profile's Contracts tab (spec §8.3–8.4; owner's request, 15 October 2026): the documents the company issues from
// the published templates, each with its lifecycle, generated → printed → signed copy uploaded → verified. Generating
// fills the published version's {{tags}} with the employee's values and keeps the filled .docx; the version used is
// kept (it is never deleted once published), so a document always says which version it came from. The signed scan
// is checked and kept like paperwork. Only a Super Admin deletes one.

// One document generated for an employee: the contract (each copy) of a contract version, a job offer, an NDA, a
// letter, a certificate, a social insurance form, the resignation request or the clearance.
model GeneratedDocument {
  id                 String            @id @default(uuid()) @db.Uuid
  employeeId         String            @map("employee_id") @db.Uuid
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId       String?           @map("employment_id") @db.Uuid // the employment it was issued under
  employment         Employment?       @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  contractId         String?           @map("contract_id") @db.Uuid // a contract slot's contract version
  contract           Contract?         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  endingId           String?           @map("ending_id") @db.Uuid // the resignation request's, the clearance's and Form 6's ending
  ending             EmploymentEnding? @relation(fields: [endingId], references: [id], onDelete: Cascade)
  slotKey            String            @map("slot_key") // a TEMPLATE_SLOTS key (checked by the API)
  templateVersionId  String            @map("template_version_id") @db.Uuid // the published version it was filled in from
  templateVersion    TemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  // what was typed when generating, e.g. { "letter_to": "…", "letter_purpose": "…" }
  inputs             Json              @default("{}")
  documentDate       DateTime          @map("document_date") @db.Date // the date printed on it ({{date}}, {{contract_date}})
  // the filled .docx
  fileName           String            @map("file_name")
  data               Bytes
  sizeBytes          Int               @map("size_bytes")
  hasRestricted      Boolean           @map("has_restricted") // it prints restricted data (national ID, salary, bank): every view is audited
  status             String            @default("generated") // generated, printed, signed, verified
  generatedById      String?           @map("generated_by") @db.Uuid
  generatedBy        User?             @relation("DocumentGeneration", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt        DateTime          @default(now()) @map("generated_at") @db.Timestamptz
  printedById        String?           @map("printed_by") @db.Uuid
  printedBy          User?             @relation("DocumentPrinting", fields: [printedById], references: [id], onDelete: SetNull)
  printedAt          DateTime?         @map("printed_at") @db.Timestamptz
  signedUploadedById String?           @map("signed_uploaded_by") @db.Uuid
  signedUploadedBy   User?             @relation("DocumentSignedUpload", fields: [signedUploadedById], references: [id], onDelete: SetNull)
  signedUploadedAt   DateTime?         @map("signed_uploaded_at") @db.Timestamptz
  verifiedById       String?           @map("verified_by") @db.Uuid
  verifiedBy         User?             @relation("DocumentVerification", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?         @map("verified_at") @db.Timestamptz
  // the signed copy, scanned: a photo or a PDF, checked by its content like paperwork
  signedFileName     String?           @map("signed_file_name")
  signedMime         String?           @map("signed_mime")
  signedSize         Int?              @map("signed_size")
  signedData         Bytes?            @map("signed_data")
  note               String?

  @@index([employeeId, slotKey])
  @@map("generated_documents")
}

// ---------- audit ----------

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String // create, update, delete, login, view_restricted …
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  diff       Json?
  at         DateTime @default(now()) @db.Timestamptz

  @@index([entityType, entityId])
  @@map("audit_log")
}

// ---------- allowances ----------
// Allowances paid every month on top of the gross salary (owner's request, 15 October 2026): their kinds are set by HR,
// each taxed or not and counted in the insured wage or not. A cash allowance is taxed by law (Law 91/2005 Art. 9; the
// Tax Authority's FAQ, Q17); only transport the company itself provides is exempt. A contract or an offer keeps each
// allowance's name and treatment as they were when it was drafted, so a later change to a kind changes neither.

model AllowanceType {
  id        String              @id @default(uuid()) @db.Uuid
  nameEn    String              @unique @map("name_en")
  nameAr    String              @map("name_ar")
  taxable   Boolean             @default(true) // counted in the salary tax
  insured   Boolean             @default(false) // counted in the insured wage (within its limits)
  active    Boolean             @default(true) // an inactive kind isn't offered for new contracts and offers
  sortOrder Int                 @default(0) @map("sort_order")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  contracts ContractAllowance[]
  offers    OfferAllowance[]

  @@map("allowance_types")
}

// An allowance of a contract version, a month. RESTRICTED (HR, Finance, CEO), like the salary.
model ContractAllowance {
  id              String        @id @default(uuid()) @db.Uuid
  contractId      String        @map("contract_id") @db.Uuid
  contract        Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  allowanceTypeId String        @map("allowance_type_id") @db.Uuid
  allowanceType   AllowanceType @relation(fields: [allowanceTypeId], references: [id], onDelete: Restrict)
  nameEn          String        @map("name_en") // as the kind was when the contract was drafted or last changed
  nameAr          String        @map("name_ar")
  taxable         Boolean
  insured         Boolean
  amount          Decimal       @db.Decimal(12, 2)

  @@unique([contractId, allowanceTypeId])
  @@map("contract_allowances")
}

// An allowance of a job offer, a month. RESTRICTED like the salary.
model OfferAllowance {
  id              String        @id @default(uuid()) @db.Uuid
  offerId         String        @map("offer_id") @db.Uuid
  offer           JobOffer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  allowanceTypeId String        @map("allowance_type_id") @db.Uuid
  allowanceType   AllowanceType @relation(fields: [allowanceTypeId], references: [id], onDelete: Restrict)
  nameEn          String        @map("name_en")
  nameAr          String        @map("name_ar")
  taxable         Boolean
  insured         Boolean
  amount          Decimal       @db.Decimal(12, 2)

  @@unique([offerId, allowanceTypeId])
  @@map("offer_allowances")
}

// ---------- job offers ----------
// The offer stage (owner's request, 15 October 2026): a candidate is not an employee. HR drafts the offer (the person,
// the position and the terms), fills in the job offer template, and sends it: by email from the system, or as a link
// HR sends. The candidate opens the link, reads the offer and accepts it (typing their name) or declines it; HR can
// also record an answer given another way. Only once accepted does the person get a profile, with the employment and
// a draft contract made from the offer, so candidates never appear in the employee lists and counts.
model JobOffer {
  id                String           @id @default(uuid()) @db.Uuid
  number            String           @unique // OFF-<year drafted>-<4-digit sequence per year>
  status            String           @default("draft") // OFFER_STATUSES: draft, sent, accepted, declined, withdrawn (expired is worked out)
  // the candidate
  fullNameEn        String           @map("full_name_en")
  fullNameAr        String           @map("full_name_ar")
  email             String // their personal email, where the offer is sent
  mobile            String?
  employeeId        String?          @map("employee_id") @db.Uuid // a former employee offered again; once accepted, the profile
  employee          Employee?        @relation("OfferPerson", fields: [employeeId], references: [id], onDelete: SetNull)
  // the position
  employmentType    EmploymentType   @map("employment_type")
  departmentId      String?          @map("department_id") @db.Uuid
  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitleId        String?          @map("job_title_id") @db.Uuid
  jobTitle          JobTitle?        @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  gradeId           String?          @map("grade_id") @db.Uuid
  grade             Grade?           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  managerId         String?          @map("manager_id") @db.Uuid
  manager           Employee?        @relation("OfferManager", fields: [managerId], references: [id], onDelete: Restrict)
  shiftId           String?          @map("shift_id") @db.Uuid
  shift             Shift?           @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  workArrangement   WorkArrangement  @default(office) @map("work_arrangement")
  officeDays        Int[]            @default([]) @map("office_days") @db.SmallInt // Hybrid only; 0 = Sun … 6 = Sat
  joinDate          DateTime         @map("join_date") @db.Date // the expected first day
  // the terms: RESTRICTED (HR, Finance, CEO), like a contract's
  payBasis          String           @default("monthly") @map("pay_basis") // PAY_BASES
  grossSalary       Decimal          @map("gross_salary") @db.Decimal(12, 2) // a month; hourly: the monthly estimate
  hourlyRate        Decimal?         @map("hourly_rate") @db.Decimal(10, 2)
  hoursPerWeek      Decimal?         @map("hours_per_week") @db.Decimal(4, 1)
  daysPerWeek       Int?             @map("days_per_week")
  basicPercent      Int              @default(80) @map("basic_percent")
  netSalary         Decimal?         @map("net_salary") @db.Decimal(12, 2)
  probationMonths   Int              @default(3) @map("probation_months")
  durationMonths    Int              @default(12) @map("duration_months")
  allowances        OfferAllowance[]
  expiresOn         DateTime         @map("expires_on") @db.Date // the last day to accept
  message           String? // a few words to the candidate, in the email
  note              String? // for HR only
  // the document, as sent (a draft's is filled in afresh each time it is previewed)
  templateVersionId String?          @map("template_version_id") @db.Uuid
  templateVersion   TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  documentDate      DateTime?        @map("document_date") @db.Date
  fileName          String?          @map("file_name") // the .docx's name; the PDF's is the same with .pdf
  data              Bytes? // the filled .docx
  pdf               Bytes? // the same as PDF, when the converter answered
  // sending
  tokenHash         String?          @unique @map("token_hash") // SHA-256 of the link's secret; sending again replaces it
  sentVia           String?          @map("sent_via") // email, link
  sentTo            String?          @map("sent_to")
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz
  sentById          String?          @map("sent_by") @db.Uuid
  sentBy            User?            @relation("OfferSending", fields: [sentById], references: [id], onDelete: SetNull)
  sentCount         Int              @default(0) @map("sent_count")
  viewedAt          DateTime?        @map("viewed_at") @db.Timestamptz // the candidate first opened the link
  // the answer
  respondedAt       DateTime?        @map("responded_at") @db.Timestamptz
  answeredById      String?          @map("answered_by") @db.Uuid // HR recorded it; empty when the candidate answered online
  answeredBy        User?            @relation("OfferAnswer", fields: [answeredById], references: [id], onDelete: SetNull)
  acceptedName      String?          @map("accepted_name") // the name the candidate typed to accept
  declineReason     String?          @map("decline_reason")
  responseIp        String?          @map("response_ip")
  responseAgent     String?          @map("response_agent")
  withdrawnAt       DateTime?        @map("withdrawn_at") @db.Timestamptz
  withdrawReason    String?          @map("withdraw_reason")
  hiredAt           DateTime?        @map("hired_at") @db.Timestamptz // the profile, employment and draft contract were made from it
  createdById       String?          @map("created_by") @db.Uuid
  createdBy         User?            @relation("OfferCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([employeeId])
  @@map("job_offers")
}

// ---------- payroll ----------
// Monthly payroll, phase 1 (owner's decisions, 16 October 2026): worked out the way the owner's payroll sheet does it,
// with its formula errors fixed (packages/shared payroll.ts). Built before attendance: HR types the month's hours and
// days on the run, and attendance will fill the same inputs later. HR prepares a run, the CEO approves it (the CEO
// only), then it is locked and HR marks it paid; salaries go by bank file (CIB's payroll system for CIB accounts, ACH
// for every other bank). Amounts are salary data: HR, Finance and the CEO only.

// The rules a run is worked out with and the company's side of the bank files (one row, id 1). Each run copies the
// rules when it is made and when it is refreshed, so a later change never alters a run already worked out.
model PayrollSettings {
  id                     Int      @id @default(1) // always 1
  dayDivisor             Int      @default(30) @map("day_divisor") // a month counts as this many days (day rates, part months)
  attendanceGracePercent Decimal  @default(90) @map("attendance_grace_percent") @db.Decimal(5, 2) // attendance from here on counts as full
  kpiGracePercent        Decimal  @default(80) @map("kpi_grace_percent") @db.Decimal(5, 2) // a KPI average from here on counts as full
  overtimeAbovePercent   Decimal  @default(110) @map("overtime_above_percent") @db.Decimal(5, 2) // overtime is paid for attendance above this
  overtimeRate           Decimal  @default(1.5) @map("overtime_rate") @db.Decimal(4, 2)
  noShowDayMultiplier    Decimal  @default(2) @map("no_show_day_multiplier") @db.Decimal(4, 2) // a no-show day costs this many days' pay
  cibDebitAccount        String?  @map("cib_debit_account") // the company's CIB account the salaries are paid from: 12 digits
  cibDebitAccountName    String?  @map("cib_debit_account_name") // its name, as CIB has it
  achPurpose             String   @default("CASH") @map("ach_purpose") // the ACH file's TransactionPurpose
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payroll_settings")
}

// One month's payroll: a run per month. Its lines are worked out again whenever their inputs change while it is a
// draft; once the CEO approves it nothing changes but its being marked paid.
model PayrollRun {
  id             String        @id @default(uuid()) @db.Uuid
  month          DateTime      @unique @db.Date // the month's first day
  status         String        @default("draft") // PAYROLL_STATUSES: draft, pending_ceo, approved, paid
  rules          Json // the PayrollRules it is worked out with: the settings', copied when made and when refreshed
  exclusions     Json          @default("[]") // the people left out when made or refreshed, and why: [{ employeeId, employeeCode, name, reason }]
  createdById    String?       @map("created_by") @db.Uuid
  createdBy      User?         @relation("PayrollCreation", fields: [createdById], references: [id], onDelete: SetNull)
  submittedAt    DateTime?     @map("submitted_at") @db.Timestamptz // sent to the CEO, last
  approvedById   String?       @map("approved_by") @db.Uuid
  approvedBy     User?         @relation("PayrollApproval", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?     @map("approved_at") @db.Timestamptz
  returnedReason String?       @map("returned_reason") // why the CEO sent it back to HR, until it is sent again
  paidOn         DateTime?     @map("paid_on") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  lines          PayrollLine[]

  @@map("payroll_runs")
}

// One employee's pay in a run: what it is worked out from (the contract in force and the profile, as they were when
// the run was made or last refreshed), the month's inputs HR typed, and the result step by step, with its totals in
// columns of their own for sums. RESTRICTED (HR, Finance, CEO), like the salary. The bank details are copied when the
// CEO approves the run, so the bank files pay what was approved: RESTRICTED like EmployeeBank.
model PayrollLine {
  id                String         @id @default(uuid()) @db.Uuid
  runId             String         @map("run_id") @db.Uuid
  run               PayrollRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  // kept while any run has the person: their pay stays on record
  employeeId        String         @map("employee_id") @db.Uuid
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentId      String         @map("employment_id") @db.Uuid
  employment        Employment     @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  contractId        String         @map("contract_id") @db.Uuid
  contract          Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  // as they were when the run was made or refreshed
  employeeCode      String         @map("employee_code")
  nameEn            String         @map("name_en")
  department        String? // a team as "Department › Team"
  jobTitle          String?        @map("job_title")
  employmentType    EmploymentType @map("employment_type")
  payBasis          String         @map("pay_basis") // PAY_BASES
  terms             Json // PayrollTerms
  inputs            Json // PayrollInputs
  result            Json // PayrollResult
  // the result's totals, for sums across lines and runs
  earned            Decimal        @db.Decimal(12, 2)
  allowances        Decimal        @db.Decimal(12, 2)
  employeeInsurance Decimal        @map("employee_insurance") @db.Decimal(12, 2)
  employerInsurance Decimal        @map("employer_insurance") @db.Decimal(12, 2)
  monthlyTax        Decimal        @map("monthly_tax") @db.Decimal(12, 2)
  martyrsFund       Decimal        @map("martyrs_fund") @db.Decimal(12, 2)
  deductions        Decimal        @db.Decimal(12, 2)
  net               Decimal        @db.Decimal(12, 2)
  released          Decimal        @db.Decimal(12, 2)
  transfer          Decimal        @db.Decimal(12, 2)
  companyCost       Decimal        @map("company_cost") @db.Decimal(12, 2)
  onHold            Boolean        @default(false) @map("on_hold") // not paid by the bank files this month
  comments          String?
  // the bank details as they were when the CEO approved the run
  bankShort         String?        @map("bank_short") // the EG-ACH list's short code (CIB, QNB …); a bank not on the list as typed
  accountNo         String?        @map("account_no")
  iban              String?
  holderName        String?        @map("holder_name")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  payslips          Payslip[] // the line's payslip, in English and, when asked for, in Arabic

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([employmentId])
  @@index([contractId])
  @@map("payroll_lines")
}

// A payslip (owner's decisions, 16 October 2026): drawn by the system from an approved line, straight to a protected
// PDF, and kept. The English one is issued for every line not on hold when HR marks the run paid; the Arabic one is
// drawn the first time it is asked for. A payslip is never edited or drawn again once kept: the run is locked from the
// CEO's approval on. RESTRICTED (HR, Finance, CEO), like the line.
model Payslip {
  id            String      @id @default(uuid()) @db.Uuid
  lineId        String      @map("line_id") @db.Uuid
  line          PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  language      String // PAYSLIP_LANGUAGES: en, ar
  fileName      String      @map("file_name")
  data          Bytes // the protected PDF
  sizeBytes     Int         @map("size_bytes")
  generatedById String?     @map("generated_by") @db.Uuid
  generatedBy   User?       @relation("PayslipGeneration", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime    @default(now()) @map("generated_at") @db.Timestamptz

  @@unique([lineId, language])
  @@map("payslips")
}
