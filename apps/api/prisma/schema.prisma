// People System database schema.
// Starting point: trendlix-hrms-handoff/db/schema.sql. Tables and columns keep its snake_case names.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- users & access ----------

model Role {
  id    String     @id @default(uuid()) @db.Uuid
  key   String     @unique // employee, manager, hr, finance, ceo, admin, super_admin
  name  String
  users UserRole[]

  @@map("roles")
}

model User {
  id                        String                     @id @default(uuid()) @db.Uuid
  email                     String                     @unique
  passwordHash              String?                    @map("password_hash")
  mfaEnabled                Boolean                    @default(false) @map("mfa_enabled")
  isActive                  Boolean                    @default(true) @map("is_active")
  // the employee whose account this is (owner, 22 October 2026: "any active employee with active contract should have
  // access"): the link, never the email (the migration filled it for the accounts whose email was an employee's work
  // email); none for an account that isn't an employee's (the Users page's)
  employeeId                String?                    @unique @map("employee_id") @db.Uuid
  employee                  Employee?                  @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  // the Assets access (owner, 21 October 2026: "3 levels per user"): none, viewer, custodian, manager (ASSETS_ACCESS_LEVELS),
  // set on the Users page by an Admin or a Super Admin; a Super Admin is always a manager, the CEO and Finance always
  // at least viewers (assetsAccessOf, packages/shared assets.ts)
  assetsAccess              String                     @default("none") @map("assets_access")
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  roles                     UserRole[]
  auditEntries              AuditLog[]                 @relation("AuditUser") // what was done as this user
  auditOnBehalf             AuditLog[]                 @relation("AuditOnBehalf") // what this Super Admin did while viewing as someone, in their name
  uploads                   PaperworkItem[]
  corrections               OcrCorrection[]
  endingsHrApproved         EmploymentEnding[]         @relation("EndingHrApproval") // endings this user recorded (and so approved) for HR
  endingsCeoDecided         EmploymentEnding[]         @relation("EndingCeoDecision") // endings this user approved or rejected as CEO
  confirmations             ProfileConfirmation[] // the times this user confirmed their own details
  changesRequested          ProfileChangeRequest[]     @relation("ChangeRequester") // changes this user asked for to their own details
  changesDecided            ProfileChangeRequest[]     @relation("ChangeDecision") // change requests this user approved, rejected or cancelled
  photosRequested           ProfilePhotoRequest[]      @relation("PhotoRequester") // new photos of themself this user sent HR
  photosDecided             ProfilePhotoRequest[]      @relation("PhotoDecision") // photo requests this user approved, rejected or cancelled
  uploadedVersions          TemplateVersion[]          @relation("TemplateUpload") // template versions this user uploaded
  publishedVersions         TemplateVersion[]          @relation("TemplatePublication") // template versions this user published
  documentsMade             GeneratedDocument[]        @relation("DocumentGeneration") // documents this user generated from templates
  documentsPrinted          GeneratedDocument[]        @relation("DocumentPrinting") // documents this user marked printed
  documentsSigned           GeneratedDocument[]        @relation("DocumentSignedUpload") // documents whose signed scan this user uploaded
  documentsVerified         GeneratedDocument[]        @relation("DocumentVerification") // documents this user verified
  offersCreated             JobOffer[]                 @relation("OfferCreation") // job offers this user drafted
  offersSent                JobOffer[]                 @relation("OfferSending") // job offers this user sent last
  offersAnswered            JobOffer[]                 @relation("OfferAnswer") // job offers whose answer this user recorded
  // recruitment (22 October 2026): the vacancies this user drafted, sent for approval, decided (the CEO) or closed, and
  // the applicants' steps they took
  vacanciesCreated          Vacancy[]                  @relation("VacancyCreation")
  vacanciesSubmitted        Vacancy[]                  @relation("VacancySubmission")
  vacanciesDecided          Vacancy[]                  @relation("VacancyDecision")
  vacanciesClosed           Vacancy[]                  @relation("VacancyClosing")
  applicationSteps          JobApplicationStep[]
  // recruitment, Phase 2 (22 October 2026): interviews this user scheduled, changed or marked; suggestions as a hiring
  // manager; the rejection email's words; onboarding checklists and items
  interviewsMade            Interview[]                @relation("InterviewCreation")
  interviewsChanged         Interview[]                @relation("InterviewChange")
  interviewsMarked          Interview[]                @relation("InterviewOutcome")
  suggestionsMade           JobApplication[]           @relation("ApplicationSuggestion")
  screeningCallsMade        JobApplication[]           @relation("ApplicationScreeningCall")
  recruitmentSettingsSet    RecruitmentSettings[]      @relation("RecruitmentSettingsChange")
  cvPositionChoicesSet      CvPositionChoice[]         @relation("CvPositionChoiceChange")
  portfolioSettingsSet      PortfolioSetting[]         @relation("PortfolioSettingChange") // a job title's portfolio on the careers forms (25 October 2026)
  linkedinSettingsSet       LinkedInSettings[]         @relation("LinkedInSettingsChange") // "Fill in with LinkedIn" (25 October 2026)
  mailSettingsSet           MailSettings[]             @relation("MailSettingsChange") // the email settings, when this user saved them last
  mapsSettingsSet           MapsSettings[]             @relation("MapsSettingsChange") // the Google Maps settings, when this user saved them last
  // online interview meetings (owner, 24 October 2026: "make it both"): the meeting apps this user saved last, their own
  // meetings connections (an HR person's Google, Microsoft or Zoom account), and the connections this user made
  meetingAppsSet            MeetingApp[]               @relation("MeetingAppChange")
  meetingConnections        MeetingConnection[]        @relation("MeetingConnectionOwner")
  meetingConnectionsMade    MeetingConnection[]        @relation("MeetingConnectionBy")
  // interviewers' availability (owner, 25 October 2026: "Hours + calendar"): the company's interview defaults and anyone's
  // interview hours this user saved last, the Zoho app they saved, their own calendar connections and those they made
  interviewSettingsSet      InterviewSettings[]        @relation("InterviewSettingsChange")
  interviewHoursSet         InterviewHours[]           @relation("InterviewHoursChange")
  calendarAppsSet           CalendarApp[]              @relation("CalendarAppChange")
  calendarConnections       CalendarConnection[]       @relation("CalendarConnectionOwner")
  calendarConnectionsMade   CalendarConnection[]       @relation("CalendarConnectionBy")
  // Zoho People's attendance pulled in (owner, 25 October 2026: "Yes, daily + backfill"): the connection this user made,
  // and the fetches they started or cancelled
  zohoPeopleConnectionsMade ZohoPeopleConnection[]     @relation("ZohoPeopleConnectionBy")
  zohoPeopleRunsStarted     ZohoPeopleRun[]            @relation("ZohoPeopleRunStartedBy")
  zohoPeopleRunsCancelled   ZohoPeopleRun[]            @relation("ZohoPeopleRunCancelledBy")
  zohoPeopleExclusionsAdded ZohoPeopleExclusion[]      @relation("ZohoPeopleExclusionBy")
  onboardingDefaultsSet     OnboardingDefault[]        @relation("OnboardingDefaultChange")
  onboardingOpened          OnboardingChecklist[]      @relation("OnboardingOpening")
  onboardingCompleted       OnboardingChecklist[]      @relation("OnboardingCompletion")
  onboardingItemsDone       OnboardingItem[]           @relation("OnboardingItemDone")
  // general CVs and the bulk upload (22 October 2026): the consents this user recorded, the CVs they added, what they did
  // to them, and the CVs waiting in their batch
  applicationConsents       JobApplication[]           @relation("ApplicationConsent")
  generalCvConsents         GeneralCv[]                @relation("GeneralCvConsent")
  generalCvsAdded           GeneralCv[]                @relation("GeneralCvCreation")
  generalCvEvents           GeneralCvEvent[]
  cvUploads                 CvUpload[]
  payrollsCreated           PayrollRun[]               @relation("PayrollCreation") // payroll runs this user started
  payrollsApproved          PayrollRun[]               @relation("PayrollApproval") // payroll runs this user approved as CEO
  payslipsDrawn             Payslip[]                  @relation("PayslipGeneration") // payslips drawn when this user marked a run paid or downloaded one
  lawRatesChanged           PayrollLawYear[]           @relation("LawRatesChange") // years of the rates set by law this user changed last
  adjustmentsMade           PayrollAdjustment[]        @relation("AdjustmentEntry") // additions and deductions this user entered
  adjustmentsCut            PayrollAdjustment[]        @relation("AdjustmentCancel") // additions and deductions this user cancelled
  advancesGiven             PayrollAdvance[]           @relation("AdvanceEntry") // advances and loans this user entered
  advancesSettled           PayrollAdvance[]           @relation("AdvanceSettlement") // advances and loans this user marked settled
  recurringMade             RecurringDeduction[]       @relation("RecurringDeductionEntry") // recurring deductions this user set up
  recurringConsents         RecurringDeduction[]       @relation("RecurringDeductionConsent") // recurring deductions whose signed consent this user recorded
  settlementsMade           FinalSettlement[]          @relation("FinalSettlementBy") // final settlements this user marked settled
  holdsReleased             PayrollHoldRelease[]       @relation("HoldReleaseBy") // held pay this user recorded as paid out
  lockedChangesMade         PayrollLockedChange[]      @relation("LockedChangeBy") // leave or attendance changes this user made after the month's payroll moved on (27 October 2026)
  lockedChangesHandled      PayrollLockedChange[]      @relation("LockedChangeHandledBy") // those this user marked handled
  raisesApproved            Contract[]                 @relation("RaiseApproval") // raises (and renewals with new pay) this user approved as CEO
  raisesRequested           RaiseRequest[]             @relation("RaiseRequester") // raise requests this user made
  raisesDeclined            RaiseRequest[]             @relation("RaiseRequestDecline") // raise requests this user declined (HR or the CEO)
  raiseRequestSteps         RaiseRequestStep[]         @relation("RaiseRequestStepActor") // steps of raise requests this user took
  reimbursementsSent        ReimbursementClaim[]       @relation("ReimbursementCreation") // reimbursement claims this user sent
  reimbursementSteps        ReimbursementClaimStep[]   @relation("ReimbursementStepActor") // steps of reimbursement claims this user took
  leaveRequestsMade         LeaveRequest[]             @relation("LeaveRequestCreation") // leave requests this user sent, or recorded for an employee as HR
  leaveSteps                LeaveRequestStep[]         @relation("LeaveStepActor") // steps of leave requests this user took
  leaveAdjustments          LeaveAdjustment[]          @relation("LeaveAdjustmentBy") // changes to annual leave balances this user made as HR
  leaveClosings             LeaveYearClosing[]         @relation("LeaveYearClosingBy") // the years this user closed the leave balances of
  leaveYearsClosed          LeaveBalanceYear[]         @relation("LeaveBalanceClosedBy") // the balances this user closed: at a Year Closing, or paid on leaving
  leaveSetupChanged         LeaveSettings[]            @relation("LeaveSettingsBy") // the Leave Setup, when this user changed it last
  staffingLimitsSet         LeaveStaffingLimit[]       @relation("StaffingLimitBy") // the staffing limits this user set last (25 October 2026)
  leaveImports              LeaveImport[]              @relation("LeaveImportBy") // leave files this user uploaded (21 October 2026)
  leaveImportApplied        LeaveImport[]              @relation("LeaveImportAppliedBy") // leave imports this user applied last
  leaveImportsUndone        LeaveImport[]              @relation("LeaveImportUndoneBy") // leave imports this user undid last
  permissionsMade           PermissionRequest[]        @relation("PermissionRequestCreation") // permission requests this user sent, or recorded for an employee as HR
  attendanceImports         AttendanceImport[]         @relation("AttendanceImportBy") // attendance files this user uploaded on a payroll run
  attendanceApplied         AttendanceImport[]         @relation("AttendanceImportAppliedBy") // attendance imports this user applied to a run's lines last
  attendanceDays            AttendanceDay[]            @relation("AttendanceDayImportedBy") // days of attendance this user's apply kept
  permissionSteps           PermissionRequestStep[]    @relation("PermissionStepActor") // steps of permission requests this user took
  wfhRequestsMade           WfhRequest[]               @relation("WfhRequestCreation") // work from home days this user asked for, recorded as HR or imported (21 October 2026)
  wfhSteps                  WfhRequestStep[]           @relation("WfhStepActor") // steps of work from home requests this user took
  resignationsRecorded      ResignationRequest[]       @relation("ResignationRecorder") // resignation requests this user recorded as endings (26 October 2026)
  resignationsReturned      ResignationRequest[]       @relation("ResignationReturner") // resignation requests this user returned
  compensatoryMade          CompensatoryRequest[]      @relation("CompensatoryCreation") // compensatory days this user asked for or recorded (26 October 2026)
  compensatorySteps         CompensatoryStep[]         @relation("CompensatoryStepActor")
  odRequestsMade            OdRequest[]                @relation("OdRequestCreation") // official duties this user asked for (23 October 2026)
  odSteps                   OdRequestStep[]            @relation("OdStepActor") // steps of official duty requests this user took
  attendancePunches         AttendancePunch[]          @relation("AttendancePunchBy") // the presses of Check in and Check out this user made
  correctionsMade           AttendanceCorrection[]     @relation("AttendanceCorrectionCreation") // attendance corrections this user asked for, or made directly as HR
  correctionSteps           AttendanceCorrectionStep[] @relation("AttendanceCorrectionStepActor") // steps of attendance corrections this user took
  sessions                  Session[] // this user's sign-ins, active and ended
  accessLinks               AccessLink[]               @relation("AccessLinkUser") // their set-password links (22 October 2026)
  loginCodes                LoginCode[] // their sign-in codes by email (31 October 2026)
  attendanceRecordsRemoved  AttendanceRecordRemoval[]  @relation("AttendanceRecordRemovedBy") // attendance records this Super Admin removed (31 October 2026)
  attendanceRecordsRestored AttendanceRecordRemoval[]  @relation("AttendanceRecordRestoredBy")
  attendanceDaySources      AttendanceDaySource[]      @relation("AttendanceDaySourceChosenBy") // the days whose source this Super Admin chose
  accessLinksMade           AccessLink[]               @relation("AccessLinkCreatedBy") // the set-password links this user made for others
  deviceCredentials         DeviceCredential[] // the phones this user signs in on with a fingerprint, active and revoked
  homeLocationsMade         HomeLocationRequest[]      @relation("HomeLocationCreation") // home location requests this user sent (their own)
  homeLocationSteps         HomeLocationStep[]         @relation("HomeLocationStepActor") // steps of home location requests this user took
  notifications             Notification[] // this user's inbox (the bell), newest first
  pushDevices               PushDevice[] // the phones this user's notifications are pushed to
  notificationSettings      NotificationSettings? // this user's reminder switches; none: both on
  remindersSent             ReminderSent[] // the reminders sent to this user, one a day of each kind
  kpiSettingsChanged        KpiSettings[]              @relation("KpiSettingsBy") // the KPI deadlines, when this user changed them last
  kpiTemplatesMade          KpiTemplate[]              @relation("KpiTemplateCreation") // KPI template versions this user started as drafts
  kpiTemplatesPublished     KpiTemplate[]              @relation("KpiTemplatePublication") // KPI template versions this user published
  kpiScored                 KpiScorecard[]             @relation("KpiScorecardScoredBy") // KPI scorecards this user scored (as the manager, HR or the CEO)
  kpiCalibrated             KpiScorecard[]             @relation("KpiScorecardCalibratedBy") // KPI scorecards this user calibrated as HR
  kpiManagerSigned          KpiScorecard[]             @relation("KpiScorecardManagerSignedBy") // KPI scorecards this user signed as the manager
  kpiSteps                  KpiScorecardStep[]         @relation("KpiScorecardStepActor") // steps of KPI scorecards this user took
  kpiPracticeStarted        KpiScorecard[]             @relation("KpiScorecardPracticeBy") // practice KPI scorecards this user started (22 October 2026)
  kpiFrameworksMade         KpiFramework[]             @relation("KpiFrameworkCreation") // KPI framework versions (the pillars) this user made
  kpiFrameworksChanged      KpiFramework[]             @relation("KpiFrameworkChange") // KPI framework versions this user changed last
  assetSettingsChanged      AssetSettings[]            @relation("AssetSettingsBy") // the asset settings, when this user changed them last (21 October 2026)
  assetsCreated             Asset[]                    @relation("AssetCreation") // the assets this user registered
  assetsDisposed            Asset[]                    @relation("AssetDisposal") // the assets this user recorded the disposal of
  assetPhotosUploaded       AssetPhoto[]               @relation("AssetPhotoUpload") // the asset photos this user added
  assetKitsCreated          AssetKit[]                 @relation("AssetKitCreation") // the production kits this user made
  custodyIssued             CustodyRecord[]            @relation("CustodyIssuedBy") // the custody records this user recorded
  custodyReceived           CustodyItem[]              @relation("CustodyReceivedBy") // the custody items this user received back
  custodyFilesUploaded      CustodyFile[]              @relation("CustodyFileUpload") // the signed custody forms this user attached
  assetMaintenanceMade      AssetMaintenance[]         @relation("AssetMaintenanceBy") // the maintenance entries this user made
  assetStockMoves           AssetStockMove[]           @relation("AssetStockMoveBy") // the stock moves this user made
  assetCounts               AssetCount[]               @relation("AssetCountBy") // the asset counts this user made
  assetsMarkedLost          AssetCountLine[]           @relation("AssetCountLostBy") // the missing assets this user marked lost after a count
  connectorCodes            ConnectorCode[] // the Claude connector's sign-in codes this user allowed (21 October 2026)
  assetDraftsMade           AssetDraft[]               @relation("AssetDraftCreation") // the asset drafts made in this user's name, through the Claude connector
  assetDraftsConfirmed      AssetDraft[]               @relation("AssetDraftConfirmation") // the asset drafts this user confirmed into assets
  assetDraftsDiscarded      AssetDraft[]               @relation("AssetDraftDiscard") // the asset drafts this user discarded
  assetDraftImagesAdded     AssetDraftImage[]          @relation("AssetDraftImageAdd") // the product images Claude added to drafts in this user's name
  clearanceDefaultsSet      ClearanceDefault[]         @relation("ClearanceDefaultChange") // the default clearance items this user changed last (22 October 2026)
  offboardingOpened         OffboardingCase[]          @relation("OffboardingOpening") // the offboarding cases this user opened
  offboardingCompleted      OffboardingCase[]          @relation("OffboardingCompletion") // the offboarding cases this user completed
  offboardingRehireSet      OffboardingCase[]          @relation("OffboardingRehire") // the rehire decisions this user made
  offboardingItemsDone      OffboardingItem[]          @relation("OffboardingItemDone") // the clearance items this user cleared
  exitInterviewsMade        ExitInterview[]            @relation("ExitInterviewRecording") // the exit interviews this user sent or recorded
  // candidate profiles (22 October 2026): the possible matches this user decided, the merges they made and undid
  candidateMatchesDecided   CandidateMatch[]           @relation("CandidateMatchDecision")
  candidateMergesMade       CandidateMerge[]           @relation("CandidateMergeBy")
  candidateMergesUndone     CandidateMerge[]           @relation("CandidateMergeUndo")
  screeningComments         ScreeningComment[]         @relation("ScreeningCommentAuthor")
  // Suggested From Earlier CVs (24 October 2026): the suggestions this user added, invited or dismissed
  vacancySuggestionsDecided VacancySuggestion[]        @relation("VacancySuggestionDecision")
  // access follows the contract (owner, 23 October 2026): the 7 days' grace this user gave
  accessGracesGiven         AccessGrace[]              @relation("AccessGraceGrantedBy")
  // WhatsApp notifications (owner, 24 October 2026: "how to make whatsapp notifications?"): the settings this user saved
  // last, their own opt-in, and the WhatsApp messages sent to them
  whatsAppSettingsSet       WhatsAppSettings[]         @relation("WhatsAppSettingsChange")
  whatsAppOptIn             WhatsAppOptIn?
  whatsAppMessages          WhatsAppMessage[]
  // people exempt from check-in (owner, 25 October 2026): the exemptions this user added, and those they ended
  checkInExemptionsAdded    CheckInExemption[]         @relation("CheckInExemptionAddedBy")
  checkInExemptionsEnded    CheckInExemption[]         @relation("CheckInExemptionEndedBy")
  agencyMarks               AgencyMark[]               @relation("AgencyMarkBy")

  @@map("users")
}

// A notification (owner, 20 October 2026: "Push notifications: yes (decisions, things waiting for someone, a check-in
// reminder)"; apps/mobile/README.md, Phase 4): kept in the user's inbox (the bell) and pushed to their phones when push
// is set up. Short and general (names and dates, never a salary, an amount, a reason or a comment). `link`: where it
// opens on the site. The rules: packages/shared notifications.ts; the emitter: apps/api/src/notifications.
model Notification {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // NOTIFICATION_KINDS
  title     String
  body      String
  link      String? // an address on the site, e.g. /leave/<id>
  readAt    DateTime?      @map("read_at") @db.Timestamptz
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  reminders ReminderSent[] // the check-in reminder's day this row stands for (one row a day, refreshed at each step)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

// A phone the user's notifications are pushed to (Phase 4): its FCM token, registered from the app (an app session,
// never while viewing as someone), refreshed each time the app opens signed in, removed when they sign out in the app
// or FCM says the token is gone. One user a token: the last to sign in on a shared phone gets its notifications.
model PushDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String // PUSH_PLATFORMS: android, ios
  token      String   @unique
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen") @db.Timestamptz

  @@index([userId])
  @@map("push_devices")
}

// A user's reminder switches (Phase 4): "Still checked in?", on until switched off. "You haven't checked in" is always on
// (owner, 20 October 2026: "No, always on"): its column is kept but no longer read or written.
model NotificationSettings {
  userId           String   @id @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInReminder  Boolean  @default(true) @map("check_in_reminder")
  checkOutReminder Boolean  @default(true) @map("check_out_reminder")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("notification_settings")
}

// A reminder sent (Phase 4): one row a user, working day (in Cairo) and kind. "You haven't checked in" goes every 10
// minutes for 2 hours (owner, 20 October 2026: "a reminder for people that didn't checkin and not on a leave every 10
// minutes. like a popup"): `count` how many went that day, `lastSentAt` when the last went, so each 10-minute step goes
// once, whichever of the API's processes looks first; "Still checked in?" once a day. `notificationId`: the day's one
// inbox row, refreshed at each step (none: a new one next time).
model ReminderSent {
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  day            DateTime      @db.Date
  kind           String // REMINDER_KINDS: check_in_reminder, check_out_reminder
  count          Int           @default(1)
  lastSentAt     DateTime      @default(now()) @map("last_sent_at") @db.Timestamptz
  notificationId String?       @map("notification_id") @db.Uuid
  notification   Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@id([userId, day, kind])
  @@map("reminders_sent")
}

// A phone's fingerprint sign-in (owner, 20 October 2026: "Sign-in: Face ID / fingerprint after the first password
// sign-in"; apps/mobile/README.md, Phase 3): the API gave the phone a random secret, kept here only as its SHA-256, which
// the phone keeps behind the fingerprint and trades for an ordinary app session. One active a user per phone (device name
// and platform). It stops signing in when revoked (DEVICE_REVOKE_REASONS) or after 90 days without use. The rules:
// packages/shared device-credentials.ts and apps/api/src/auth/device-rules.ts.
model DeviceCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName   String    @map("device_name") // what the phone calls itself, e.g. "Google Pixel 8", up to 100 characters
  platform     String // DEVICE_PLATFORMS: android, ios
  secretHash   String    @unique @map("secret_hash") // SHA-256 of the secret, in hex; never the secret
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz // the last fingerprint sign-in; null until the first
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason") // DEVICE_REVOKE_REASONS

  @@index([userId, revokedAt])
  @@map("device_credentials")
}

// A sign-in, kept on the server (owner, 20 October 2026: "make any admin or HR session to be valid for 15 minutes
// inactive, then session to be terminated; only 1 active session per user online and 1 active mobile session"). The
// session token names it (sid); the API refuses a token whose session has ended. One active session of each kind a user:
// a new sign-in of the same kind ends the older one ('replaced'); a website and an app session can be active together.
// HR, Admin and Super Admin are signed out after 15 minutes without activity ('idle'), on both. The rules: packages/shared
// sessions.ts and apps/api/src/auth/session-rules.ts.
model Session {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String // SESSION_KINDS: web, app
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  // the last request that counted as activity (the web's own background requests don't), kept at most every 30 seconds
  lastActiveAt DateTime         @default(now()) @map("last_active_at") @db.Timestamptz
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz // 8 hours after signing in, as the token's expiry
  endedAt      DateTime?        @map("ended_at") @db.Timestamptz
  endReason    String?          @map("end_reason") // SESSION_END_REASONS: signed_out, replaced, idle, expired, revoked
  userAgent    String?          @map("user_agent") // the browser's or the app's, up to 300 characters
  ip           String?
  // how a developer who holds another role uses it (owner, 22 October 2026: "give hin a switched to use the account as
  // the main role assigned to him or as a developer"; packages/shared session-modes.ts): SESSION_MODES 'self' or
  // 'developer'; null until they choose on the website, and for everyone else
  mode         String?
  // a Claude connector's (kind 'connector', owner, 21 October 2026: "the connection method"): the client it was allowed
  // for, its scope (assets), the MCP address its tokens are for (RFC 8707), and its tokens; null on the other kinds
  clientId     String?          @map("client_id")
  client       ConnectorClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  scope        String?
  resource     String?
  tokens       ConnectorToken[]
  codes        ConnectorCode[]

  @@index([userId, endedAt])
  @@index([clientId])
  @@map("sessions")
}

// The Claude connector's OAuth clients (owner, 21 October 2026: "the connection method"; packages/shared connector.ts):
// one Claude registered by dynamic client registration (RFC 7591; its id "tlxcl_…"), or read from a Client ID Metadata
// Document on Claude's own hosts (its id that address). Its return addresses are only Claude's documented ones; a
// client registered with a secret keeps only the secret's SHA-256. One never used is removed a day after registering.
model ConnectorClient {
  id           String          @id
  kind         String // dcr, cimd
  name         String // client_name, e.g. "Claude"
  redirectUris String[]        @map("redirect_uris")
  authMethod   String          @default("none") @map("auth_method") // none, client_secret_post, client_secret_basic
  secretHash   String?         @map("secret_hash")
  ip           String? // where it registered from, as the website saw it
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  usedAt       DateTime?       @map("used_at") @db.Timestamptz // the last time a person allowed it
  fetchedAt    DateTime?       @map("fetched_at") @db.Timestamptz // a metadata document's: when it was read
  codes        ConnectorCode[]
  sessions     Session[]

  @@index([createdAt])
  @@map("connector_clients")
}

// A sign-in code (RFC 6749 §4.1, with PKCE): given when a person presses Allow, redeemed once within 5 minutes by the
// client it was given to, at the return address it was given for, with the verifier of its S256 challenge. Kept only as
// its SHA-256; the session its tokens started is kept, so a code used twice ends that session.
model ConnectorCode {
  id            String          @id @default(uuid()) @db.Uuid
  codeHash      String          @unique @map("code_hash")
  clientId      String          @map("client_id")
  client        ConnectorClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String          @map("user_id") @db.Uuid
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String          @map("redirect_uri")
  codeChallenge String          @map("code_challenge")
  scope         String
  resource      String
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz
  usedAt        DateTime?       @map("used_at") @db.Timestamptz
  sessionId     String?         @map("session_id") @db.Uuid
  session       Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("connector_codes")
}

// A connector session's tokens: access tokens for an hour, refresh tokens rotated on every use (the old one marked
// rotated: used again, the session ends). Kept only as their SHA-256 (the token is given once); they end with the session.
model ConnectorToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      String // access, refresh
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz // a refresh token: when it was used for a new one

  @@index([sessionId, kind])
  @@map("connector_tokens")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------- company profile (one row) ----------

model Company {
  id                  Int       @id @default(1) // always 1: one company per installation
  nameEn              String    @map("name_en")
  nameAr              String?   @map("name_ar") // as printed on contracts
  activity            String? // business activity, e.g. the contract preamble
  commercialRegNo     String?   @map("commercial_reg_no") // السجل التجاري
  taxRegNo            String?   @map("tax_reg_no")
  insuranceEmployerNo String?   @map("insurance_employer_no") // رقم المنشأة في التأمينات
  // social insurance Forms 1 and 6 (owner, 15 October 2026): the office (مكتب التأمينات), up to 120 characters, and the
  // sector code (قطاع المنشأة), one or two digits as the office gave it; both checked by the database too
  insuranceOffice     String?   @map("insurance_office")
  insuranceSectorCode String?   @map("insurance_sector_code")
  addressAr           String?   @map("address_ar") // as printed on contracts
  addressEn           String?   @map("address_en")
  city                String?
  phone               String?
  email               String?
  website             String?
  emailDomain         String?   @map("email_domain") // the domain every work email must use, e.g. trendlix.com
  repName             String?   @map("rep_name") // company representative who signs documents, in Arabic
  repTitle            String?   @map("rep_title") // in Arabic
  repNameEn           String?   @map("rep_name_en") // the same in English (owner, 15 October 2026: bilingual documents)
  repTitleEn          String?   @map("rep_title_en")
  repNationalId       String?   @map("rep_national_id") @db.Char(14) // RESTRICTED: never returned in full
  logo                Bytes?
  logoMimeType        String?   @map("logo_mime_type")
