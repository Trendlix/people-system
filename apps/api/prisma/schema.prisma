  // the square brand mark beside the wide logo: the browser tab icon, and where the logo has no room (owner, 15 October 2026)
  thumbnail           Bytes?
  thumbnailMimeType   String?   @map("thumbnail_mime_type")
  thumbnailUpdatedAt  DateTime? @map("thumbnail_updated_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("company")
}

// The company's email (SMTP) settings (one row, id 1; owner, 23 October 2026: "why dont we add SMTP setup in the
// organization setup"): Organization → Email Settings, a Super Admin's only. Used while switched on and complete; else
// the server's deploy/.env, as before. The password is kept encrypted (AES-256-GCM, a key derived from JWT_SECRET:
// apps/api/src/mail/mail-secret.ts), never returned; password_key_id says which key sealed it, so the page can say it
// must be entered again without opening it. Lists stored as text take their values from packages/shared mail-settings.ts.
model MailSettings {
  id              Int       @id @default(1)
  provider        String    @default("other") // MAIL_PROVIDERS: google, microsoft, zoho, other
  host            String?
  port            Int       @default(587)
  security        String    @default("starttls") // MAIL_SECURITIES: starttls, ssl, none
  username        String?
  passwordEnc     String?   @map("password_enc") // "v1:iv:tag:ciphertext", base64url; RESTRICTED: never returned
  passwordKeyId   String?   @map("password_key_id") // a fingerprint of the key that sealed it, never the key
  fromName        String?   @map("from_name")
  fromAddress     String?   @map("from_address")
  replyTo         String?   @map("reply_to")
  enabled         Boolean   @default(false)
  updatedById     String?   @map("updated_by") @db.Uuid
  updatedBy       User?     @relation("MailSettingsChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  // the last "Send a test email": when, whether it went, and the result in words
  lastTestAt      DateTime? @map("last_test_at") @db.Timestamptz
  lastTestOk      Boolean?  @map("last_test_ok")
  lastTestMessage String?   @map("last_test_message")

  @@map("mail_settings")
}

// Google Maps for every map in the system (one row, id 1; owner, 24 October 2026, on Check-in Setup's map: "is there
// another map provider?", then "Google Maps"): Organization → Check-in Setup → Google Maps, a Super Admin's only. With a
// key, every map is Google's (a Map/Satellite switch, Google's place search); without one, OpenStreetMap's, as before.
// The browser key is restricted by Google to the website's address and two APIs, and handed to the browser on every page
// with a map, so it is public by nature and kept as it is; still never answered in full (its last four characters) nor
// written to the audit log ("changed"), and handed out only to staff whose pages show a map, never to a developer
// (packages/shared maps-settings.ts). The Map ID is optional: Google's newer pins (Advanced Markers) need one.
model MapsSettings {
  id          Int      @id @default(1)
  browserKey  String?  @map("browser_key") // RESTRICTED: GET /maps/key only; anywhere else its last four characters
  mapId       String?  @map("map_id")
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("MapsSettingsChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("maps_settings")
}

// Online interview meetings (owner, 24 October 2026: "can i link an online meeting service provider to automatically
// generate meeting links?"; asked, "Google Meet, Microsoft Teams, Zoom", and "make it both": a company account a Super
// Admin connects once, and each HR person's own; packages/shared meetings.ts). A provider's app, one row each, set by a
// Super Admin on Organization → Meetings: Google's OAuth client; Microsoft's Entra app registration (tenant, client,
// secret), for the company's host mailbox (application permission) and each HR person's own (delegated); Zoom's
// Server-to-Server OAuth app (account, client, secret) for the company's host, and its General app (user_client_*) for
// each HR person's own. The secrets sealed (AES-256-GCM, a key derived from JWT_SECRET with its own info,
// apps/api/src/meetings/meeting-secret.ts), never returned; *_key_id says which key sealed each.
model MeetingApp {
  provider              String   @id // MEETING_PROVIDERS: google, microsoft, zoom
  clientId              String?  @map("client_id")
  clientSecretEnc       String?  @map("client_secret_enc") // "v1:iv:tag:ciphertext"; RESTRICTED: never returned
  clientSecretKeyId     String?  @map("client_secret_key_id")
  tenantId              String?  @map("tenant_id") // Microsoft only
  accountId             String?  @map("account_id") // Zoom only: the Server-to-Server OAuth app's account
  userClientId          String?  @map("user_client_id") // Zoom only: the General app, for each HR person's own
  userClientSecretEnc   String?  @map("user_client_secret_enc") // RESTRICTED: never returned
  userClientSecretKeyId String?  @map("user_client_secret_key_id")
  updatedById           String?  @map("updated_by") @db.Uuid
  updatedBy             User?    @relation("MeetingAppChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("meeting_apps")
}

// A meetings connection: the company's (user_id empty, one a provider: a partial unique index in the migration) or an
// HR person's own (one a provider and person). Google's and each personal one signed in by OAuth, its refresh token
// sealed (never returned, refreshed automatically); the company's Microsoft and Zoom host by the app alone, as the host
// mailbox or user named here. A refresh refused marks it needs_reconnecting with why, and tells its owner. At most one
// company connection is the default for new online interviews (another partial unique index).
model MeetingConnection {
  id              String      @id @default(uuid()) @db.Uuid
  provider        String // MEETING_PROVIDERS
  userId          String?     @map("user_id") @db.Uuid
  user            User?       @relation("MeetingConnectionOwner", fields: [userId], references: [id], onDelete: Cascade)
  accountEmail    String      @map("account_email") // the account it is connected as, or the host
  refreshTokenEnc String?     @map("refresh_token_enc") // RESTRICTED: never returned
  tokenKeyId      String?     @map("token_key_id")
  status          String      @default("connected") // MEETING_CONNECTION_STATUSES: connected, needs_reconnecting
  problem         String? // why it needs reconnecting, in words
  isDefault       Boolean     @default(false) @map("is_default")
  connectedById   String?     @map("connected_by") @db.Uuid
  connectedBy     User?       @relation("MeetingConnectionBy", fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt     DateTime    @default(now()) @map("connected_at") @db.Timestamptz
  lastUsedAt      DateTime?   @map("last_used_at") @db.Timestamptz
  // the last "Create a test meeting": when, whether it worked, and the result in words
  lastTestAt      DateTime?   @map("last_test_at") @db.Timestamptz
  lastTestOk      Boolean?    @map("last_test_ok")
  lastTestMessage String?     @map("last_test_message")
  // a person's own connection shares their busy times with "Find a time" (25 October 2026): Microsoft's always, Google's
  // once its free/busy scope was allowed (one connected before: "Reconnect to share your busy times")
  busyTimes       Boolean     @default(false) @map("busy_times")
  interviews      Interview[]

  @@unique([provider, userId])
  @@index([userId])
  @@map("meeting_connections")
}

// Interviewers' availability (owner, 25 October 2026: "is it better for each interviewer to add his available interviews
// timeslots?"; asked, "Hours + calendar" and "HR only"; packages/shared interview-availability.ts). The company's
// defaults (one row, id 1), HR's, the CEO's and a Super Admin's on Organization → Interview Hours: the least notice an
// interview is booked with, in hours, and the buffer between one person's interviews, in minutes; each person may only
// make theirs stricter.
model InterviewSettings {
  id            Int      @id @default(1)
  noticeHours   Int      @default(24) @map("notice_hours")
  bufferMinutes Int      @default(15) @map("buffer_minutes")
  updatedById   String?  @map("updated_by") @db.Uuid
  updatedBy     User?    @relation("InterviewSettingsChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("interview_settings")
}

// Someone's interview hours, set once on their own Interview Hours page (or by HR, the CEO or a Super Admin): the weekly
// ranges in Cairo ([{ day: 0-6, from: "HH:mm", to: "HH:mm" }]), the one-off changes ([{ date, kind: off | extra, from,
// to }], only from today on), the day the weekly ranges count from, and their own notice and buffer (null: the
// company's). Checked by packages/shared interviewHoursProblems.
model InterviewHours {
  employeeId    String   @id @map("employee_id") @db.Uuid
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  windows       Json     @default("[]")
  changes       Json     @default("[]")
  effectiveFrom DateTime @map("effective_from") @db.Date
  noticeHours   Int?     @map("notice_hours")
  bufferMinutes Int?     @map("buffer_minutes")
  updatedById   String?  @map("updated_by") @db.Uuid
  updatedBy     User?    @relation("InterviewHoursChange", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("interview_hours")
}

// A calendar's app (owner, 25 October 2026: "its zoho mails"): Zoho's, one row, a Super Admin's on Organization →
// Calendars: the client ID and secret of a Server-based Application at api-console.zoho.com (the secret sealed:
// AES-256-GCM, a key derived from JWT_SECRET with the info "trendlix-calendars-v1"; never returned), and the data centre
// the company's Zoho account is in. Google's and Microsoft's calendars sign in with the meetings' apps (meeting_apps).
model CalendarApp {
  provider          String   @id // 'zoho'
  clientId          String?  @map("client_id")
  clientSecretEnc   String?  @map("client_secret_enc") // "v1:iv:tag:ciphertext"; RESTRICTED: never returned
  clientSecretKeyId String?  @map("client_secret_key_id")
  dataCentre        String?  @map("data_centre") // ZOHO_DATA_CENTRES' key: com, eu, in, …
  updatedById       String?  @map("updated_by") @db.Uuid
  updatedBy         User?    @relation("CalendarAppChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("calendar_apps")
}

// A calendar connection, for busy times only (never an event's title): the company's Zoho (no user: a Super Admin signs
// in once, and colleagues' free/busy is read by their work email) or a person's own Zoho, Google or Microsoft calendar
// (any user with an employee profile). Its refresh token sealed (never returned), refreshed automatically; Zoho's sign-in
// address (its data centre) kept. A refresh refused marks it needs_reconnecting with why.
model CalendarConnection {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String // CALENDAR_PROVIDERS: zoho, google, microsoft
  userId          String?   @map("user_id") @db.Uuid
  user            User?     @relation("CalendarConnectionOwner", fields: [userId], references: [id], onDelete: Cascade)
  accountEmail    String    @map("account_email")
  refreshTokenEnc String    @map("refresh_token_enc") // RESTRICTED: never returned
  tokenKeyId      String    @map("token_key_id")
  accountsServer  String?   @map("accounts_server") // Zoho's: https://accounts.zoho.com, .eu, …
  status          String    @default("connected") // connected, needs_reconnecting
  problem         String?
  connectedById   String?   @map("connected_by") @db.Uuid
  connectedBy     User?     @relation("CalendarConnectionBy", fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt     DateTime  @default(now()) @map("connected_at") @db.Timestamptz
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz
  lastTestAt      DateTime? @map("last_test_at") @db.Timestamptz
  lastTestOk      Boolean?  @map("last_test_ok")
  lastTestMessage String?   @map("last_test_message")

  @@unique([provider, userId])
  @@index([userId])
  @@map("calendar_connections")
}

// Zoho People's connection (owner, 25 October 2026: "can i fetch checkin and out transactions from zoho people through
// api?"; asked, "Yes, daily + backfill": "a Super Admin connects Zoho once"): one row (id 1), the Zoho account a Super
// Admin signed in as (a Zoho People admin, who reads everyone's attendance), through the Zoho app shared with the
// calendars (CalendarApp 'zoho': its client ID, secret and data centre) with its own scopes (ZOHO_PEOPLE_SCOPES). Its
// refresh token sealed with its own key (HKDF of JWT_SECRET, info trendlix-zoho-people-v1; never returned), the sign-in's
// data centre (its accounts server), Zoho People's own time zone and date format as its organization says, the last
// test. A refresh refused marks it needs_reconnecting with why; the page and the dashboard say so.
model ZohoPeopleConnection {
  id              Int       @id @default(1)
  accountEmail    String    @map("account_email")
  refreshTokenEnc String    @map("refresh_token_enc") // RESTRICTED: never returned
  tokenKeyId      String    @map("token_key_id")
  accountsServer  String?   @map("accounts_server") // Zoho's: https://accounts.zoho.com, .eu, …
  status          String    @default("connected") // connected, needs_reconnecting
  problem         String?
  timeZone        String?   @map("time_zone") // Zoho People's organization's, e.g. Africa/Cairo
  dateFormat      String?   @map("date_format") // its date format, e.g. dd-MMM-yyyy
  connectedById   String?   @map("connected_by") @db.Uuid
  connectedBy     User?     @relation("ZohoPeopleConnectionBy", fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt     DateTime  @default(now()) @map("connected_at") @db.Timestamptz
  lastTestAt      DateTime? @map("last_test_at") @db.Timestamptz
  lastTestOk      Boolean?  @map("last_test_ok")
  lastTestMessage String?   @map("last_test_message")

  @@map("zoho_people_connections")
}

// A fetch of Zoho People's attendance (owner, 25 October 2026: "every night it pulls yesterday's check-ins and
// check-outs for everyone automatically; plus a "Fetch from Zoho" button for any date range"; then "but can it fetch
// historical data?": up to 12 months a run, everyone employed in it, former employees too): the nightly one (one a day,
// nightly_for its day) or HR's, its days, everyone or the people chosen, where it stands, and what it did. Its plan (each
// person's work email and the ranges of their employments within its days) and where it got to (cursor: the person and
// month next) are kept, so a run goes on after the API restarts. One goes at a time. The days it kept say so
// (attendance_days.zoho_run_id). Never deleted: the page lists the last ones.
model ZohoPeopleRun {
  id                String          @id @default(uuid()) @db.Uuid
  kind              String // ZOHO_RUN_KINDS: nightly, fetch
  nightlyFor        DateTime?       @unique @map("nightly_for") @db.Date
  fromDate          DateTime        @map("from_date") @db.Date
  toDate            DateTime        @map("to_date") @db.Date
  employeeIds       String[]        @default([]) @map("employee_ids") @db.Uuid // the people chosen; none: everyone
  status            String          @default("running") // ZOHO_RUN_STATUSES
  startedById       String?         @map("started_by") @db.Uuid
  startedBy         User?           @relation("ZohoPeopleRunStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  startedAt         DateTime        @default(now()) @map("started_at") @db.Timestamptz
  finishedAt        DateTime?       @map("finished_at") @db.Timestamptz
  heartbeatAt       DateTime        @default(now()) @map("heartbeat_at") @db.Timestamptz
  cancelRequestedAt DateTime?       @map("cancel_requested_at") @db.Timestamptz
  cancelledById     String?         @map("cancelled_by") @db.Uuid
  cancelledBy       User?           @relation("ZohoPeopleRunCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  waitingUntil      DateTime?       @map("waiting_until") @db.Timestamptz
  plan              Json
  cursor            Json?
  peopleTotal       Int             @map("people_total")
  peopleDone        Int             @default(0) @map("people_done")
  callsTotal        Int             @map("calls_total")
  callsDone         Int             @default(0) @map("calls_done")
  daysAdded         Int             @default(0) @map("days_added")
  punchesAdded      Int             @default(0) @map("punches_added")
  daysReplaced      Int             @default(0) @map("days_replaced")
  daysUnchanged     Int             @default(0) @map("days_unchanged")
  daysRecorded      Int             @default(0) @map("days_recorded") // added to a month whose payroll is with the CEO, approved or paid
  linesRefilled     Int             @default(0) @map("lines_refilled")
  skipped           Json            @default("{}") // { reason: days }
  notFound          String[]        @default([]) @map("not_found") @db.Uuid // employees Zoho People doesn't know
  excludedIds       String[]        @default([]) @map("excluded_ids") @db.Uuid // left out of the fetch (31 October 2026)
  errors            Json            @default("[]") // at most 50 short lines
  problem           String?
  days              AttendanceDay[]

  @@index([startedAt])
  @@map("zoho_people_runs")
}

// People left out of Zoho People's fetch (owner, 31 October 2026: "can i exclude users from the zoho api?"; he chose "Add
// an exclusion list": "On Organization → Zoho People, HR or a Super Admin picks people to leave out. The nightly and
// manual fetches skip them, and each run says how many were left out. Zoho days already fetched stay as history."). One
