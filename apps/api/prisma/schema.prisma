  employeeId String   @unique @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason     String? // why, at most 500 characters
  addedById  String?  @map("added_by") @db.Uuid
  addedBy    User?    @relation("ZohoPeopleExclusionBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  @@map("zoho_people_exclusions")
}

// WhatsApp notifications (owner, 24 October 2026: "how to make whatsapp notifications?"; asked, "Employees and
// candidates", "Approvals waiting, Request decisions, Check-in reminders, Interviews", "Directly to Meta"; packages/shared
// whatsapp.ts): the WhatsApp Cloud API's settings (one row, id 1), a Super Admin's on Organization → Company → WhatsApp.
// The access token (a system user's permanent one) and the app secret (the webhook's signatures) sealed (AES-256-GCM, a
// key derived from JWT_SECRET with its own info, apps/api/src/whatsapp/whatsapp-secret.ts), never returned; *_key_id
// says which key sealed each. The webhook's verify token is made by the system and shown, to paste in Meta. Quiet hours
// in Cairo ("HH:mm"; none: messages at any hour). The last test, the templates' last sync, the webhook's last
// verification and last signed call. Twilio, a second way to send (owner, 25 October 2026: "Add Twilio as a choice";
// packages/shared whatsapp-twilio.ts): `provider` says which one sends; Twilio's Account SID, its Auth Token sealed as the
// token is (never returned), the WhatsApp sender (whatsapp:+20…, or a Messaging Service SID MG…), its templates' last
// sync and its last signed call.
model WhatsAppSettings {
  id                      Int       @id @default(1)
  phoneNumberId           String?   @map("phone_number_id")
  businessAccountId       String?   @map("business_account_id")
  displayPhone            String?   @map("display_phone")
  accessTokenEnc          String?   @map("access_token_enc") // "v1:iv:tag:ciphertext"; RESTRICTED: never returned
  accessTokenKeyId        String?   @map("access_token_key_id")
  appSecretEnc            String?   @map("app_secret_enc") // RESTRICTED: never returned
  appSecretKeyId          String?   @map("app_secret_key_id")
  verifyToken             String    @map("verify_token")
  enabled                 Boolean   @default(false)
  quietFrom               String?   @default("22:00") @map("quiet_from")
  quietTo                 String?   @default("08:00") @map("quiet_to")
  updatedById             String?   @map("updated_by") @db.Uuid
  updatedBy               User?     @relation("WhatsAppSettingsChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  lastTestAt              DateTime? @map("last_test_at") @db.Timestamptz
  lastTestOk              Boolean?  @map("last_test_ok")
  lastTestMessage         String?   @map("last_test_message")
  templatesSyncedAt       DateTime? @map("templates_synced_at") @db.Timestamptz
  webhookVerifiedAt       DateTime? @map("webhook_verified_at") @db.Timestamptz
  webhookEventAt          DateTime? @map("webhook_event_at") @db.Timestamptz
  provider                String    @default("meta") // WHATSAPP_PROVIDERS: meta, twilio
  twilioAccountSid        String?   @map("twilio_account_sid")
  twilioAuthTokenEnc      String?   @map("twilio_auth_token_enc") // RESTRICTED: never returned
  twilioAuthTokenKeyId    String?   @map("twilio_auth_token_key_id")
  twilioSender            String?   @map("twilio_sender")
  twilioTemplatesSyncedAt DateTime? @map("twilio_templates_synced_at") @db.Timestamptz
  twilioEventAt           DateTime? @map("twilio_event_at") @db.Timestamptz

  @@map("whatsapp_settings")
}

// A template in a language, as Meta last said (WHATSAPP_TEMPLATE_KEYS × en, ar): submitted, then its status (approved,
// pending, rejected with its reason…) synced. Only an approved one is ever sent.
model WhatsAppTemplate {
  key         String // WHATSAPP_TEMPLATE_KEYS
  language    String // WHATSAPP_LANGUAGES: en, ar
  name        String // its name on Meta, people_<key>
  status      String    @default("not_submitted") // WHATSAPP_TEMPLATE_STATUSES
  reason      String? // why Meta rejected it, in words
  metaId      String?   @map("meta_id")
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz
  syncedAt    DateTime? @map("synced_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@id([key, language])
  @@map("whatsapp_templates")
}

// A template in a language on Twilio (owner, 25 October 2026: "Add Twilio as a choice"): the same text made as Twilio
// Content (its SID, HX…), named people_<key>_<language>, submitted for WhatsApp's approval, then its status synced.
// Twilio's own approval, apart from Meta's: only an approved one is sent while Twilio sends.
model WhatsAppTwilioTemplate {
  key         String // WHATSAPP_TEMPLATE_KEYS
  language    String // WHATSAPP_LANGUAGES: en, ar
  name        String // people_<key>_<language>
  contentSid  String?   @unique @map("content_sid")
  status      String    @default("not_submitted") // WHATSAPP_TEMPLATE_STATUSES
  reason      String? // why it was rejected, in words
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz
  syncedAt    DateTime? @map("synced_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@id([key, language])
  @@map("whatsapp_twilio_templates")
}

// An employee's own choice to get WhatsApp messages (required by Meta: opt-in), made on their account, never by HR: the
// mobile it was given for (their profile's, +201012345678: a changed mobile stops it until they turn it on again), the
// language, the groups (all on when they opt in), when. Turned off by them, or by their replying STOP (stopped_by).
model WhatsAppOptIn {
  userId     String    @id @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobile     String
  language   String    @default("en") // WHATSAPP_LANGUAGES
  approvals  Boolean   @default(true)
  decisions  Boolean   @default(true)
  checkIn    Boolean   @default(true) @map("check_in")
  interviews Boolean   @default(true)
  optedInAt  DateTime  @map("opted_in_at") @db.Timestamptz
  stoppedAt  DateTime? @map("stopped_at") @db.Timestamptz
  stoppedBy  String?   @map("stopped_by") // self, stop
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([mobile])
  @@map("whatsapp_opt_ins")
}

// A WhatsApp message: to an employee who opted in (user_id), a candidate who ticked it (candidate_id, with the
// application or general CV it is about), or the test's number. Its template and language, the variables (names, dates
// and references only, as push's), the page its button opens, its reference for HR's log (APP-2026-0042, or what it is
// about), whether it is about a C-level person (never shown to HR). Queued (waiting for its time, quiet hours, or a
// retry), sending (claimed by a round), then Meta's statuses sent, delivered, read; or failed (why, in plain words, and
// Meta's code), or cancelled (not sent: too late, opted out). Meta's message id (wamid) matches the webhook's statuses.
// `dedupe_key`: at most one of a kind (a reminder's kind a day, an interview's reminder).
model WhatsAppMessage {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String?         @map("user_id") @db.Uuid
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  candidateId   String?         @map("candidate_id") @db.Uuid
  candidate     Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  applicationId String?         @map("application_id") @db.Uuid
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  generalCvId   String?         @map("general_cv_id") @db.Uuid
  generalCv     GeneralCv?      @relation(fields: [generalCvId], references: [id], onDelete: SetNull)
  interviewId   String?         @map("interview_id") @db.Uuid
  interview     Interview?      @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  mobile        String // +201012345678
  template      String // WHATSAPP_TEMPLATE_KEYS, or stop_confirmation
  templateName  String          @map("template_name") // its name on Meta
  language      String // WHATSAPP_LANGUAGES
  kind          String? // the notification's kind, or the candidate's event
  groupKey      String?         @map("group_key") // WHATSAPP_GROUPS
  variables     Json            @default("{}") // { body: string[], button: string | null } (stop_confirmation: { text })
  reference     String?
  link          String?
  confidential  Boolean         @default(false)
  status        String          @default("queued") // WHATSAPP_MESSAGE_STATUSES
  wamid         String?         @unique // Meta's message id, or Twilio's message SID (SM…)
  provider      String? // who sent it: meta, twilio (25 October 2026); none while it waits
  error         String?
  errorCode     Int?            @map("error_code")
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now()) @map("next_attempt_at") @db.Timestamptz
  sendBefore    DateTime?       @map("send_before") @db.Timestamptz
  dedupeKey     String?         @unique @map("dedupe_key")
  claimedAt     DateTime?       @map("claimed_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  sentAt        DateTime?       @map("sent_at") @db.Timestamptz
  deliveredAt   DateTime?       @map("delivered_at") @db.Timestamptz
  readAt        DateTime?       @map("read_at") @db.Timestamptz
  failedAt      DateTime?       @map("failed_at") @db.Timestamptz
  updatedAt     DateTime        @default(now()) @map("updated_at") @db.Timestamptz

  @@index([status, nextAttemptAt])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt])
  @@index([mobile])
  @@index([candidateId])
  @@index([applicationId])
  @@index([generalCvId])
  @@index([interviewId])
  @@map("whatsapp_messages")
}

// ---------- organisation ----------

// A department (parent_id empty) or one of its teams (parent_id = the department), e.g. Marketing → Content Team.
// One level only: a team has no teams of its own. Job titles and employees can belong to either (job titles directly
// in a department, e.g. Head of Marketing: owner's decision, 15 October 2026).
model Department {
  id             String              @id @default(uuid()) @db.Uuid
  nameEn         String              @map("name_en") // unique among a department's teams; among departments, checked by the API
  nameAr         String?             @map("name_ar")
  parentId       String?             @map("parent_id") @db.Uuid
  sortOrder      Int                 @default(0) @map("sort_order") // the order set by an Admin, among departments or among one department's teams
  // the person in charge (owner, 19 October 2026: "i want to add department lead person, the person in charge"): a
  // department's Head of department, a team's Team lead. Any current employee (checked by the API; cleared when their
  // employment ends), one person may lead several. The default direct manager when hiring into it, and the approver of
  // leave and reimbursements for someone in it with no direct manager (packages/shared department-leads.ts)
  headId         String?             @map("head_id") @db.Uuid
  head           Employee?           @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  parent         Department?         @relation("SubDepartments", fields: [parentId], references: [id], onDelete: Restrict)
  children       Department[]        @relation("SubDepartments")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  jobTitles      JobTitle[]
  employments    Employment[]
  offers         JobOffer[]
  vacancies      Vacancy[] // the vacancies of its job titles (22 October 2026)
  kpiScorecards  KpiScorecard[] // the KPI scorecards of people who worked here when they opened (21 October 2026)
  kpiFrameworks  KpiFramework[] // its own KPI pillars' versions (22 October 2026)
  generalCvs     GeneralCv[] // the general CVs of people who would like to work in it (22 October 2026)
  staffingLimit  LeaveStaffingLimit? // its staffing limit for annual leave: a team's, or a department's without teams (25 October 2026)
  clientAccounts ClientAccount[] // the client accounts it serves (25 October 2026)

  @@unique([parentId, nameEn])
  @@index([headId])
  @@map("departments")
}

// A shift is a window (its start to its end) and the hours to work a day within it (owner, 16 October 2026, on the
// MORNING shift of 9:00 AM to 7:00 PM: "my company shift is to maintain 9 hours within the shift window, its like
// flexible shift"): fewer than the window, it is flexible, worked anywhere within it; empty, the whole window. In half
// hours from 0.5, never more than the window (checked by the API and the database). Payroll counts a day of the shift
// as these hours (the expected hours, a no-show day's hours); they are also the most attendance counts a day (owner, 16
// October 2026: "maximum working hours to be recorded per day is 9 hours between checkin and check out").
// Count hours until (owner, 20 October 2026: "within the same month with no working hours to be counted after 8 PM even
// if the check out was 11 PM / record the checkout time but count till the checkout window limit"): set, a day counts
// until that time and past the hours to work, a long day filling the month's short hours (packages/shared attendance.ts
// and payroll.ts); at or after the end, the same day (checked by the API and the database). Null: as before.
model Shift {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique // A, B
  startTime    DateTime     @map("start_time") @db.Time(0)
  endTime      DateTime     @map("end_time") @db.Time(0)
  hoursPerDay  Decimal?     @map("hours_per_day") @db.Decimal(4, 2) // the hours to work a day; null: the whole window
  countUntil   DateTime?    @map("count_until") @db.Time(0) // hours count until it, making up short days; null: the end and grace
  graceMinutes Int          @default(15) @map("grace_minutes")
  workingDays  Int[]        @default([0, 1, 2, 3, 4]) @map("working_days") @db.SmallInt // 0 = Sun … 6 = Sat
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  employments  Employment[]
  offers       JobOffer[]
  vacancies    Vacancy[]

  @@map("shifts")
}

// A job title takes a range of grades, not one grade (owner's decision, 15 October 2026): a Junior and a Senior Account
// Manager are both Account Managers, at different grades. The range is the lowest and the highest grade, either or
// both optional (none: any grade); each employment has the person's own grade within it.
// The job description (purpose, duties, requirements) is simple rich text, saved as cleaned HTML (owner's request, 15
// October 2026); the duty rows, which KPIs will be linked to, are read from the duties' HTML.
model JobTitle {
  id             String            @id @default(uuid()) @db.Uuid
  departmentId   String            @map("department_id") @db.Uuid
  department     Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  titleEn        String            @map("title_en")
  titleAr        String?           @map("title_ar")
  minGradeId     String?           @map("min_grade_id") @db.Uuid // the lowest grade it takes; empty: no lower limit
  minGrade       Grade?            @relation("JobTitleMinGrade", fields: [minGradeId], references: [id], onDelete: Restrict)
  maxGradeId     String?           @map("max_grade_id") @db.Uuid // the highest grade it takes; empty: no upper limit
  maxGrade       Grade?            @relation("JobTitleMaxGrade", fields: [maxGradeId], references: [id], onDelete: Restrict)
  jdPurpose      String?           @map("jd_purpose") // HTML
  jdDuties       String?           @map("jd_duties") // HTML; the duty rows are its list items and paragraphs
  jdRequirements String?           @map("jd_requirements") // HTML
  jdVersion      Int               @default(1) @map("jd_version")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  duties         JobTitleDuty[]
  employments    Employment[]
  offers         JobOffer[]
  promotions     Contract[]        @relation("RaiseJobTitle") // raises that promote to this job title
  kpiTemplates   KpiTemplate[] // its KPI template's versions (21 October 2026): a draft and the published ones
  vacancies      Vacancy[] // the vacancies for it (recruitment, 22 October 2026)
  portfolio      PortfolioSetting? // what its careers forms ask for as a portfolio (25 October 2026); none: the rule's default

  @@unique([departmentId, titleEn])
  @@map("job_titles")
}

// The grading system (owner's table, 14 October 2026): G1 Entry Level … G9 Executive. The rank orders the hierarchy
// (1 = entry level). Job title and grade apart (owner's decision, 15 October 2026): a job title takes a range of grades,
// and an employee's grade is their employment's own, within the range of their job title.
model Grade {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique // G1 … G9
  rank         Int          @unique // 1 = lowest level
  levelEn      String       @map("level_en") // Entry Level, Junior, … Executive
  levelAr      String?      @map("level_ar")
  description  String? // e.g. example job titles
  // C-level (owner, 19 October 2026: "make C level Employees details not visible to HR"): those whose current employment
  // has this grade show HR, Finance, Admin and managers only their directory card; the CEO and the Super Admin see and
  // manage them. G9 · Executive is marked; a Super Admin ticks it on the grades page (packages/shared confidential.ts)
  confidential Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  lowestOf     JobTitle[]   @relation("JobTitleMinGrade") // job titles whose range starts at this grade
  highestOf    JobTitle[]   @relation("JobTitleMaxGrade") // job titles whose range ends at this grade
  employments  Employment[]
  offers       JobOffer[]
  vacancies    Vacancy[]
  promotions   Contract[]   @relation("RaiseGrade") // raises that promote to this grade

  @@map("grades")
}

model JobTitleDuty {
  id         String   @id @default(uuid()) @db.Uuid
  jobTitleId String   @map("job_title_id") @db.Uuid
  jobTitle   JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
  position   Int
  duty       String

  @@map("job_title_duties")
}

// ---------- employees ----------

// By Labour Law 14/2025 (owner, 18 October 2026: "can we update the employment types based on the labour law?"): Sales
// became Full-time paid by commission (Employment.paidByCommission), and Freelance is kept, outside the labour law (Art.
// 1(1): a freelancer doesn't work "تحت إدارته أو إشرافه"). One internship (owner, 25 October 2026: "unpaid internship and
// training are the same thing .. keep the unpaid internship with its document and delete the trainee with its
// documents"): the paid trainee (المتدرج, Arts. 28–30) is gone, its records interns' (20261026010000_one_internship_type).
enum EmploymentType {
  full_time
  part_time
  intern // the unpaid internship (owner, 19 October 2026): outside the labour law, no wage, allowances only
  freelance // outside the labour law: no leave, no company social insurance, a service agreement

  @@map("employment_type")
}

enum EmployeeStatus {
  active
  probation
  on_leave
  notice_period
  resigned
  terminated

  @@map("employee_status")
}

enum WorkArrangement {
  office // indoor, at the office
  wfh
  hybrid // office days and home days
  outdoor // field work: shoots, sales visits … (owner, 15 October 2026)
  indoor_outdoor // part at the office, part in the field

  @@map("work_arrangement")
}

// Lists stored as text (gender, marital status, degree …) take their values from packages/shared.
model Employee {
  id                         String                     @id @default(uuid()) @db.Uuid
  employeeCode               String                     @unique @map("employee_code") // EMP-0142: shown everywhere, different from the national ID
  // the email they sign in with, as HR chose it (owner, 22 October 2026: "let the HR Choose which mail to use"): work or
  // personal; none: the work email, else the personal one (packages/shared signInEmailOf)
  signInEmail                String?                    @map("sign_in_email")
  account                    User?                      @relation("UserEmployee") // their sign-in account (users.employee_id)
  // their Employee Id in Zoho People (owner, 19 October 2026: attendance imported from Zoho, people matched by name and
  // the links HR confirms remembered), e.g. "103" or "10001 - HYB": the next import matches them by it
  zohoPeopleId               String?                    @unique @map("zoho_people_id")
  insuranceNo                String?                    @unique @map("insurance_no") // الرقم التأميني, the social insurance number: digits only
  // the occupation in the social insurance table (packages/shared occupations.ts), printed on Form 1 as كود المهنة: six
  // digits, checked by the database too; the name is the table's, never stored. HR sets it on the profile's Social
  // Insurance tab (owner's decision, 16 October 2026: the employee's, no longer their job title's)
  occupationCode             String?                    @map("occupation_code") @db.Char(6)
  // what Form 1 prints that is the employee's own, set by HR on the Social Insurance tab (owner, 16 October 2026): the
  // subscription start (تاريخ بدء الاشتراك; none: the current employment's join date), and the wages, salary data, each
  // more than 0: the basic wage (أجر أساسي; none: the default in the contract settings) and the comprehensive wage
  // (الأجر الشامل; none: the contract's gross and allowances). The insured wage (أجر الاشتراك) is not kept: it is the
  // comprehensive wage within the year's insurable limits (owner's decision, 16 October 2026)
  insuranceStartDate         DateTime?                  @map("insurance_start_date") @db.Date
  insuranceBasicWage         Decimal?                   @map("insurance_basic_wage") @db.Decimal(12, 2)
  insuranceComprehensiveWage Decimal?                   @map("insurance_comprehensive_wage") @db.Decimal(12, 2)
  // registered with social insurance (owner's decision, 16 October 2026): payroll deducts the employee's share and
  // counts the company's only for those registered. HR sets it on the Social Insurance tab; the payroll migration set
  // it for everyone with a social insurance number
  socialInsured              Boolean                    @default(false) @map("social_insured")
  // for the annual leave's days (Labour Law 14/2025 Art. 124; owner, 18 October 2026: "can you apply the leaves
  // according to the law?"): the months of service with earlier employers, as 30 days are due after "عشر سنوات كاملة
  // لدى صاحب عمل أو أكثر" (none: none), and a disability, which brings 45 days ("للأشخاص ذوى الإعاقة والأقزام"). HR
  // sets them on the profile; HR, the CEO and the employee see them
  priorServiceMonths         Int?                       @map("prior_service_months")
  disability                 Boolean                    @default(false)
  fullNameEn                 String                     @map("full_name_en")
  fullNameAr                 String                     @map("full_name_ar") // as printed on contracts
  displayName                String?                    @map("display_name") // the short name the person goes by (e.g. Hazem Magdy), for the email signature
  dateOfBirth                DateTime?                  @map("date_of_birth") @db.Date
  gender                     String?
  nationality                String?
  maritalStatus              String?                    @map("marital_status")
  militaryStatus             String?                    @map("military_status")
  // contact: phones are text, so the leading 0 is kept
  workEmail                  String?                    @unique @map("work_email") // lower case; a sign-in account with this email is this employee
  personalEmail              String?                    @map("personal_email")
  mobile                     String?
  mobile2                    String? // a second mobile number
  addressAr                  String?                    @map("address_ar")
  city                       String? // the city or district, in Arabic as on the ID card (e.g. مدينة نصر)
  governorate                String?
  buildingNo                 String?                    @map("building_no") // the address's building number (عقار رقم) on social insurance Forms 1 and 6, up to 10 characters (owner, 15 October 2026)
  emergencyName              String?                    @map("emergency_name")
  emergencyRelation          String?                    @map("emergency_relation")
  emergencyMobile            String?                    @map("emergency_mobile")
  // education (the main qualification; qualification_ar is printed on contracts)
  university                 String?
  faculty                    String?
  degree                     String?
  major                      String?
  graduationYear             Int?                       @map("graduation_year") @db.SmallInt
  educationGrade             String?                    @map("education_grade")
  qualificationAr            String?                    @map("qualification_ar")
  // a student (owner, 25 October 2026: "Add a Student option"): still studying, the year (STUDY_YEARS: year_1 …
  // year_7, postgraduate_diploma, masters, phd) and the expected graduation, a month kept as its first day; the year and
  // the month only while still studying (checked by the database too). With qualification_ar empty, contracts print the
  // student's wording (packages/shared student-education.ts)
  stillStudying              Boolean                    @default(false) @map("still_studying")
  studyYear                  String?                    @map("study_year")
  expectedGraduation         DateTime?                  @map("expected_graduation") @db.Date
  createdAt                  DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  identity                   EmployeeIdentity?
  bank                       EmployeeBank?
  paperwork                  PaperworkItem[]
  employments                Employment[]               @relation("Employments")
  managing                   Employment[]               @relation("Manager") // the employments this person is the manager of
  confirmations              ProfileConfirmation[]
  changeRequests             ProfileChangeRequest[]
  photoRequests              ProfilePhotoRequest[]
  documents                  GeneratedDocument[]
  offers                     JobOffer[]                 @relation("OfferPerson") // offers made to this person: as a former employee, or the offer they were hired from
  offersManaging             JobOffer[]                 @relation("OfferManager") // offers whose position reports to this person
  vacanciesManaging          Vacancy[]                  @relation("VacancyHiringManager") // the vacancies they hire for (22 October 2026)
  interviewing               InterviewInterviewer[] // the interviews they sit on (22 October 2026)
  interviewFeedback          InterviewFeedback[] // their scorecards
  applications               JobApplication[] // the applications they were hired from
  candidates                 Candidate[] // the candidate profiles linked to them: matched by email or mobile, or hired from an offer (22 October 2026)
  payrollLines               PayrollLine[] // the person's pay, month by month
  payrollAdjustments         PayrollAdjustment[] // one-off additions and deductions on a month's pay
  payrollAdvances            PayrollAdvance[] // advances and loans given, recovered from the pay
  recurringDeductions        RecurringDeduction[] // monthly shares taken from the pay, e.g. a medical subscription
  raiseRequests              RaiseRequest[] // the raises asked for this person
  reimbursements             ReimbursementClaim[]       @relation("ReimbursementClaimant") // the reimbursements this person claimed
  reimbursementsToDecide     ReimbursementClaim[]       @relation("ReimbursementManager") // the claims this person decided, or decides, as the claimant's direct manager
  leaveRequests              LeaveRequest[]             @relation("LeaveRequester") // the leave this person asked for, or HR recorded for them
  leaveToDecide              LeaveRequest[]             @relation("LeaveManager") // the leave requests this person decided, or decides, as the requester's direct manager
  permissions                PermissionRequest[]        @relation("PermissionRequester") // the permission hours this person asked for, or HR recorded for them
  attendanceDays             AttendanceDay[] // each day of attendance kept: imported from Zoho People, or from their check-ins on the system
  attendancePunches          AttendancePunch[] // each press of Check in and Check out on the system (19 October 2026)
  attendanceRecordRemovals   AttendanceRecordRemoval[] // their attendance records a Super Admin removed (31 October 2026)
  attendanceDaySources       AttendanceDaySource[] // their days whose source a Super Admin chose (31 October 2026)
  attendanceCorrections      AttendanceCorrection[]     @relation("AttendanceCorrectionRequester") // the days this person asked to correct, or HR corrected
  correctionsToDecide        AttendanceCorrection[]     @relation("AttendanceCorrectionManager") // the corrections this person decided, or decides, as the requester's direct manager
  permissionsToDecide        PermissionRequest[]        @relation("PermissionManager") // the permission requests this person decided, or decides, as the requester's direct manager
  wfhDays                    WfhRequest[]               @relation("WfhRequester") // the work from home days this person asked for, or HR recorded for them (21 October 2026)
  wfhToDecide                WfhRequest[]               @relation("WfhManager") // the work from home requests this person decided, or decides, as the approver in charge
  odRequests                 OdRequest[]                @relation("OdRequester") // the official duties this person asked for (23 October 2026)
  odToDecide                 OdRequest[]                @relation("OdManager") // the official duty requests this person decided, or decides, as the approver in charge
  // leave coverage (owner, 25 October 2026: "Required over 2 days", "To a stand-in"): the leave this person covers for a
  // colleague, the leave they stand in for an approver during, and the steps they took standing in for someone else
  leaveCovering              LeaveRequest[]             @relation("LeaveCover")
  leaveStandingIn            LeaveRequest[]             @relation("LeaveStandIn")
  leaveStepsStoodIn          LeaveRequestStep[]         @relation("LeaveStepOnBehalf") // the leave steps taken by a stand-in for this person
  permissionStepsStoodIn     PermissionRequestStep[]    @relation("PermissionStepOnBehalf")
  wfhStepsStoodIn            WfhRequestStep[]           @relation("WfhStepOnBehalf")
  resignationRequests        ResignationRequest[]       @relation("ResignationRequester") // the resignations this person asked for (26 October 2026)
  compensatoryDays           CompensatoryRequest[]      @relation("CompensatoryRequester") // the compensatory days this person asked for, or HR recorded for them (26 October 2026)
  payrollLockedChanges       PayrollLockedChange[] // their leave and attendance changes made after a month's payroll moved on (27 October 2026)
  compensatoryToDecide       CompensatoryRequest[]      @relation("CompensatoryManager")
  compensatoryStepsStoodIn   CompensatoryStep[]         @relation("CompensatoryStepOnBehalf")
  odStepsStoodIn             OdRequestStep[]            @relation("OdStepOnBehalf")
  correctionStepsStoodIn     AttendanceCorrectionStep[] @relation("CorrectionStepOnBehalf")
  claimStepsStoodIn          ReimbursementClaimStep[]   @relation("ClaimStepOnBehalf")
  leaveBalances              LeaveBalanceYear[] // each year's annual leave: carried in, closed
  leaveAdjustments           LeaveAdjustment[] // HR's changes to the annual leave balance
  leading                    Department[]               @relation("DepartmentHead") // the departments this person heads and the teams they lead
  homeLocations              HomeLocationRequest[] // the home locations this person asked for (20 October 2026): one approved at most, its point only while decided or in force
  checkInPlaces              CheckInLocationPerson[] // the sub-locations this person is linked to (20 October 2026): their own check-in places
  kpiScorecards              KpiScorecard[]             @relation("KpiScorecardOf") // this person's KPI scorecards, one a month (21 October 2026)
  kpiToScore                 KpiScorecard[]             @relation("KpiScorecardManager") // the KPI scorecards this person scores, or scored, as the manager in charge
  assetsHeld                 Asset[]                    @relation("AssetHolder") // the assets this person holds in custody now (21 October 2026)
  custodyRecords             CustodyRecord[]            @relation("CustodyEmployee") // the assets handed over to this person, record by record
  custodyHandedOver          CustodyRecord[]            @relation("CustodyHandedOverBy") // the custody records this person handed over
  interviewHours             InterviewHours? // the weekly hours they interview in (owner, 25 October 2026: "Hours + calendar")
  // access follows the contract (owner, 23 October 2026: "Active - Grace - Hold - No Access"; packages/shared
  // employee-access.ts): the standing the sweep recorded last (ACCESS_STANDINGS; none: not recorded yet) and since when,
  // so each change is audited and told once; the request's own standing is always read from the contract
  accessStanding             String?                    @map("access_standing")
  accessStandingAt           DateTime?                  @map("access_standing_at") @db.Timestamptz
  accessGraces               AccessGrace[] // the 7 days' grace HR gave them, one a contract gap
  // no contract entered (owner, 23 October 2026: "Hold them after 7 days"): the day the sweep first recorded their
  // account switched on without a signed contract ever in force (Cairo); on Hold from the 8th day after unless one is
  // entered. Cleared once a signed contract starts (or they leave); kept while their account is off, so turning it off
  // and on never starts the 7 days again
  noContractSince            DateTime?                  @map("no_contract_since") @db.Date
  checkInExemptions          CheckInExemption[] // their periods exempt from check-in (owner, 25 October 2026)
  zohoPeopleExclusion        ZohoPeopleExclusion? // left out of Zoho People's fetch (owner, 31 October 2026)
  clientAccounts             ClientAccountAssignment[] // the client accounts they were assigned to (25 October 2026)

  @@map("employees")
}

// One period of employment, from hiring to its end (resignation, termination …). The profile (Employee) is kept for
// good; a person hired again gets a new employment and the earlier ones stay as their history (owner's decision,
// 14 October 2026). At most one employment per person is current: the one without an end date (checked by the API).
// The person's grade is the employment's own, within the range of grades its job title takes (owner's decision,
// 15 October 2026; checked by the API).
model Employment {
  id                     String                    @id @default(uuid()) @db.Uuid
  employeeId             String                    @map("employee_id") @db.Uuid
  employee               Employee                  @relation("Employments", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentType         EmploymentType            @map("employment_type")
  status                 EmployeeStatus            @default(probation) // resigned or terminated once ended
  departmentId           String?                   @map("department_id") @db.Uuid // a team, or a department
  department             Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitleId             String?                   @map("job_title_id") @db.Uuid
  jobTitle               JobTitle?                 @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  gradeId                String?                   @map("grade_id") @db.Uuid // the person's own grade, within the job title's range
  grade                  Grade?                    @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  managerId              String?                   @map("manager_id") @db.Uuid
  manager                Employee?                 @relation("Manager", fields: [managerId], references: [id], onDelete: Restrict)
  joinDate               DateTime                  @map("join_date") @db.Date
  probationEnd           DateTime?                 @map("probation_end") @db.Date
  workArrangement        WorkArrangement           @default(office) @map("work_arrangement")
  officeDays             Int[]                     @default([]) @map("office_days") @db.SmallInt // Hybrid only; 0 = Sun … 6 = Sat
  shiftId                String?                   @map("shift_id") @db.Uuid
  // hazardous or unhealthy work, or work in a remote area: 7 more days of annual leave (Labour Law 14/2025 Art. 124:
  // "تزاد مدة الإجازة السنوية بمقدار سبعة أيام للعمال الذين يعملون فى الأعمال الخطرة، أو المضرة بالصحة، أو فى المناطق النائية")
  hazardousWork          Boolean                   @default(false) @map("hazardous_work")
  // employment types by the labour law (owner, 18 October 2026): paid by commission (full-time only; the law's wage
  // includes "العمولة أو النسبة المئوية", Art. 1(4)(أ)), what Sales was; and the nature of the work (Art. 1(6–8))
  paidByCommission       Boolean                   @default(false) @map("paid_by_commission")
  workNature             String                    @default("regular") @map("work_nature") // WORK_NATURES: regular, temporary, casual, seasonal
  // "Can check in from anywhere" (owner, 20 October 2026: check-ins locked to the office network, "Office staff, plus
  // exceptions"): HR lets an Office employee check in off the office network; the others aren't locked anyway
  checkInAnywhere        Boolean                   @default(false) @map("check_in_anywhere")
  // "Can check in without a location" (owner, 20 October 2026: "Company switch + exceptions"): with Check-in Setup's
  // "Refuse check-ins and check-outs without a location" on, HR lets this person press on the website without one (the
  // app always needs it)
  checkInWithoutLocation Boolean                   @default(false) @map("check_in_without_location")
  shift                  Shift?                    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  jdAcknowledgedAt       DateTime?                 @map("jd_acknowledged_at") @db.Date
  endDate                DateTime?                 @map("end_date") @db.Date // empty while current
  endReason              String?                   @map("end_reason") // packages/shared END_REASONS: resigned, terminated, contract_ended …
  endNote                String?                   @map("end_note")
  // when the system closed the leaver's sign-in for this ending (offboarding, 22 October 2026: their account disabled
  // once the last working day has passed, unless they work here again), so it's done once: an Admin may turn it back on
  signInClosedAt         DateTime?                 @map("sign_in_closed_at") @db.Timestamptz
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  contracts              Contract[]
  endings                EmploymentEnding[]
  documents              GeneratedDocument[]
  payrollLines           PayrollLine[]
  raiseRequests          RaiseRequest[]
  reimbursements         ReimbursementClaim[] // the reimbursements claimed under it
  finalSettlement        FinalSettlement? // its final dues, once settled (open until then)
  leaveRequests          LeaveRequest[] // the leave taken under it
  permissions            PermissionRequest[] // the permission hours taken under it
  wfhDays                WfhRequest[] // the work from home days under it (21 October 2026)
  resignationRequests    ResignationRequest[] // the resignation requests asked under it (26 October 2026)
  compensatoryDays       CompensatoryRequest[] // the compensatory days under it (26 October 2026)
  odRequests             OdRequest[] // the official duties under it (23 October 2026)
  corrections            AttendanceCorrection[] // the attendance corrections of its days
  leaveBalances          LeaveBalanceYear[] // each year's annual leave under it
  leaveAdjustments       LeaveAdjustment[]
  kpiScorecards          KpiScorecard[] // the KPI scorecards opened under it (21 October 2026)
  offboarding            OffboardingCase? // its offboarding case, once it is ending (22 October 2026)
  onboarding             OnboardingChecklist? // its onboarding checklist (22 October 2026)
  accessGraces           AccessGrace[] // the grace given while no contract was entered in it (23 October 2026)
  clientAccounts         ClientAccountAssignment[] // the client accounts held under it, the accounts allowance's (25 October 2026)

  @@index([employeeId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([gradeId])
  @@index([managerId])
  @@map("employments")
}

// RESTRICTED (HR, CEO). Kept apart from employees so it is never loaded by accident; the full numbers are only
// returned by GET /employees/:id/identity, and every such view is written to the audit log.
model EmployeeIdentity {
  employeeId    String    @id @map("employee_id") @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nationalId    String?   @unique @map("national_id") @db.Char(14)
  printedNo     String?   @map("printed_no") // الرقم المطبوع
  issueDate     DateTime? @map("issue_date") @db.Date // printed as MM/YYYY
  expiryDate    DateTime? @map("expiry_date") @db.Date
  // No longer used (owner, 15 October 2026: not on the card); kept so nothing already typed in is lost.
  issuingOffice String?   @map("issuing_office")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("employee_identity")
}

// RESTRICTED (HR, Finance, CEO). Account number and IBAN are only returned in full by GET /employees/:id/bank,
// and every such view is written to the audit log.
model EmployeeBank {
  employeeId String   @id @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bankName   String?  @map("bank_name")
  branch     String?
  accountNo  String?  @map("account_no")
  iban       String? // EG + 27 digits
  holderName String?  @map("holder_name")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("employee_bank")
}

// Scanned paperwork in the employee file (spec §8.5): national ID front and back, certificates, Form 1 …
// The file is kept in the database, so the daily backup includes it. Its text, read by the OCR service, makes it
// searchable. National ID scans are restricted like the national ID itself (HR, CEO).
model PaperworkItem {
  id           String               @id @default(uuid()) @db.Uuid
  employeeId   String               @map("employee_id") @db.Uuid
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind         String // packages/shared PAPERWORK_KINDS
  fileName     String               @map("file_name")
  mimeType     String               @map("mime_type")
  sizeBytes    Int                  @map("size_bytes")
  data         Bytes
  ocrStatus    String               @default("pending") @map("ocr_status") // pending, done, failed, unavailable
  ocrText      String?              @map("ocr_text")
  ocrAt        DateTime?            @map("ocr_at") @db.Timestamptz
  documentNo   String?              @map("document_no") // the number printed on the paper, if any
  expiresOn    DateTime?            @map("expires_on") @db.Date // when the paper stops being valid, if it does
  // a personal photo's square shown in the circle beside the name (PhotoCrop, packages/shared), as fractions of the
  // photo as shown; null: the whole photo, centred. The file itself is never changed by it.
  photoCrop    Json?                @map("photo_crop")
  uploadedById String?              @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?                @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime             @default(now()) @map("uploaded_at") @db.Timestamptz
  consentFor   RecurringDeduction[] // a signed deduction consent: the recurring deductions it is the consent of
  fromRequests ProfilePhotoRequest[] // a personal photo the employee sent, approved by HR (31 October 2026)

  @@index([employeeId, kind])
  @@map("paperwork_items")
}

// Fixes learned from HR's corrections to ID card readings (src/paperwork/corrections.ts): whole words of the Arabic
// name or the address as read, and as HR corrected them. Applied to the next readings. Never national ID numbers or
// dates.
model OcrCorrection {
  id          String   @id @default(uuid()) @db.Uuid
  field       String // fullNameAr, addressAr
  wrong       String // the word(s) as read
  right       String // as HR corrected them
  timesSeen   Int      @default(1) @map("times_seen") // how often HR made this same correction
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([field, wrong])
  @@map("ocr_corrections")
}

// ---------- contracts and how an employment ends ----------
// The owner's decisions of 15 October 2026, checked against Labour Law No. 14 of 2025: every employment type has a
// fixed-term contract of a year, renewed in writing before it expires; the first months are probation, once per
// employer (Art. 90); an ending is recorded and approved by HR, then approved by the CEO, and takes effect when HR
// completes it on or after the last working day. Lists stored as text take their values from packages/shared
// (contracts.ts).

// The defaults for new contracts (one row, id 1): how many months of probation (the law's cap is 3, Art. 90) and how
// long a fixed term runs.
model ContractSettings {
  id                    Int      @id @default(1) // always 1
  probationMonths       Int      @default(3) @map("probation_months") // 0–3
  durationMonths        Int      @default(12) @map("duration_months") // 1–60
  // the basic wage social insurance Form 1 prints for an employee who has none of their own (owner, 16 October 2026)
  insuranceBasicDefault Decimal  @default(410) @map("insurance_basic_default") @db.Decimal(12, 2)
  // the basic salary's share of the gross a new contract or offer starts with, 1–100 (owner, 16 October 2026: Payroll Setup)
  basicPercentDefault   Int      @default(80) @map("basic_percent_default")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("contract_settings")
}

// The ways an employment can end (ENDING_RULES), seeded from ENDING_RULE_DEFAULTS. HR tunes the label, the notice,
// pay in lieu and whether it is offered; who starts it, how it ends the employment and its legal source stay as seeded.
model EndingRule {
  key          String             @id // ENDING_RULES, e.g. resignation
  label        String
  initiator    String // INITIATORS: employee, company, either, none
  noticeAmount Int                @map("notice_amount") // 0–365
  noticeUnit   String             @map("notice_unit") // NOTICE_UNITS: days, working_days, weeks, months
  payInLieu    Boolean            @map("pay_in_lieu") // whether the notice may be paid instead of worked
  endReason    String             @map("end_reason") // END_REASONS: what the employment's end reason becomes
  source       String // the article of the law or the contract clause it comes from
  active       Boolean            @default(true) // offered when ending an employment
  sortOrder    Int                @map("sort_order") // ENDING_RULES order
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  endings      EmploymentEnding[]

  @@map("ending_rules")
}

// One version of an employment's contract. Version 1 is the first; a renewal or a change of terms is a new version,
// and signing it replaces (supersedes) the one before. A signed version is never edited, except the dates it was
// signed and filed and its note. The job title, grade, department and shift are copied from the employment when it is
// signed, so the contract keeps what was agreed.
model Contract {
  id                  String              @id @default(uuid()) @db.Uuid
  number              String              @unique // CON-<start year>-<4-digit sequence per year>, e.g. CON-2026-0007
  employmentId        String              @map("employment_id") @db.Uuid
  employment          Employment          @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  version             Int // 1, 2 … within the employment
  // CONTRACT_FORMS (Labour Law 14/2025 Arts. 87, 88, 155): fixed (the default, a year), open_ended (no end date, no
  // duration, no renewal: it ends by notice, Art. 156) or specific_job (its job, the end date optional). On 15 October
  // 2026 the owner had every contract fixed-term; open-ended and specific-job came back on 18 October 2026.
  form                String              @default("fixed")
  jobToDo             String?             @map("job_to_do") // specific_job only: the job the contract is for (Art. 155)
  // an intern's agreement converted to a full-time contract (owner, 19 October 2026: "or can be only
  // renewed 1 time, after that it should be converted to a full time contract"): this version is the full-time contract,
  // and signing it makes the employment full_time, the same employment, so the service counts on; null for the others
  convertsTo          EmploymentType?     @map("converts_to")
  startDate           DateTime            @map("start_date") @db.Date
  endDate             DateTime?           @map("end_date") @db.Date // start + duration − 1 day; none when open-ended; a specific job's optional, as expected
  durationMonths      Int?                @map("duration_months") // none when open-ended or for a specific job
  probationMonths     Int                 @default(0) @map("probation_months") // 0–3, and 0 on a renewal (Art. 90)
  probationEnd        DateTime?           @map("probation_end") @db.Date // start + probation − 1 day; empty without probation
  // RESTRICTED (HR, Finance, CEO), like bank details
  grossSalary         Decimal             @map("gross_salary") @db.Decimal(12, 2)
  basicPercent        Int                 @default(80) @map("basic_percent") // the basic salary's share of the gross; the rest is variable
  netSalary           Decimal?            @map("net_salary") @db.Decimal(12, 2) // the approximate net, typed by HR
  insuredSalary       Decimal             @map("insured_salary") @db.Decimal(12, 2) // the gross and insured allowances, within the start year's insurable wage limits
  // how the pay is set (owner's request, 15 October 2026): a monthly salary, or by the hour (part-time), when the gross
  // is the monthly estimate, hourly rate × hours a week × 52 ÷ 12
  payBasis            String              @default("monthly") @map("pay_basis") // PAY_BASES: monthly, hourly
  hourlyRate          Decimal?            @map("hourly_rate") @db.Decimal(10, 2) // hourly only
  hoursPerWeek        Decimal?            @map("hours_per_week") @db.Decimal(4, 1) // hourly only: the contracted hours
  // the least paid a month by the hour (owner, 27 October 2026: "can i add rate per hour with a minimum monthly
  // payment?"; he chose "On each contract" and "Prorated by days"): payroll pays the hours worked × the rate, or this
  // for the days paid if that is more; hourly only, null: no minimum
  hourlyMinimum       Decimal?            @map("hourly_minimum") @db.Decimal(12, 2)
  daysPerWeek         Int?                @map("days_per_week") // working days a week (part-time: 2, 3 …); empty: the shift's week
  allowances          ContractAllowance[] // RESTRICTED like the salary
  // copied from the employment when signed
  jobTitleEn          String?             @map("job_title_en")
  jobTitleAr          String?             @map("job_title_ar")
  gradeCode           String?             @map("grade_code")
  departmentName      String?             @map("department_name") // a team as "Department › Team"
  shiftCode           String?             @map("shift_code")
  status              String              @default("draft") // CONTRACT_STATUSES: draft, active (signed), ended, superseded
  signedOn            DateTime?           @map("signed_on") @db.Date
  insuranceFiledOn    DateTime?           @map("insurance_filed_on") @db.Date
  labourOfficeFiledOn DateTime?           @map("labour_office_filed_on") @db.Date
  note                String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  documents           GeneratedDocument[] // its printed copies (the contract slots), generated from templates
  payrollLines        PayrollLine[] // the months paid on its terms
  // Pay raises during a contract (owner's decisions, 16 October 2026; packages/shared raises.ts). A raise is an
  // amendment (kind amendment: the new pay on the same contract from its start date, the effective date, a 1st of a
  // month; its end the contract's, no term of its own, no probation; numbered as the contract with -A1, -A2 …) or a new
  // contract (kind contract, its own term from the effective date). A version that changes the pay (a raise, or a
  // renewal with new pay) has its reason and the CEO's step (approval): HR sends it, the CEO approves it or returns it
  // with a reason; only an approved one is signed. A promotion with it is applied to the employment when it is signed.
  // The insured wage follows its pay from the next 1 January, or from the Form 2 date HR records.
  kind                String              @default("contract") // CONTRACT_KINDS: contract, amendment
  raiseReason         String?             @map("raise_reason") // RAISE_REASONS; set on a version that changes the pay (adjustment: from before 17 October 2026)
  approval            String? // RAISE_APPROVALS: draft, pending_ceo, approved; null: no CEO step (the first, a renewal with the same pay)
  sentAt              DateTime?           @map("sent_at") @db.Timestamptz // sent to the CEO, last
  approvedById        String?             @map("approved_by") @db.Uuid
  approvedBy          User?               @relation("RaiseApproval", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?           @map("approved_at") @db.Timestamptz
  returnedReason      String?             @map("returned_reason") // why the CEO sent it back to HR, until it is sent again
  newJobTitleId       String?             @map("new_job_title_id") @db.Uuid // a promotion: the job title from the raise
  newJobTitle         JobTitle?           @relation("RaiseJobTitle", fields: [newJobTitleId], references: [id], onDelete: Restrict)
  newGradeId          String?             @map("new_grade_id") @db.Uuid // a promotion: the grade, within the job title's range
  newGrade            Grade?              @relation("RaiseGrade", fields: [newGradeId], references: [id], onDelete: Restrict)
  form2From           DateTime?           @map("form2_from") @db.Date // Form 2 filed: the insured wage follows the new pay from this 1st of a month
  raiseRequest        RaiseRequest? // the request it was prepared from, if any
  accessGraces        AccessGrace[] // the grace given in the gap its end opened (23 October 2026)

  @@unique([employmentId, version])
  @@index([status, endDate])
  @@map("contracts")
}

// A request for a raise (owner, 16 October 2026: "a place to request raise by employee, or his manager or the HR, with
// a reason and to be going through an approval cycle"): by the employee for themself, their direct manager, or HR.
// Since 17 October 2026 ("requesting a raise should have a drop list reason first ( Annual Raise - Performance Raise -
// Counter Offer Raise - etc..) then add requester comment, suggest raise amount or percentage"): a reason from the list,
// the requester's comment, and a suggested raise, an amount added to the gross (the employee's or HR's) or a percent of
// it (anyone's: a manager suggests a percent only). HR approves it, which prepares the raise from it (contractId) and
// sends it to the CEO, or rejects it; the CEO's decision on that raise is the request's; it is done once the raise is
// signed. One open per person. Each step is logged on it (RaiseRequestStep). The amounts are RESTRICTED (HR, Finance,
// CEO): the manager never sees one, the employee only their own suggestion and, once signed, their new salary. Effective
// from (owner, 17 October 2026: "in the request their should be a tab called Effective from"): the 1st of the month the
// raise is asked from, required on a new request and seen by everyone who sees it (a date, not a figure); HR's approval
// takes it as the raise's effective date unless HR sets another.
model RaiseRequest {
  id                String             @id @default(uuid()) @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId      String             @map("employment_id") @db.Uuid // the employment it was asked under
  employment        Employment         @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  requestedById     String?            @map("requested_by") @db.Uuid
  requestedBy       User?              @relation("RaiseRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requester         String // RAISE_REQUESTERS: self, manager, hr
  // RAISE_REQUEST_ORIGINS: request (asked for) or direct (owner, 19 October 2026: a raise HR prepared directly on the
  // contract, or a renewal with new pay, given its request with the CEO's step, so Raise Requests has every raise)
  origin            String             @default("request")
  raiseReason       String?            @map("raise_reason") // RAISE_REASON_CHOICES (a direct one its raise's, adjustment too); none on a request from before 17 October 2026
  comment           String // the requester's comment; on a request from before 17 October 2026, the reason it was asked with
  suggestedIncrease Decimal?           @map("suggested_increase") @db.Decimal(12, 2) // RESTRICTED: EGP added to the gross; never a manager's
  suggestedPercent  Decimal?           @map("suggested_percent") @db.Decimal(5, 2) // a percent of the gross; one or the other
  suggestedGross    Decimal?           @map("suggested_gross") @db.Decimal(12, 2) // RESTRICTED: the gross the suggestion came to (typed before 17 October 2026)
  effectiveFrom     DateTime?          @map("effective_from") @db.Date // the 1st of the month the raise is asked from (a direct one: its raise's effective date); none on a request from before 17 October 2026
  status            String             @default("with_hr") // RAISE_REQUEST_STATUSES: with_hr, with_ceo, approved, declined, done
  contractId        String?            @unique @map("contract_id") @db.Uuid // the raise HR prepared from it
  contract          Contract?          @relation(fields: [contractId], references: [id], onDelete: SetNull)
  declinedById      String?            @map("declined_by") @db.Uuid
  declinedBy        User?              @relation("RaiseRequestDecline", fields: [declinedById], references: [id], onDelete: SetNull)
  declinedAt        DateTime?          @map("declined_at") @db.Timestamptz
  declinedStage     String?            @map("declined_stage") // hr or ceo
  declineReason     String?            @map("decline_reason") // the comment it was rejected with
  doneAt            DateTime?          @map("done_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  steps             RaiseRequestStep[]

  @@index([employeeId])
  @@index([status])
  @@map("raise_requests")
}

// A step of a raise request, logged on it in the order taken (owner, 17 October 2026: "all the request steps to be
// logged in the request"), written in the same transaction as the step itself: RAISE_REQUEST_STEP_KINDS. HR's and the
// CEO's decisions have their decision (approve, approve_other, reject) and comment; a figure is the raise as typed
// (amount or percent: `figure` says which), with both figures and the gross it comes to; the raise prepared has its way,
// effective date and number. The figures are RESTRICTED, shaped per viewer by the API. Ordered by id.
model RaiseRequestStep {
  id              BigInt       @id @default(autoincrement())
  requestId       String       @map("request_id") @db.Uuid
  request         RaiseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind            String // RAISE_REQUEST_STEP_KINDS
  decision        String? // RAISE_DECISIONS, on hr_decision and ceo_decision only
  raiseReason     String?      @map("raise_reason") // submitted, prepared: the reason from the list; ceo_decision: the reason the CEO changed it to
  raiseReasonFrom String?      @map("raise_reason_from") // ceo_decision: the reason before the CEO changed it (19 October 2026)
  comment         String?
  figure          String? // RAISE_FIGURE_KINDS: which of the two was typed; null when worked out from the pay
  increaseAmount  Decimal?     @map("increase_amount") @db.Decimal(12, 2) // RESTRICTED: EGP a month on the gross before
  increasePercent Decimal?     @map("increase_percent") @db.Decimal(7, 2) // RESTRICTED (but a manager's own suggestion)
  gross           Decimal?     @db.Decimal(12, 2) // RESTRICTED: the gross it comes to
  way             String? // prepared: amendment or contract
  effectiveDate   DateTime?    @map("effective_date") @db.Date // prepared, signed: the 1st of a month it takes effect
  contractNumber  String?      @map("contract_number") // prepared, signed, raise_deleted: the raise's number
  actorId         String?      @map("actor_id") @db.Uuid
  actor           User?        @relation("RaiseRequestStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  at              DateTime     @default(now()) @db.Timestamptz

  @@index([requestId])
  @@map("raise_request_steps")
}

// How an employment ends: resignation, non-renewal, an ending during probation … (one of the ending rules). HR
// records it, which counts as HR's approval; the CEO approves or rejects it; HR completes it on or after the last
// working day, which ends the employment.
model EmploymentEnding {
  id                 String              @id @default(uuid()) @db.Uuid
  employmentId       String              @map("employment_id") @db.Uuid
  employment         Employment          @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  ruleKey            String              @map("rule_key")
  rule               EndingRule          @relation(fields: [ruleKey], references: [key], onDelete: Restrict)
  initiator          String? // employee or company; empty for death and disability
  noticeGivenOn      DateTime            @map("notice_given_on") @db.Date // the day the notice was received, or the event date
  payInLieu          Boolean             @default(false) @map("pay_in_lieu")
  lastWorkingDay     DateTime            @map("last_working_day") @db.Date // the notice's end, or the agreed day when lastDayAgreed
  // the last working day worked out from the rule's notice, kept beside an agreed one (owner, 26 October 2026: "let me
  // add agreed on last working date only by admin and HR")
  noticeEndsOn       DateTime            @map("notice_ends_on") @db.Date
  lastDayAgreed      Boolean             @default(false) @map("last_day_agreed") // HR or an Admin agreed lastWorkingDay with the employee
  // resignation only: certified at the labour office (Decree 187/2025); the company decides within 10 days
  certifiedOffice    String?             @map("certified_office")
  certifiedSerial    String?             @map("certified_serial")
  certifiedOn        DateTime?           @map("certified_on") @db.Date
  decisionDueOn      DateTime?           @map("decision_due_on") @db.Date
  reason             String?
  note               String?
  status             String              @default("pending_ceo") // ENDING_STATUSES
  hrApprovedById     String?             @map("hr_approved_by") @db.Uuid // who recorded it
  hrApprovedBy       User?               @relation("EndingHrApproval", fields: [hrApprovedById], references: [id], onDelete: SetNull)
  hrApprovedAt       DateTime?           @map("hr_approved_at") @db.Timestamptz
  ceoDecidedById     String?             @map("ceo_decided_by") @db.Uuid
  ceoDecidedBy       User?               @relation("EndingCeoDecision", fields: [ceoDecidedById], references: [id], onDelete: SetNull)
  ceoDecidedAt       DateTime?           @map("ceo_decided_at") @db.Timestamptz
  ceoNote            String?             @map("ceo_note")
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  documents          GeneratedDocument[] // the resignation request, the clearance and Form 6 generated for it
  offboarding        OffboardingCase[] // the offboarding case it opened (22 October 2026)
  resignationRequest ResignationRequest? // the employee's resignation request it was recorded from (26 October 2026)

  @@index([employmentId])
  @@index([status])
  @@index([ruleKey])
  @@map("employment_endings")
}

// An employee's request to resign (owner, 26 October 2026: "but the employee has to request resignation and then the HR
// generates the document"; packages/shared resignation-request.ts). Sent from My Requests with a reason, a preferred last
// working day and a signed letter, both optional; `sentOn` (Cairo) is the notice received day, and `ruleLastDay` the last
// working day the resignation rule's notice gives from it. HR (the CEO for a C-level person) records it as an ending:
// `endingId` links the ending made from it and the status becomes recorded. The employee may withdraw it until then; HR
// may return it with a reason. One open (sent) request an employment, by a partial unique index in the migration.
model ResignationRequest {
  id               String            @id @default(uuid()) @db.Uuid
  employeeId       String            @map("employee_id") @db.Uuid
  employee         Employee          @relation("ResignationRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId     String            @map("employment_id") @db.Uuid
  employment       Employment        @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  reason           String // PERSONAL free text: masked for a developer
  preferredLastDay DateTime?         @map("preferred_last_day") @db.Date
  sentOn           DateTime          @map("sent_on") @db.Date // the notice received day, in Cairo
  noticeAmount     Int               @map("notice_amount") // the resignation rule's notice as it was when sent
  noticeUnit       String            @map("notice_unit")
  ruleLastDay      DateTime          @map("rule_last_day") @db.Date
  status           String            @default("sent") // RESIGNATION_REQUEST_STATUSES
  letterName       String?           @map("letter_name")
  letterMime       String?           @map("letter_mime")
  letterSize       Int?              @map("letter_size")
  letterData       Bytes?            @map("letter_data")
  withdrawnAt      DateTime?         @map("withdrawn_at") @db.Timestamptz
  returnedReason   String?           @map("returned_reason")
  returnedById     String?           @map("returned_by") @db.Uuid
  returnedBy       User?             @relation("ResignationReturner", fields: [returnedById], references: [id], onDelete: SetNull)
  returnedAt       DateTime?         @map("returned_at") @db.Timestamptz
  endingId         String?           @unique @map("ending_id") @db.Uuid
  ending           EmploymentEnding? @relation(fields: [endingId], references: [id], onDelete: SetNull)
  recordedById     String?           @map("recorded_by") @db.Uuid
  recordedBy       User?             @relation("ResignationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt       DateTime?         @map("recorded_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@index([employeeId])
  @@index([status])
  @@index([employmentId])
  @@map("resignation_requests")
}

// ---------- the employee's own check of their details ----------
// Owner's decision, 15 October 2026: an employee confirms their personal, contact, emergency contact and education
// details (packages/shared CONFIRM_FIELDS) once, and again after every change, accepting the statement that they are
// responsible for what they confirmed (PROFILE_DISCLAIMER). They don't edit the data: they ask for a change, which HR
// or an Admin approves (the change is then made as an HR edit) or rejects.

// One confirmation, with the values confirmed. The confirmation is up to date while every confirmed field still has
// the value in the snapshot: a change by HR makes it stale, and changing the field back makes it up to date again.
model ProfileConfirmation {
  id                String   @id @default(uuid()) @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId            String   @map("user_id") @db.Uuid // who confirmed: the employee's own sign-in account
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  confirmedAt       DateTime @default(now()) @map("confirmed_at") @db.Timestamptz
  disclaimerVersion Int      @map("disclaimer_version") // the PROFILE_DISCLAIMER version accepted
  snapshot          Json // { field: value } for every CONFIRM_FIELDS key, dates as YYYY-MM-DD, empty as null

  @@index([employeeId, confirmedAt])
  @@map("profile_confirmations")
}

// A change the employee asked for to their own details. HR or an Admin approves it (the change is made) or rejects
// it; the employee may cancel it while it waits. One waits per employee at a time (checked by the API).
model ProfileChangeRequest {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedById String    @map("requested_by") @db.Uuid // the employee's own sign-in account
  requestedBy   User      @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  changes       Json // [{ field, from, to }] in CONFIRM_FIELDS order, values as an HR edit would save them
  note          String?
  status        String    @default("pending") // CHANGE_REQUEST_STATUSES: pending, approved, rejected, cancelled
  decidedById   String?   @map("decided_by") @db.Uuid // who approved or rejected it, or the employee who cancelled it
  decidedBy     User?     @relation("ChangeDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz
  decisionNote  String?   @map("decision_note")

  @@index([status])
  @@index([employeeId])
  @@map("profile_change_requests")
}

// A new photo of themself the employee sends HR (owner, 31 October 2026: "allow them to upload a new photo as a request
// and approved from the HR"). The file is kept in the database, as the employee file's papers are. HR or an Admin (a
// C-level person's: the CEO or a Super Admin) approves it, and it becomes the employee file's personal photo, or rejects
// it; the employee may cancel it while it waits. One waits per employee at a time (checked by the API).
model ProfilePhotoRequest {
  id            String         @id @default(uuid()) @db.Uuid
  employeeId    String         @map("employee_id") @db.Uuid
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedById String         @map("requested_by") @db.Uuid // the employee's own sign-in account
  requestedBy   User           @relation("PhotoRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz
  fileName      String         @map("file_name")
  mimeType      String         @map("mime_type") // a JPEG, PNG or WebP image, checked by its content
  sizeBytes     Int            @map("size_bytes")
  data          Bytes
  note          String?
  status        String         @default("pending") // CHANGE_REQUEST_STATUSES: pending, approved, rejected, cancelled
  decidedById   String?        @map("decided_by") @db.Uuid // who approved or rejected it, or the employee who cancelled it
  decidedBy     User?          @relation("PhotoDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz
  decisionNote  String?        @map("decision_note")
  photoId       String?        @map("photo_id") @db.Uuid // once approved: the personal photo it became in the employee file
  photo         PaperworkItem? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([employeeId])
  @@map("profile_photo_requests")
}

// ---------- document templates ----------
// The template library (spec §8; owner's request, 15 October 2026: "Start working on the templates tab; I need to
// upload the templates"). HR uploads each Word file exactly as used today, with merge tags such as {{full_name_ar}}
// where the data goes; the system never changes the wording, it only replaces the tags. Each upload is a new version
// of its slot (packages/shared TEMPLATE_SLOTS): a draft until it is published, and publishing retires the version in
// use. A version that was in use is kept, so documents made from it keep their version; only a draft can be deleted.

// One uploaded version of a template. The tags are read from the file when it is uploaded; a version with tags the
// dictionary doesn't have (unknown_tags) or with broken ones can't be published. At most one version per slot is
// published (checked by the API, in a transaction).
model TemplateVersion {
  id            String              @id @default(uuid()) @db.Uuid
  slotKey       String              @map("slot_key") // a TEMPLATE_SLOTS key (checked by the API); never a copy's (copyOf)
  version       Int // 1, 2 … within the slot
  fileName      String              @map("file_name")
  mimeType      String              @map("mime_type") // a Word document (.docx) or a PDF, checked by its content
  sizeBytes     Int                 @map("size_bytes")
  data          Bytes
  format        String              @default("docx") // docx: a Word template with {{tags}}; pdf: a form with its fields placed on it
  pdfPages      Json?               @map("pdf_pages") // a PDF's pages as shown (PdfPageSize[], packages/shared), read at upload
  pdfFields     Json?               @map("pdf_fields") // the fields placed on a PDF (PdfField[]); [] until HR places them
  language      String // TEMPLATE_LANGUAGES: ar, en
  tags          String[] // the dictionary's tags found (a PDF: its fields' tags), in order of first appearance
  unknownTags   String[]            @map("unknown_tags") // well-formed tags the dictionary doesn't have
  broken        String[] // fragments that look like a tag but aren't one, e.g. "{{ full_name_ar" (at most 20)
  status        String              @default("draft") // TEMPLATE_VERSION_STATUSES: draft, published, retired
  note          String?
  uploadedById  String?             @map("uploaded_by") @db.Uuid
  uploadedBy    User?               @relation("TemplateUpload", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt    DateTime            @default(now()) @map("uploaded_at") @db.Timestamptz
  publishedById String?             @map("published_by") @db.Uuid
  publishedBy   User?               @relation("TemplatePublication", fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime?           @map("published_at") @db.Timestamptz
  documents     GeneratedDocument[] // the documents filled in from this version
  offers        JobOffer[] // the job offers filled in from this version

  @@unique([slotKey, version])
  @@map("template_versions")
}

// ---------- documents generated from templates ----------
// The profile's Contracts tab (spec §8.3–8.4; owner's request, 15 October 2026): the documents the company issues from
// the published templates, each with its lifecycle, generated → printed → signed copy uploaded → verified. Generating
// fills the published version's {{tags}} with the employee's values and keeps the filled .docx; the version used is
// kept (it is never deleted once published), so a document always says which version it came from. The signed scan
// is checked and kept like paperwork. Only a Super Admin deletes one.

// One document generated for an employee: the contract (each copy) of a contract version, a job offer, an NDA, a
// letter, a certificate, a social insurance form, the resignation request or the clearance.
model GeneratedDocument {
  id                 String            @id @default(uuid()) @db.Uuid
  employeeId         String            @map("employee_id") @db.Uuid
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId       String?           @map("employment_id") @db.Uuid // the employment it was issued under
  employment         Employment?       @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  contractId         String?           @map("contract_id") @db.Uuid // a contract slot's contract version
  contract           Contract?         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  endingId           String?           @map("ending_id") @db.Uuid // the resignation request's, the clearance's and Form 6's ending
  ending             EmploymentEnding? @relation(fields: [endingId], references: [id], onDelete: Cascade)
  settlements        FinalSettlement[] // the final settlements it is the clearance and dues of
  slotKey            String            @map("slot_key") // a TEMPLATE_SLOTS key (checked by the API)
  templateVersionId  String            @map("template_version_id") @db.Uuid // the published version it was filled in from
  templateVersion    TemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  // what was typed when generating, e.g. { "letter_to": "…", "letter_purpose": "…" }
  inputs             Json              @default("{}")
  documentDate       DateTime          @map("document_date") @db.Date // the date printed on it ({{date}}, {{contract_date}})
  // the filled .docx
  fileName           String            @map("file_name")
  data               Bytes
  sizeBytes          Int               @map("size_bytes")
  hasRestricted      Boolean           @map("has_restricted") // it prints restricted data (national ID, salary, bank): every view is audited
  status             String            @default("generated") // generated, printed, signed, verified
  generatedById      String?           @map("generated_by") @db.Uuid
  generatedBy        User?             @relation("DocumentGeneration", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt        DateTime          @default(now()) @map("generated_at") @db.Timestamptz
  printedById        String?           @map("printed_by") @db.Uuid
  printedBy          User?             @relation("DocumentPrinting", fields: [printedById], references: [id], onDelete: SetNull)
  printedAt          DateTime?         @map("printed_at") @db.Timestamptz
  signedUploadedById String?           @map("signed_uploaded_by") @db.Uuid
  signedUploadedBy   User?             @relation("DocumentSignedUpload", fields: [signedUploadedById], references: [id], onDelete: SetNull)
  signedUploadedAt   DateTime?         @map("signed_uploaded_at") @db.Timestamptz
  verifiedById       String?           @map("verified_by") @db.Uuid
  verifiedBy         User?             @relation("DocumentVerification", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?         @map("verified_at") @db.Timestamptz
  // the signed copy, scanned: a photo or a PDF, checked by its content like paperwork
  signedFileName     String?           @map("signed_file_name")
  signedMime         String?           @map("signed_mime")
  signedSize         Int?              @map("signed_size")
  signedData         Bytes?            @map("signed_data")
  note               String?

  @@index([employeeId, slotKey])
  @@map("generated_documents")
}

// ---------- audit ----------

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  userId         String?  @map("user_id") @db.Uuid
  user           User?    @relation("AuditUser", fields: [userId], references: [id])
  // The Super Admin who did it while viewing as the user (owner's decision, 17 October 2026: "a super admin can view any
  // other user profile from a switcher"): set on what they did in the user's name with Act as them on, and on the
  // restricted data they viewed; null otherwise.
  onBehalfById   String?  @map("on_behalf_by") @db.Uuid
  onBehalfBy     User?    @relation("AuditOnBehalf", fields: [onBehalfById], references: [id], onDelete: SetNull)
  action         String // create, update, delete, login, view_restricted, view_as_start …
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  diff           Json?
  at             DateTime @default(now()) @db.Timestamptz
  // How it was done, when not on the website or the app: 'claude_connector' (owner, 21 October 2026: "the connection
  // method"), the user's own Claude through the connector; null otherwise.
  via            String?
  // Where it came from (owner, 31 October 2026: "with location and ip capture"), from the request it was written in;
  // all null for what no request wrote (the schedulers, the nightly Zoho fetch) and for entries from before. The
  // address: the website's, signed with WEB_KEY ('website'), else the connection's own ('connection': the app, or a
  // request the website didn't sign). The place: Vercel's city, region and country for the website's requests. The
  // browser or app: its user agent. The phone's position (owner, 31 October 2026: "Yes, with each sign-in and action"):
  // only from the app, as it sent it, `locationMock` when the phone said the position is made up.
  ip             String?
  ipSource       String?  @map("ip_source")
  country        String?
  region         String?
  city           String?
  userAgent      String?  @map("user_agent")
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  accuracyMetres Int?     @map("accuracy_metres")
  locationMock   Boolean? @map("location_mock")

  @@index([entityType, entityId])
  // the Sign-ins tab and the Result filter: by action, newest first
  @@index([action, id])
  @@map("audit_log")
}

// ---------- allowances ----------
// Allowances paid every month on top of the gross salary (owner's request, 15 October 2026): their kinds are set by HR,
// each taxed or not and counted in the insured wage or not. A cash allowance is taxed by law (Law 91/2005 Art. 9; the
// Tax Authority's FAQ, Q17); only transport the company itself provides is exempt. A contract or an offer keeps each
// allowance's name and treatment as they were when it was drafted, so a later change to a kind changes neither.

model AllowanceType {
  id        String              @id @default(uuid()) @db.Uuid
  nameEn    String              @unique @map("name_en")
  nameAr    String              @map("name_ar")
  taxable   Boolean             @default(true) // counted in the salary tax
  insured   Boolean             @default(false) // counted in the insured wage (within its limits)
  active    Boolean             @default(true) // an inactive kind isn't offered for new contracts and offers
  sortOrder Int                 @default(0) @map("sort_order")
  // how it is paid (owner, 25 October 2026: an allowance per client account): ALLOWANCE_BASES, fixed (an amount a month on
  // the contract) or per_account (no amount on the contract: payroll pays the month's client accounts by days held);
  // changed only while no contract or offer has it
  basis     String              @default("fixed")
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  contracts ContractAllowance[]
  offers    OfferAllowance[]

  @@map("allowance_types")
}

// An allowance of a contract version, a month. RESTRICTED (HR, Finance, CEO), like the salary.
model ContractAllowance {
  id               String        @id @default(uuid()) @db.Uuid
  contractId       String        @map("contract_id") @db.Uuid
  contract         Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  allowanceTypeId  String        @map("allowance_type_id") @db.Uuid
  allowanceType    AllowanceType @relation(fields: [allowanceTypeId], references: [id], onDelete: Restrict)
  nameEn           String        @map("name_en") // as the kind was when the contract was drafted or last changed
  nameAr           String        @map("name_ar")
  taxable          Boolean
  insured          Boolean
  amount           Decimal       @db.Decimal(12, 2) // 0 for a per-account one: eligibility only
  basis            String        @default("fixed") // the kind's, as drafted (25 October 2026): fixed, or per_account
  // a per-account one's amount per account, when the contract or the offer sets one (owner, 27 October 2026: "why cant i
  // add rate per account?"): paid for every account held in place of each assignment's amount; null: each assignment's
  perAccountAmount Decimal?      @map("per_account_amount") @db.Decimal(12, 2)

  @@unique([contractId, allowanceTypeId])
  @@map("contract_allowances")
}

// An allowance of a job offer, a month. RESTRICTED like the salary.
model OfferAllowance {
  id               String        @id @default(uuid()) @db.Uuid
  offerId          String        @map("offer_id") @db.Uuid
  offer            JobOffer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  allowanceTypeId  String        @map("allowance_type_id") @db.Uuid
  allowanceType    AllowanceType @relation(fields: [allowanceTypeId], references: [id], onDelete: Restrict)
  nameEn           String        @map("name_en")
  nameAr           String        @map("name_ar")
  taxable          Boolean
  insured          Boolean
  amount           Decimal       @db.Decimal(12, 2) // 0 for a per-account one: eligibility only
  basis            String        @default("fixed") // the kind's, as drafted (25 October 2026): fixed, or per_account
  // a per-account one's amount per account, when the contract or the offer sets one (owner, 27 October 2026: "why cant i
  // add rate per account?"): paid for every account held in place of each assignment's amount; null: each assignment's
  perAccountAmount Decimal?      @map("per_account_amount") @db.Decimal(12, 2)

  @@unique([offerId, allowanceTypeId])
  @@map("offer_allowances")
}

// ---------- client accounts ----------
// Client accounts and the accounts allowance (owner, 25 October 2026: "if an employee has an allowance per account, how
// can we deal with it?"; asked, a "Client accounts list", the rate "variable", a part month "By days"; packages/shared
// client-accounts.ts). The company's client accounts, each served by people assigned to it from a date to a date, each
// assignment with its own amount a month (filled in from the account's default, set on it or from a size tier). A
// person whose contract has the per-account allowance (the seeded "Accounts allowance") is paid, each month, the sum of
// their assignments for the days held. The amounts are RESTRICTED like the salary (HR, Finance, the CEO); a C-level
// person's assignments are the CEO's, hidden from HR as their contract is. Under Clients → Client Accounts, which will
// hold Projects and Timesheets later.

// An optional size of account (Small, Medium, Large …) with its default amount a month: it only fills in an account's
// default when chosen. Set by HR and the CEO. RESTRICTED amount.
model ClientAccountTier {
  id            String          @id @default(uuid()) @db.Uuid
  nameEn        String          @unique @map("name_en")
  defaultAmount Decimal         @map("default_amount") @db.Decimal(12, 2)
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  accounts      ClientAccount[]

  @@map("client_account_tiers")
}

// A client account: its names, an optional code, size tier and team (the department or team that serves it), its
// default amount a month for the people assigned (RESTRICTED), and its status (CLIENT_ACCOUNT_STATUSES): an account
// ended on a day ends its assignments then and takes no new ones.
model ClientAccount {
  id            String                    @id @default(uuid()) @db.Uuid
  nameEn        String                    @map("name_en") // unique whatever the case: checked by the API
  nameAr        String?                   @map("name_ar")
  code          String?                   @unique
  tierId        String?                   @map("tier_id") @db.Uuid
  tier          ClientAccountTier?        @relation(fields: [tierId], references: [id], onDelete: SetNull)
  defaultAmount Decimal                   @map("default_amount") @db.Decimal(12, 2)
  status        String                    @default("active")
  endedOn       DateTime?                 @map("ended_on") @db.Date
  notes         String?
  departmentId  String?                   @map("department_id") @db.Uuid
  department    Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  assignments   ClientAccountAssignment[]

  @@index([departmentId])
  @@index([tierId])
  @@map("client_accounts")
}

// A person assigned to a client account, under their employment, from a day to a day (none: still), at an amount a
// month (RESTRICTED). Several people share an account, one person holds many; never the same person twice on one account
// on the same day (checked by the API). Their dates and amount never change what a run with the CEO, approved or paid
// paid; their employment ending ends them on its last day.
model ClientAccountAssignment {
  id           String        @id @default(uuid()) @db.Uuid
  accountId    String        @map("account_id") @db.Uuid
  account      ClientAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  employeeId   String        @map("employee_id") @db.Uuid
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId String        @map("employment_id") @db.Uuid
  employment   Employment    @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  fromDate     DateTime      @map("from_date") @db.Date
  toDate       DateTime?     @map("to_date") @db.Date
  amount       Decimal       @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([accountId])
  @@index([employeeId])
  @@index([employmentId])
  @@map("client_account_assignments")
}

// ---------- job offers ----------
// The offer stage (owner's request, 15 October 2026): a candidate is not an employee. HR drafts the offer (the person,
// the position and the terms), fills in the job offer template, and sends it: by email from the system, or as a link
// HR sends. The candidate opens the link, reads the offer and accepts it (typing their name) or declines it; HR can
// also record an answer given another way. Only once accepted does the person get a profile, with the employment and
// a draft contract made from the offer, so candidates never appear in the employee lists and counts.
model JobOffer {
  id                String           @id @default(uuid()) @db.Uuid
  number            String           @unique // OFF-<year drafted>-<4-digit sequence per year>
  status            String           @default("draft") // OFFER_STATUSES: draft, sent, accepted, declined, withdrawn (expired is worked out)
  // the candidate
  fullNameEn        String           @map("full_name_en")
  fullNameAr        String           @map("full_name_ar")
  email             String // their personal email, where the offer is sent
  mobile            String?
  employeeId        String?          @map("employee_id") @db.Uuid // a former employee offered again; once accepted, the profile
  employee          Employee?        @relation("OfferPerson", fields: [employeeId], references: [id], onDelete: SetNull)
  // the position
  employmentType    EmploymentType   @map("employment_type")
  departmentId      String?          @map("department_id") @db.Uuid
  department        Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitleId        String?          @map("job_title_id") @db.Uuid
  jobTitle          JobTitle?        @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  gradeId           String?          @map("grade_id") @db.Uuid
  grade             Grade?           @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  managerId         String?          @map("manager_id") @db.Uuid
  manager           Employee?        @relation("OfferManager", fields: [managerId], references: [id], onDelete: Restrict)
  shiftId           String?          @map("shift_id") @db.Uuid
  shift             Shift?           @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  workArrangement   WorkArrangement  @default(office) @map("work_arrangement")
  officeDays        Int[]            @default([]) @map("office_days") @db.SmallInt // Hybrid only; 0 = Sun … 6 = Sat
  paidByCommission  Boolean          @default(false) @map("paid_by_commission") // full-time only; carried to the employment (18 October 2026)
  workNature        String           @default("regular") @map("work_nature") // WORK_NATURES; carried to the employment
  joinDate          DateTime         @map("join_date") @db.Date // the expected first day
  // the terms: RESTRICTED (HR, Finance, CEO), like a contract's
  payBasis          String           @default("monthly") @map("pay_basis") // PAY_BASES
  grossSalary       Decimal          @map("gross_salary") @db.Decimal(12, 2) // a month; hourly: the monthly estimate
  hourlyRate        Decimal?         @map("hourly_rate") @db.Decimal(10, 2)
  hoursPerWeek      Decimal?         @map("hours_per_week") @db.Decimal(4, 1)
  hourlyMinimum     Decimal?         @map("hourly_minimum") @db.Decimal(12, 2) // by the hour: the least paid a month (27 October 2026); null: none
  daysPerWeek       Int?             @map("days_per_week")
  basicPercent      Int              @default(80) @map("basic_percent")
  netSalary         Decimal?         @map("net_salary") @db.Decimal(12, 2)
  probationMonths   Int              @default(3) @map("probation_months")
  durationMonths    Int              @default(12) @map("duration_months")
  allowances        OfferAllowance[]
  expiresOn         DateTime         @map("expires_on") @db.Date // the last day to accept
  message           String? // a few words to the candidate, in the email
  note              String? // for HR only
  // the document, as sent (a draft's is filled in afresh each time it is previewed)
  templateVersionId String?          @map("template_version_id") @db.Uuid
  templateVersion   TemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  documentDate      DateTime?        @map("document_date") @db.Date
  fileName          String?          @map("file_name") // the .docx's name; the PDF's is the same with .pdf
  data              Bytes? // the filled .docx
  pdf               Bytes? // the same as PDF, when the converter answered
  // sending
  tokenHash         String?          @unique @map("token_hash") // SHA-256 of the link's secret; sending again replaces it
  sentVia           String?          @map("sent_via") // OFFER_SENT_WAYS: email, link, outside (recorded as sent earlier)
  sentTo            String?          @map("sent_to")
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz
  sentById          String?          @map("sent_by") @db.Uuid
  sentBy            User?            @relation("OfferSending", fields: [sentById], references: [id], onDelete: SetNull)
  sentCount         Int              @default(0) @map("sent_count")
  viewedAt          DateTime?        @map("viewed_at") @db.Timestamptz // the candidate first opened the link
  // the answer
  respondedAt       DateTime?        @map("responded_at") @db.Timestamptz
  answeredById      String?          @map("answered_by") @db.Uuid // HR recorded it; empty when the candidate answered online
  answeredBy        User?            @relation("OfferAnswer", fields: [answeredById], references: [id], onDelete: SetNull)
  acceptedName      String?          @map("accepted_name") // the name the candidate typed to accept
  declineReason     String?          @map("decline_reason")
  responseIp        String?          @map("response_ip")
  responseAgent     String?          @map("response_agent")
  withdrawnAt       DateTime?        @map("withdrawn_at") @db.Timestamptz
  withdrawReason    String?          @map("withdraw_reason")
  hiredAt           DateTime?        @map("hired_at") @db.Timestamptz // the profile, employment and draft contract were made from it
  // an earlier offer (owner, 25 October 2026: "allow the HR to add for now job offers with a past duedate to enter the
  // previous data"): saved with a past last day, or recorded as sent outside the system, while Recruitment Settings'
  // "Entering earlier offers" was on; never emailed, linked or told to the candidate
  recordedEarlier   Boolean          @default(false) @map("recorded_earlier")
  // the application it was made from (recruitment, 22 October 2026: Make offer); its answer moves the application on
  applicationId     String?          @map("application_id") @db.Uuid
  application       JobApplication?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  createdById       String?          @map("created_by") @db.Uuid
  createdBy         User?            @relation("OfferCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([employeeId])
  @@index([applicationId])
  @@map("job_offers")
}

// ---------- recruitment ----------
// The ATS, Phase 1 (owner, 22 October 2026: "where will we include the ATS?"; the original plan's spec §12; packages/shared
// recruitment.ts): vacancies HR drafts and the CEO approves before they are published on the careers page
// (people.trendlix.com/careers), the applications that page takes with their CV, and each applicant's stages up to the
// job offer. Applicants are never employees until a job offer to them is accepted (OfferHiringService makes the profile).

// A vacancy: VAC-<year>-<4 digits>, on the careers page at /careers/<slug> while open. Its position (the job title and its
// department, a grade, the hiring manager, headcount, employment type, arrangement, shift, contract length); the internal
// salary range (HR, the CEO and a Super Admin only: never on the careers page); the public description, cleaned HTML as
// job descriptions are, filled in from the job title's JD; the screening questions ([VacancyQuestion], at most 10). Its
// status: draft, pending (the CEO decides), open, on_hold, closed, filled (its hires reached the headcount). A C-level
// one (a confidential grade, or a job title only for one) is the CEO's and a Super Admin's only. Only a Super Admin
// deletes one; since 25 October 2026 also with applicants, their applications deleted with it first (its number typed;
// apps/api/src/recruitment/recruitment-deletes.service.ts), so applications stay Restrict here.
model Vacancy {
  id               String              @id @default(uuid()) @db.Uuid
  number           String              @unique
  slug             String              @unique
  status           String              @default("draft") // VACANCY_STATUSES
  title            String
  jobTitleId       String              @map("job_title_id") @db.Uuid
  jobTitle         JobTitle            @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  departmentId     String?             @map("department_id") @db.Uuid // the job title's department or team
  department       Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  gradeId          String?             @map("grade_id") @db.Uuid
  grade            Grade?              @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  hiringManagerId  String?             @map("hiring_manager_id") @db.Uuid
  hiringManager    Employee?           @relation("VacancyHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  headcount        Int                 @default(1)
  employmentType   EmploymentType      @map("employment_type")
  workArrangement  WorkArrangement     @default(office) @map("work_arrangement")
  shiftId          String?             @map("shift_id") @db.Uuid
  shift            Shift?              @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  durationMonths   Int?                @map("duration_months")
  closingDate      DateTime?           @map("closing_date") @db.Date
  salaryMin        Decimal?            @map("salary_min") @db.Decimal(12, 2) // RESTRICTED: HR, the CEO, a Super Admin
  salaryMax        Decimal?            @map("salary_max") @db.Decimal(12, 2)
  about            String? // HTML: the purpose of the role
  responsibilities String? // HTML: the duties
  requirements     String? // HTML
  questions        Json                @default("[]")
  keySkills        String[]            @default([]) @map("key_skills") // the skills a CV is checked for (CV match %), at most 20 (22 October 2026)
  portfolioMode    String?             @map("portfolio_mode") // its form's portfolio: hidden, optional, required; none: as the job title (25 October 2026)
  // marketing agency background in its CV fit (owner, 27 October 2026: "i need a flag if the candidate is ex marketing
  // agencies or not AND reflectin the scoring"; "Set per job"): AGENCY_BACKGROUNDS required, preferred, not_needed
  agencyBackground String              @default("preferred") @map("agency_background")
  // how its CV fit counts a CV's years (owner, 29 October 2026: "make it career based or company based"; "Set per job"):
  // EXPERIENCE_BASES company (the months worked, the default), career (first job to latest, gaps included)
  experienceBasis  String              @default("company") @map("experience_basis")
  submittedAt      DateTime?           @map("submitted_at") @db.Timestamptz
  submittedById    String?             @map("submitted_by") @db.Uuid
  submittedBy      User?               @relation("VacancySubmission", fields: [submittedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?           @map("decided_at") @db.Timestamptz
  decidedById      String?             @map("decided_by") @db.Uuid
  decidedBy        User?               @relation("VacancyDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  sentBackReason   String?             @map("sent_back_reason") // why the CEO sent it back, while it is a draft again
  publishedAt      DateTime?           @map("published_at") @db.Timestamptz // first approved
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz
  closedById       String?             @map("closed_by") @db.Uuid
  closedBy         User?               @relation("VacancyClosing", fields: [closedById], references: [id], onDelete: SetNull)
  closeReason      String?             @map("close_reason")
  createdById      String?             @map("created_by") @db.Uuid
  createdBy        User?               @relation("VacancyCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  applications     JobApplication[]
  cvUploads        CvUpload[] // the bulk upload's CVs waiting for it (22 October 2026)
  suggestions      VacancySuggestion[] // Suggested From Earlier CVs (24 October 2026)
  openFits         CvOpenFit[] // the earlier CVs' fits for it while open (25 October 2026)

  @@index([status])
  @@index([jobTitleId])
  @@map("vacancies")
}

// An application from the careers page: APP-<year>-<4 digits>, one per email a vacancy. What the applicant sent (their
// details, the answers by question key, their consent), where they came from (?src=), the address it came from (the
// limit of applications an hour) and the match worked out with the vacancy's questions then: its points, the most
// possible, the % and whether a must-have filtered them out (kept, restorable). Its stage, HR's notes, the rejection's
// reason, and the profile made when they were hired.
model JobApplication {
  id                String                    @id @default(uuid()) @db.Uuid
  number            String                    @unique
  vacancyId         String                    @map("vacancy_id") @db.Uuid
  vacancy           Vacancy                   @relation(fields: [vacancyId], references: [id], onDelete: Restrict)
  stage             String                    @default("applied") // APPLICATION_STAGES
  rejectedFrom      String?                   @map("rejected_from") // the stage it was rejected at: restoring goes back to it
  filteredOut       Boolean                   @default(false) @map("filtered_out")
  fullName          String                    @map("full_name")
  email             String // trimmed, in lower case
  mobile            String
  linkedin          String?
  portfolio         String? // the first of portfolioLinks, for older code and pages
  // every portfolio link sent, at most 3 (owner, 25 October 2026: "Portfolio per position"; packages/shared portfolio.ts),
  // and "Confirmed by LinkedIn": 'linkedin' when LinkedIn gave this email, verified (linkedin-signin.ts); none otherwise
  portfolioLinks    String[]                  @default([]) @map("portfolio_links")
  emailConfirmedBy  String?                   @map("email_confirmed_by")
  yearsExperience   Decimal?                  @map("years_experience") @db.Decimal(4, 1)
  noticePeriod      String?                   @map("notice_period")
  expectedSalary    Decimal?                  @map("expected_salary") @db.Decimal(12, 2)
  answers           Json                      @default("{}")
  points            Int                       @default(0)
  maxPoints         Int                       @default(0) @map("max_points")
  matchPercent      Int?                      @map("match_percent")
  cvMatchPercent    Int?                      @map("cv_match_percent") // the CV fit's % since 25 October 2026 (once the key skills found, 22 October 2026); none: the CV not read
  cvFit             Json?                     @map("cv_fit") // the CV fit with its parts and version (owner, 25 October 2026: "Full CV fit score"; packages/shared cv-fit.ts)
  knockedOut        String[]                  @default([]) @map("knocked_out") // the must-have questions not passed, by key
  source            String                    @default("careers") // APPLICATION_SOURCES
  consentAt         DateTime                  @map("consent_at") @db.Timestamptz
  ip                String?
  userAgent         String?                   @map("user_agent")
  notes             String? // HR's
  rejectReason      String?                   @map("reject_reason")
  employeeId        String?                   @map("employee_id") @db.Uuid // the profile made from the accepted offer
  employee          Employee?                 @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  // the hiring manager's suggestion (Phase 2, 22 October 2026): the next step or a rejection, until HR acts on it
  suggestion        String? // HIRING_SUGGESTIONS: next, reject
  suggestionNote    String?                   @map("suggestion_note")
  suggestedById     String?                   @map("suggested_by") @db.Uuid
  suggestedBy       User?                     @relation("ApplicationSuggestion", fields: [suggestedById], references: [id], onDelete: SetNull)
  suggestedAt       DateTime?                 @map("suggested_at") @db.Timestamptz
  // HR's screening call (29 October 2026: "HR Screening and scheduling"; "Screening call + result"): on a shortlisted
  // applicant (the hiring manager's accepted one), passed or failed with a note; only one who passed is interviewed
  screeningCall     String?                   @map("screening_call") // SCREENING_CALL_RESULTS: passed, failed
  screeningCallNote String?                   @map("screening_call_note")
  screeningCallById String?                   @map("screening_call_by") @db.Uuid
  screeningCallBy   User?                     @relation("ApplicationScreeningCall", fields: [screeningCallById], references: [id], onDelete: SetNull)
  screeningCallAt   DateTime?                 @map("screening_call_at") @db.Timestamptz
  // the consent HR recorded (22 October 2026: a bulk upload's CV, a general CV moved here): who, and why ("LinkedIn
  // Easy Apply"); none: the applicant's own on the careers page
  consentById       String?                   @map("consent_by") @db.Uuid
  consentBy         User?                     @relation("ApplicationConsent", fields: [consentById], references: [id], onDelete: SetNull)
  consentNote       String?                   @map("consent_note")
  // the candidate's profile (owner, 22 October 2026: "how to make like a profile for each candidate to store history and
  // prevent duplication?"; packages/shared candidates.ts): set by every path that makes an application, those from
  // before by the backfill (candidates.service.ts), so kept nullable; one candidate an application a vacancy (checked
  // by the API under the candidates' lock, the email's unique below kept)
  candidateId       String?                   @map("candidate_id") @db.Uuid
  candidate         Candidate?                @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  generalCv         GeneralCv? // the general CV it was moved from
  cv                JobApplicationCv?
  // applying again for the job while it is open (owner, 25 October 2026: "Update their application"; packages/shared
  // reapply.ts): the CVs it held before the current one, and when the last new one came (the "CV updated" mark)
  earlierCvs        JobApplicationEarlierCv[]
  cvUpdatedAt       DateTime?                 @map("cv_updated_at") @db.Timestamptz
  portfolioFile     JobApplicationPortfolio? // the PDF case study sent as a portfolio (25 October 2026)
  cvReading         CvReading? // its CV read and analysed (22 October 2026)
  steps             JobApplicationStep[]
  offers            JobOffer[]
  interviews        Interview[]
  onboarding        OnboardingChecklist[]
  comments          ScreeningComment[] // the screening comments on it (24 October 2026)
  // Suggested From Earlier CVs (24 October 2026): the suggestions it was the earlier CV of, and those it closed (added, applied)
  suggestedFrom     VacancySuggestion[]       @relation("VacancySuggestionSource")
  suggestionsMet    VacancySuggestion[]       @relation("VacancySuggestionApplication")
  openFits          CvOpenFit[] // its CV's fits for the other open vacancies (25 October 2026)
  // WhatsApp (owner, 24 October 2026: candidates "who tick it on the careers form"): when they ticked "Send me updates
  // about my application on WhatsApp" (none: no opt-in; HR's own Add a CV never asks), the language of the page, and
  // when they replied STOP; the messages sent about it
  whatsappOptInAt   DateTime?                 @map("whatsapp_opt_in_at") @db.Timestamptz
  whatsappLanguage  String?                   @map("whatsapp_language") // WHATSAPP_LANGUAGES
  whatsappStoppedAt DateTime?                 @map("whatsapp_stopped_at") @db.Timestamptz
  whatsAppMessages  WhatsAppMessage[]

  @@unique([vacancyId, email])
  @@index([stage])
  @@index([ip, createdAt])
  @@index([candidateId])
  @@index([vacancyId, candidateId])
  @@map("job_applications")
}

// An application's CV, apart so the lists never read it: a PDF or a Word file, at most 5 MB, its type told by its first
// bytes, its name cleaned.
model JobApplicationCv {
  applicationId String         @id @map("application_id") @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String         @map("file_name")
  mimeType      String         @map("mime_type")
  sizeBytes     Int            @map("size_bytes")
  data          Bytes
  // the file's SHA-256 (candidate profiles, 22 October 2026: "the same CV file" suggests a match): worked out by the
  // database itself (a generated column), never written
  sha256        String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  preview       CvPreview? // a Word CV as a PDF for the CV window, kept (24 October 2026)

  @@map("job_application_cvs")
}

// An application's earlier CV (owner, 25 October 2026: "if an employee updated the cv and reapplied, how will he be treated
// in the system?"; asked, "Update their application"; packages/shared reapply.ts): the CV it held until the person applied
// again with a new one, kept as it was (apart, so the lists never read it), with when it was sent, when the new one
// replaced it and the address that new one came from (counted in the careers page's hourly limits). Deleted with its
// application; never a developer's file.
model JobApplicationEarlierCv {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String         @map("file_name")
  mimeType      String         @map("mime_type")
  sizeBytes     Int            @map("size_bytes")
  data          Bytes
  sentAt        DateTime       @map("sent_at") @db.Timestamptz
  replacedAt    DateTime       @default(now()) @map("replaced_at") @db.Timestamptz
  ip            String?

  @@index([applicationId, sentAt])
  @@index([ip, replacedAt])
  @@index([replacedAt])
  @@map("job_application_earlier_cvs")
}

// An application's PDF case study (owner, 25 October 2026: "for creatives, they need to add their portfolios"; a position
// that takes "PDF case study (upload)"), kept as its CV is: apart, so the lists never read it; a PDF, at most 5 MB.
model JobApplicationPortfolio {
  applicationId String         @id @map("application_id") @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileName      String         @map("file_name")
  mimeType      String         @map("mime_type")
  sizeBytes     Int            @map("size_bytes")
  data          Bytes
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@map("job_application_portfolios")
}

// What happened to an application, in order (APPLICATION_EVENTS): applied, filtered out, shortlisted, moved to interview,
// a job offer drafted, hired, rejected, restored, an offer declined or withdrawn; the stage after it, a note, who (none:
// the applicant or the system) and when. Ready for Phase 2's pipeline and analytics (time to hire, the funnel).
model JobApplicationStep {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  event         String
  stage         String
  note          String?
  byId          String?        @map("by_id") @db.Uuid
  by            User?          @relation(fields: [byId], references: [id], onDelete: SetNull)
  at            DateTime       @default(now()) @db.Timestamptz

  @@index([applicationId, at])
  @@map("job_application_steps")
}

// A general CV (owner, 22 October 2026: "what came out of the posted jobs and what cam on randomly"; "Both"; packages/
// shared general-cvs.ts): someone who sent a CV without applying for a posted vacancy ("Send us your CV" on the careers
// page), or whose CV HR added (email, WhatsApp, LinkedIn, in person, referral, other; a referral with who referred
// them). The area they would like to work in (a department, or Other in words), the consent (theirs, or HR's with who
// and why), a reference in the applications' series. New, reviewed, moved to a vacancy (the application made from it),
// archived. HR, the CEO and a Super Admin read them; HR and a Super Admin change them.
model GeneralCv {
  id                String              @id @default(uuid()) @db.Uuid
  number            String              @unique // APP-2026-0007: the applications' series
  status            String              @default("new") // GENERAL_CV_STATUSES
  fullName          String              @map("full_name")
  email             String // trimmed, in lower case
  mobile            String
  linkedin          String?
  portfolio         String? // the first of portfolioLinks, for older code and pages
  // every portfolio link and "Confirmed by LinkedIn", as an application's (25 October 2026)
  portfolioLinks    String[]            @default([]) @map("portfolio_links")
  emailConfirmedBy  String?             @map("email_confirmed_by")
  yearsExperience   Decimal?            @map("years_experience") @db.Decimal(4, 1)
  noticePeriod      String?             @map("notice_period")
  expectedSalary    Decimal?            @map("expected_salary") @db.Decimal(12, 2)
  departmentId      String?             @map("department_id") @db.Uuid // its team: the position's, or the area of interest of before; none: Other
  department        Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  areaOther         String?             @map("area_other") // an older CV's area in words (Other)
  // the position they would like (owner, 25 October 2026: "Position, grouped by team"; packages/shared cv-positions.ts):
  // its key and its name as shown when chosen, or what they wrote for Other; none on an older CV, sent for an area
  positionKey       String?             @map("position_key")
  positionName      String?             @map("position_name")
  positionOther     String?             @map("position_other")
  source            String // GENERAL_CV_SOURCES
  referrer          String?
  notes             String? // HR's
  consentAt         DateTime            @map("consent_at") @db.Timestamptz
  consentById       String?             @map("consent_by") @db.Uuid // HR who recorded the person's agreement; none: theirs on the careers page
  consentBy         User?               @relation("GeneralCvConsent", fields: [consentById], references: [id], onDelete: SetNull)
  consentNote       String?             @map("consent_note")
  ip                String?
  userAgent         String?             @map("user_agent")
  createdById       String?             @map("created_by") @db.Uuid // HR who added it; none: sent on the careers page
  createdBy         User?               @relation("GeneralCvCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  applicationId     String?             @unique @map("application_id") @db.Uuid // moved: the application made from it
  application       JobApplication?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  movedAt           DateTime?           @map("moved_at") @db.Timestamptz
  // the candidate's profile (22 October 2026), as an application's: the 30 days between CVs count by it
  candidateId       String?             @map("candidate_id") @db.Uuid
  candidate         Candidate?          @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  file              GeneralCvFile?
  portfolioFile     GeneralCvPortfolio? // the PDF case study sent as a portfolio (25 October 2026)
  cvReading         CvReading? // its CV read and analysed (22 October 2026)
  events            GeneralCvEvent[]
  comments          ScreeningComment[] // the screening comments on it (24 October 2026)
  suggestions       VacancySuggestion[] // the vacancies it was suggested for (24 October 2026)
  openFits          CvOpenFit[] // its CV's fits for the open vacancies (25 October 2026)
  // WhatsApp (24 October 2026), as an application's: the tick on "Send us your CV", its page's language, a STOP reply
  whatsappOptInAt   DateTime?           @map("whatsapp_opt_in_at") @db.Timestamptz
  whatsappLanguage  String?             @map("whatsapp_language")
  whatsappStoppedAt DateTime?           @map("whatsapp_stopped_at") @db.Timestamptz
  whatsAppMessages  WhatsAppMessage[]

  @@index([email, createdAt])
  @@index([status])
  @@index([ip, createdAt])
  @@index([candidateId, createdAt])
  @@index([positionKey])
  @@map("general_cvs")
}

// A general CV's file, apart so the lists never read it: a PDF or a Word file, at most 5 MB, as an application's.
model GeneralCvFile {
  generalCvId String     @id @map("general_cv_id") @db.Uuid
  generalCv   GeneralCv  @relation(fields: [generalCvId], references: [id], onDelete: Cascade)
  fileName    String     @map("file_name")
  mimeType    String     @map("mime_type")
  sizeBytes   Int        @map("size_bytes")
  data        Bytes
  // the file's SHA-256 (22 October 2026), as an application's CV's: a generated column, never written
  sha256      String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  preview     CvPreview? // a Word CV as a PDF for the CV window, kept (24 October 2026)

  @@map("general_cv_files")
}

// A general CV's PDF case study (25 October 2026), as an application's.
model GeneralCvPortfolio {
  generalCvId String    @id @map("general_cv_id") @db.Uuid
  generalCv   GeneralCv @relation(fields: [generalCvId], references: [id], onDelete: Cascade)
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  data        Bytes
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("general_cv_portfolios")
}

// What happened to a general CV, in order: received, reviewed, archived, restored, moved; a note, who (none: the person
// on the careers page) and when.
model GeneralCvEvent {
  id          String    @id @default(uuid()) @db.Uuid
  generalCvId String    @map("general_cv_id") @db.Uuid
  generalCv   GeneralCv @relation(fields: [generalCvId], references: [id], onDelete: Cascade)
  event       String
  note        String?
  byId        String?   @map("by_id") @db.Uuid
  by          User?     @relation(fields: [byId], references: [id], onDelete: SetNull)
  at          DateTime  @default(now()) @db.Timestamptz

  @@index([generalCvId, at])
  @@map("general_cv_events")
}

// A CV of a bulk upload (owner, 22 October 2026: "is there a way to easy apply from linkedin?" … "why not"), waiting for
// HR to check its row: for a vacancy (none: the general CVs), its file, whether its text could be read and what it told
// (the name, email and mobile). The uploader's own; gone once saved or discarded, or after a day.
model CvUpload {
  id          String     @id @default(uuid()) @db.Uuid
  createdById String     @map("created_by") @db.Uuid
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  vacancyId   String?    @map("vacancy_id") @db.Uuid
  vacancy     Vacancy?   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  fileName    String     @map("file_name")
  mimeType    String     @map("mime_type")
  sizeBytes   Int        @map("size_bytes")
  data        Bytes
  textFound   Boolean    @default(false) @map("text_found")
  guess       Json       @default("{}")
  cvReading   CvReading? // a scanned CV read by OCR, its row filled in from it (22 October 2026)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdById, createdAt])
  @@map("cv_uploads")
}

// A CV read and analysed (owner, 22 October 2026: "make the OCR egine reads the CV and analyse it", "Built-in rules
// only"): one row for each CV (an application's, a general CV's or a bulk upload's: exactly one of the three), read in
// the background (CvReadingsService): a PDF's own text, else the OCR service for a scan; a Word file's paragraphs. Its
// status (pending, read, no_text, failed), the text (at most 60,000 characters), how it was read (pdf, docx, ocr_en,
// ocr_ar), what the rules found in it (packages/shared cv-analysis.ts cvFacts: contacts, years, education, languages),
// and the tries (3 at most, each later). Deleted with its CV.
model CvReading {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String?         @unique @map("application_id") @db.Uuid
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  generalCvId   String?         @unique @map("general_cv_id") @db.Uuid
  generalCv     GeneralCv?      @relation(fields: [generalCvId], references: [id], onDelete: Cascade)
  uploadId      String?         @unique @map("upload_id") @db.Uuid
  upload        CvUpload?       @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  status        String          @default("pending") // CV_READING_STATUSES: pending, read, no_text, failed
  method        String? // pdf, docx, ocr_en, ocr_ar
  text          String?
  facts         Json? // CvFacts
  attempts      Int             @default(0)
  nextTryAt     DateTime        @default(now()) @map("next_try_at") @db.Timestamptz
  error         String?
  // read as a scan by the OCR service whatever its own text (29 October 2026: HR's "Read as a scan"); cleared once read
  forceOcr      Boolean         @default(false) @map("force_ocr")
  readAt        DateTime?       @map("read_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, nextTryAt])
  @@map("cv_readings")
}

// ---------- candidate profiles ----------
// The owner, 22 October 2026: "how to make like a profile for each candidate to store history and prevent duplication?
// even if the same candidate applied for 2 jobs"; asked, "Email or mobile" (the same email, or the same mobile with its
// country code, joins a profile by itself; HR merges what slips through and splits a wrong match) and "Link and show
// rehire" (a former employee who applies is linked to their employee record); then "and their is a possible match from
// other fields, HR decides from suggested match". The rules: packages/shared candidates.ts; the matching:
// apps/api/src/recruitment/candidate-links.ts.

// A candidate: one person, CAN-0001 in its own series, with the latest name and links they sent, the employee they are
// (matched by email or mobile, or hired from an accepted offer), when they last applied, and the profile it was merged
// into (kept, never deleted, so a merge can be undone).
model Candidate {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique // CAN-0001
  fullName          String              @map("full_name") // the latest they sent
  linkedin          String?
  portfolio         String?
  employeeId        String?             @map("employee_id") @db.Uuid
  employee          Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  mergedIntoId      String?             @map("merged_into_id") @db.Uuid
  mergedInto        Candidate?          @relation("CandidateMerged", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom        Candidate[]         @relation("CandidateMerged")
  mergedAt          DateTime?           @map("merged_at") @db.Timestamptz
  lastAppliedAt     DateTime?           @map("last_applied_at") @db.Timestamptz // their newest application or general CV
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  contacts          CandidateContact[]
  keys              CandidateKey[]
  applications      JobApplication[]
  generalCvs        GeneralCv[]
  matchesA          CandidateMatch[]    @relation("CandidateMatchA")
  matchesB          CandidateMatch[]    @relation("CandidateMatchB")
  mergesKept        CandidateMerge[]    @relation("CandidateMergeKept")
  mergesMerged      CandidateMerge[]    @relation("CandidateMergeMerged")
  comments          ScreeningComment[] // the screening comments about them (24 October 2026)
  suggestions       VacancySuggestion[] // the vacancies they were suggested for (24 October 2026)
  // WhatsApp (24 October 2026): when they last ticked it on a careers form, and when they replied STOP; the messages
  whatsappOptInAt   DateTime?           @map("whatsapp_opt_in_at") @db.Timestamptz
  whatsappStoppedAt DateTime?           @map("whatsapp_stopped_at") @db.Timestamptz
  whatsAppMessages  WhatsAppMessage[]

  @@index([mergedIntoId])
  @@index([employeeId])
  @@index([lastAppliedAt])
  @@map("candidates")
}

// An email or a mobile of a candidate's, as compared: the email trimmed and in lower case, the mobile as the system keeps
// phones (+201012345678). One email or mobile belongs to one candidate (the unique below), so the same one joins them.
// When it was first and last seen on an application or a general CV.
model CandidateContact {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @map("candidate_id") @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        String // email, mobile
  value       String
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz

  @@unique([kind, value])
  @@index([candidateId])
  @@map("candidate_contacts")
}

// What a candidate is compared by for the suggested matches (CANDIDATE_KEY_KINDS: the emails and mobiles, the LinkedIn
// and portfolio links normalized, the CV files' SHA-256, the name normalized, the contacts read from the CVs …), worked
// out again from their applications, general CVs and CV readings whenever they change; never shown.
model CandidateKey {
  candidateId String    @map("candidate_id") @db.Uuid
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  kind        String
  value       String

  @@id([candidateId, kind, value])
  @@index([value])
  @@map("candidate_keys")
}

// Two candidates who may be one person (the smaller id first): a possible duplicate (the same email or mobile on both)
// or a suggestion from the other signs, with the signs (MATCH_SIGNALS) and their score. Open until HR merges them, or
// dismisses the pair ("Not the same person"): a dismissed pair is never suggested again.
model CandidateMatch {
  id           String    @id @default(uuid()) @db.Uuid
  candidateAId String    @map("candidate_a_id") @db.Uuid
  candidateA   Candidate @relation("CandidateMatchA", fields: [candidateAId], references: [id], onDelete: Cascade)
  candidateBId String    @map("candidate_b_id") @db.Uuid
  candidateB   Candidate @relation("CandidateMatchB", fields: [candidateBId], references: [id], onDelete: Cascade)
  kind         String // duplicate, suggested
  signals      String[]  @default([])
  score        Int       @default(0)
  status       String    @default("open") // open, dismissed, merged
  decidedById  String?   @map("decided_by") @db.Uuid
  decidedBy    User?     @relation("CandidateMatchDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([candidateAId, candidateBId])
  @@index([candidateBId])
  @@index([status])
  @@map("candidate_matches")
}

// A merge (HR's "Merge with…", or a suggestion confirmed): the candidate kept, the one merged into it, and what moved
// (the applications, general CVs, contacts, the employee link, the links, the dismissed pairs carried over), so a Super
// Admin can undo it.
model CandidateMerge {
  id         String    @id @default(uuid()) @db.Uuid
  keptId     String    @map("kept_id") @db.Uuid
  kept       Candidate @relation("CandidateMergeKept", fields: [keptId], references: [id], onDelete: Cascade)
  mergedId   String    @map("merged_id") @db.Uuid
  merged     Candidate @relation("CandidateMergeMerged", fields: [mergedId], references: [id], onDelete: Cascade)
  moved      Json
  byId       String?   @map("by_id") @db.Uuid
  by         User?     @relation("CandidateMergeBy", fields: [byId], references: [id], onDelete: SetNull)
  at         DateTime  @default(now()) @db.Timestamptz
  undoneAt   DateTime? @map("undone_at") @db.Timestamptz
  undoneById String?   @map("undone_by") @db.Uuid
  undoneBy   User?     @relation("CandidateMergeUndo", fields: [undoneById], references: [id], onDelete: SetNull)

  @@index([keptId, at])
  @@index([mergedId])
  @@map("candidate_merges")
}

// A screening comment (owner, 24 October 2026: "is there a way to add screening comments?", "and i can add genearrl
// comments"; asked, "Yes: Good fit / Maybe / Not a fit" and "HR + hiring manager & interviewers"; packages/shared
// screening.ts): about a candidate always; about one of their applications or general CVs, or neither (a general
// comment). Its author (none: HR's earlier notes, named by authorLabel, or an account since removed) and their role then,
// the text (at most 2,000 characters), an optional verdict, the accounts mentioned, when written and last edited (the
// author edits it for 24 hours; only a Super Admin deletes it). fromNotes: HR's notes box of before, moved in once.
// Moves with its record when candidates are merged or split.
model ScreeningComment {
  id            String          @id @default(uuid()) @db.Uuid
  candidateId   String          @map("candidate_id") @db.Uuid
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?         @map("application_id") @db.Uuid
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  generalCvId   String?         @map("general_cv_id") @db.Uuid
  generalCv     GeneralCv?      @relation(fields: [generalCvId], references: [id], onDelete: Cascade)
  authorId      String?         @map("author_id") @db.Uuid
  author        User?           @relation("ScreeningCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorLabel   String?         @map("author_label") // "HR (earlier notes)"
  authorRole    String?         @map("author_role") // SCREENING_AUTHOR_ROLES
  text          String
  verdict       String? // SCREENING_VERDICTS
  mentions      String[]        @default([]) @db.Uuid // the accounts mentioned
  fromNotes     Boolean         @default(false) @map("from_notes")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  editedAt      DateTime?       @map("edited_at") @db.Timestamptz

  @@index([candidateId, createdAt])
  @@index([applicationId, createdAt])
  @@index([generalCvId, createdAt])
  @@index([authorId])
  @@map("screening_comments")
}

// A Word CV as a PDF for the CV window (24 October 2026: "when opening a CV, open it in a popup window"), kept because the
// converter is slow: an application's CV or a general CV's file, with the SHA-256 of the Word file it was made from.
model CvPreview {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String?           @unique @map("application_id") @db.Uuid
  applicationCv JobApplicationCv? @relation(fields: [applicationId], references: [applicationId], onDelete: Cascade)
  generalCvId   String?           @unique @map("general_cv_id") @db.Uuid
  generalCvFile GeneralCvFile?    @relation(fields: [generalCvId], references: [generalCvId], onDelete: Cascade)
  sha256        String
  data          Bytes
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@map("cv_previews")
}

// An interview (Phase 2, owner, 22 October 2026: "interview invites go by email through the owner's SMTP settings"):
// scheduled from an applicant, when (in Cairo, kept as a moment), how long, in person (the office's address unless
// another is given), online (its link) or by phone, a note to the candidate. Each change raises its sequence (the
// calendar invitation's SEQUENCE, so a calendar moves or removes the same event). Scheduled, then done or a no-show, or
// cancelled. The candidate's latest email about it, or why none went.
model Interview {
  id                  String                 @id @default(uuid()) @db.Uuid
  applicationId       String                 @map("application_id") @db.Uuid
  application         JobApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  startsAt            DateTime               @map("starts_at") @db.Timestamptz
  minutes             Int
  kind                String // INTERVIEW_KINDS: in_person, online, phone
  location            String?
  note                String?
  status              String                 @default("scheduled") // INTERVIEW_STATUSES
  sequence            Int                    @default(0)
  emailedAt           DateTime?              @map("emailed_at") @db.Timestamptz
  emailProblem        String?                @map("email_problem")
  cancelReason        String?                @map("cancel_reason")
  cancelledAt         DateTime?              @map("cancelled_at") @db.Timestamptz
  outcomeAt           DateTime?              @map("outcome_at") @db.Timestamptz
  outcomeById         String?                @map("outcome_by") @db.Uuid
  outcomeBy           User?                  @relation("InterviewOutcome", fields: [outcomeById], references: [id], onDelete: SetNull)
  createdById         String?                @map("created_by") @db.Uuid
  createdBy           User?                  @relation("InterviewCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedById         String?                @map("updated_by") @db.Uuid
  updatedBy           User?                  @relation("InterviewChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  // the meeting the system made for an online one (24 October 2026: Google Meet, Microsoft Teams or Zoom), its link the
  // location: its provider, the connection it was made with (kept to move and delete it), its id there and the mailbox or
  // user it lives in; what the provider refused, in words
  meetingProvider     String?                @map("meeting_provider") // MEETING_PROVIDERS
  meetingConnectionId String?                @map("meeting_connection_id") @db.Uuid
  meetingConnection   MeetingConnection?     @relation(fields: [meetingConnectionId], references: [id], onDelete: SetNull)
  meetingId           String?                @map("meeting_id")
  meetingHost         String?                @map("meeting_host")
  meetingProblem      String?                @map("meeting_problem")
  // WhatsApp (24 October 2026): the candidate's reminder the day before, once (cleared when it moves)
  whatsappRemindedAt  DateTime?              @map("whatsapp_reminded_at") @db.Timestamptz
  whatsAppMessages    WhatsAppMessage[]
  interviewers        InterviewInterviewer[]
  feedback            InterviewFeedback[]

  @@index([applicationId])
  @@index([status, startsAt])
  @@index([meetingConnectionId])
  @@map("interviews")
}

// An interviewer on an interview (a current employee when chosen), and when they were reminded of their scorecard (the
// day after the interview, once).
model InterviewInterviewer {
  interviewId String    @map("interview_id") @db.Uuid
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employeeId  String    @map("employee_id") @db.Uuid
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  remindedAt  DateTime? @map("reminded_at") @db.Timestamptz

  @@id([interviewId, employeeId])
  @@index([employeeId])
  @@map("interview_interviewers")
}

// An interviewer's scorecard of an interview, one each (changed by them afterwards): four ratings from 1 to 5, a
// recommendation, notes. An interviewer sees the others' on the applicant only once they gave theirs.
model InterviewFeedback {
  id                  String    @id @default(uuid()) @db.Uuid
  interviewId         String    @map("interview_id") @db.Uuid
  interview           Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employeeId          String    @map("employee_id") @db.Uuid
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  ratingSkills        Int       @map("rating_skills")
  ratingExperience    Int       @map("rating_experience")
  ratingCommunication Int       @map("rating_communication")
  ratingCulture       Int       @map("rating_culture")
  recommendation      String // RECOMMENDATIONS
  notes               String?
  submittedAt         DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([interviewId, employeeId])
  @@map("interview_feedback")
}

// Recruitment's settings (one row, id 1; Phase 2): the rejection email's subject and words, English and Arabic, as HR
// wrote them; none: the standard (packages/shared recruitment-hiring.ts REJECTION_STANDARD). Since 24 October 2026
// (Suggested From Earlier CVs, packages/shared suggested-cvs.ts): how far back CVs count, in months, and the invitation
// to apply's subject and words (none: INVITE_STANDARD). Since 25 October 2026 (owner: "allow the HR to add for now job
// offers with a past duedate to enter the previous data"): the switch "Entering earlier offers", on for now (also with no
// row), HR's and a Super Admin's to change. And since then too: the careers site's address (none: the standard,
// https://www.trendlix.com/en/careers).
model RecruitmentSettings {
  id               Int      @id @default(1)
  rejectionSubject String?  @map("rejection_subject")
  rejectionEn      String?  @map("rejection_en")
  rejectionAr      String?  @map("rejection_ar")
  suggestMonths    Int      @default(12) @map("suggest_months")
  inviteSubject    String?  @map("invite_subject")
  inviteEn         String?  @map("invite_en")
  inviteAr         String?  @map("invite_ar")
  earlierOffers    Boolean  @default(true) @map("earlier_offers")
  // the careers site's address (owner, 25 October 2026: the careers pages moved to www.trendlix.com/en/careers): every
  // public careers link is built on it; null, the standard (packages/shared careers-base.ts)
  careersSite      String?  @map("careers_site")
  updatedById      String?  @map("updated_by") @db.Uuid
  updatedBy        User?    @relation("RecruitmentSettingsChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("recruitment_settings")
}

// What HR chose for a position on "Send us your CV" (owner, 25 October 2026: "Position, grouped by team"; Recruitment
// Settings' "Positions on the CV Form"; packages/shared cv-positions.ts), by its key (its team's id and its merged name):
// hidden from the careers page, and a public name. No row: shown, by its own name (a new job title's position too).
model CvPositionChoice {
  key         String   @id // "<team id>:video editor"
  hidden      Boolean  @default(false)
  publicName  String?  @map("public_name")
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("CvPositionChoiceChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("cv_position_choices")
}

// What HR set for a job title's portfolio on the careers forms (owner, 25 October 2026: "Portfolio per position";
// Recruitment Settings' "Portfolio on the Forms"; packages/shared portfolio.ts): Hidden, Optional or Required, a hint, the
// kinds taken (PORTFOLIO_KINDS) and how many links (1 to 3). No row: the default by the rule (portfolioDefaultFor).
model PortfolioSetting {
  jobTitleId  String   @id @map("job_title_id") @db.Uuid
  jobTitle    JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
  mode        String // PORTFOLIO_MODES
  // the section title, the portfolio part's heading ("Your showreel", at most 40; 26 October 2026); none: the rule's
  title       String?
  hint        String?
  kinds       String[] @default([])
  maxLinks    Int      @default(3) @map("max_links")
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("PortfolioSettingChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("portfolio_settings")
}

// "Fill in with LinkedIn" on the careers forms (one row, id 1; owner, 25 October 2026: "can i use linkedin to complete
// the data?"; Recruitment Settings' "LinkedIn Sign-in", a Super Admin's; packages/shared linkedin-signin.ts): on or off,
// the LinkedIn app's client ID and its secret, sealed (apps/api/src/recruitment/linkedin-secret.ts), never returned, with
// the fingerprint of the key that sealed it.
model LinkedInSettings {
  id              Int      @id @default(1)
  enabled         Boolean  @default(false)
  clientId        String?  @map("client_id")
  clientSecretEnc String?  @map("client_secret_enc")
  secretKeyId     String?  @map("secret_key_id")
  updatedById     String?  @map("updated_by") @db.Uuid
  updatedBy       User?    @relation("LinkedInSettingsChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("linkedin_settings")
}

// An earlier CV suggested for an open vacancy (owner, 24 October 2026: "does the system automatically add recomended
// general cv's to the opened posts?"; asked, "Suggest; HR adds", "General CVs + past applicants", "Yes, HR presses
// 'Invite to apply'"; packages/shared suggested-cvs.ts): one a candidate a vacancy, from their best earlier CV (a general
// CV, or an application to another job), with its score and reasons as worked out last. Suggested, then HR adds them (the
// application made), invites them (the email's address and when), or dismisses them (an optional reason); applied once
// they are on the vacancy otherwise. Decided ones stay, so a dismissed one never comes back; a suggested one no longer
// matching is deleted when worked out again. `notifiedAt`: HR told of it (once a batch).
model VacancySuggestion {
  id                  String          @id @default(uuid()) @db.Uuid
  vacancyId           String          @map("vacancy_id") @db.Uuid
  vacancy             Vacancy         @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  candidateId         String          @map("candidate_id") @db.Uuid
  candidate           Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sourceKind          String          @map("source_kind") // general_cv, application
  generalCvId         String?         @map("general_cv_id") @db.Uuid
  generalCv           GeneralCv?      @relation(fields: [generalCvId], references: [id], onDelete: SetNull)
  sourceApplicationId String?         @map("source_application_id") @db.Uuid
  sourceApplication   JobApplication? @relation("VacancySuggestionSource", fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  score               Int
  reasons             Json            @default("[]") // SuggestionReason[]
  status              String          @default("suggested") // SUGGESTION_STATUSES
  invitedAt           DateTime?       @map("invited_at") @db.Timestamptz
  invitedTo           String?         @map("invited_to") // the address the invitation went to
  dismissReason       String?         @map("dismiss_reason")
  applicationId       String?         @map("application_id") @db.Uuid // the application it led to: added, or applied
  application         JobApplication? @relation("VacancySuggestionApplication", fields: [applicationId], references: [id], onDelete: SetNull)
  decidedById         String?         @map("decided_by") @db.Uuid
  decidedBy           User?           @relation("VacancySuggestionDecision", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt           DateTime?       @map("decided_at") @db.Timestamptz
  notifiedAt          DateTime?       @map("notified_at") @db.Timestamptz
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([vacancyId, candidateId])
  @@index([vacancyId, status])
  @@index([candidateId])
  @@index([generalCvId])
  @@index([sourceApplicationId])
  @@index([applicationId])
  @@map("vacancy_suggestions")
}

// An earlier CV's fit for an open vacancy (owner, 25 October 2026: "and if it recomended to another position based on
// the CV"; packages/shared cv-fit.ts, suggested-cvs.ts openFitsFor): the person's side of Suggested From Earlier CVs, one
// a CV (an application, or a general CV) a vacancy, kept when 50% or more, worked out with the vacancy's suggestions.
// Read for an applicant's "Better fit" badge, the CV window's and the candidate's Other Open Positions and the General
// CVs' "Best open position", each time with the vacancy still open and the person not on it nor decided there.
model CvOpenFit {
  id            String          @id @default(uuid()) @db.Uuid
  vacancyId     String          @map("vacancy_id") @db.Uuid
  vacancy       Vacancy         @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  applicationId String?         @map("application_id") @db.Uuid
  application   JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  generalCvId   String?         @map("general_cv_id") @db.Uuid
  generalCv     GeneralCv?      @relation(fields: [generalCvId], references: [id], onDelete: Cascade)
  percent       Int
  fit           Json
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([vacancyId, applicationId])
  @@unique([vacancyId, generalCvId])
  @@index([applicationId])
  @@index([generalCvId])
  @@map("cv_open_fits")
}

// HR's default onboarding items (Phase 2, 22 October 2026; packages/shared onboarding.ts), in order, each with the role
// that clears it, copied into each checklist when it opens; one taken off is kept, switched off.
model OnboardingDefault {
  id          String   @id @default(uuid()) @db.Uuid
  position    Int
  label       String
  owner       String // CLEARANCE_OWNERS: hr, manager, admin, finance, assets
  active      Boolean  @default(true)
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("OnboardingDefaultChange", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([active, position])
  @@map("onboarding_defaults")
}

// An employment's onboarding checklist, one at most: opened when an applicant is hired through an accepted job offer
// (with the application), or by HR; completed once every item is cleared.
model OnboardingChecklist {
  id            String           @id @default(uuid()) @db.Uuid
  employmentId  String           @unique @map("employment_id") @db.Uuid
  employment    Employment       @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  applicationId String?          @map("application_id") @db.Uuid
  application   JobApplication?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  status        String           @default("open") // ONBOARDING_STATUSES
  openedById    String?          @map("opened_by") @db.Uuid // none: opened by the system
  openedBy      User?            @relation("OnboardingOpening", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt      DateTime         @default(now()) @map("opened_at") @db.Timestamptz
  completedById String?          @map("completed_by") @db.Uuid
  completedBy   User?            @relation("OnboardingCompletion", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt   DateTime?        @map("completed_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  items         OnboardingItem[]

  @@index([status])
  @@map("onboarding_checklists")
}

// An onboarding checklist's item, in order: cleared by its owner (manual), or ticked by the system (contract: its
// contract signed; kpi_template: the job title's KPI template published; assets: something in custody), read live
// while the checklist is open and kept when it is completed.
model OnboardingItem {
  id          String              @id @default(uuid()) @db.Uuid
  checklistId String              @map("checklist_id") @db.Uuid
  checklist   OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  position    Int
  kind        String              @default("manual") // ONBOARDING_KINDS
  label       String
  owner       String // CLEARANCE_OWNERS
  status      String              @default("pending") // CLEARANCE_ITEM_STATUSES
  doneById    String?             @map("done_by") @db.Uuid
  doneBy      User?               @relation("OnboardingItemDone", fields: [doneById], references: [id], onDelete: SetNull)
  doneAt      DateTime?           @map("done_at") @db.Timestamptz
  note        String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([checklistId, position])
  @@map("onboarding_items")
}

// ---------- payroll ----------
// Monthly payroll, phase 1 (owner's decisions, 16 October 2026): worked out the way the owner's payroll sheet does it,
// with its formula errors fixed (packages/shared payroll.ts). Built before attendance: HR types the month's hours and
// days on the run, and attendance will fill the same inputs later. HR prepares a run, the CEO approves it (the CEO
// only), then it is locked and HR marks it paid; salaries go by bank file (CIB's payroll system for CIB accounts, ACH
// for every other bank). Amounts are salary data: HR, Finance and the CEO only.

// The rules a run is worked out with and the company's side of the bank files (one row, id 1). Each run copies the
// rules when it is made and when it is refreshed, so a later change never alters a run already worked out.
model PayrollSettings {
  id                      Int      @id @default(1) // always 1
  dayDivisor              Int      @default(30) @map("day_divisor") // a month counts as this many days (day rates, part months)
  attendanceGracePercent  Decimal  @default(90) @map("attendance_grace_percent") @db.Decimal(5, 2) // attendance from here on counts as full
  kpiGracePercent         Decimal  @default(80) @map("kpi_grace_percent") @db.Decimal(5, 2) // a KPI average from here on counts as full
  payOvertime             Boolean  @default(false) @map("pay_overtime") // off from 16 October 2026 (owner: "No overtime for now")
  // on from 26 October 2026 (owner: "calculate as if the employee is insured, no matter he is registered or not"; "till i adjust my system dont connect them togeather")
  insureEveryone          Boolean  @default(true) @map("insure_everyone")
  overtimeAbovePercent    Decimal  @default(110) @map("overtime_above_percent") @db.Decimal(5, 2) // overtime is paid for attendance above this
  overtimeRate            Decimal  @default(1.5) @map("overtime_rate") @db.Decimal(4, 2)
  noShowDayMultiplier     Decimal  @default(2) @map("no_show_day_multiplier") @db.Decimal(4, 2) // a no-show day costs this many days' pay
  cibDebitAccount         String?  @map("cib_debit_account") // the company's CIB account the salaries are paid from: 12 digits
  cibDebitAccountName     String?  @map("cib_debit_account_name") // its name, as CIB has it
  achPurpose              String   @default("CASH") @map("ach_purpose") // the ACH file's TransactionPurpose
  payday                  Int? // the day of the month salaries are paid (1–31): the date a run is marked paid on, to start with
  salaryReviewMonths      Int      @default(12) @map("salary_review_months") // 1–60: the Salary Raises report's review is due this many months after the last raise or the join date
  // 1–10: the most a month's installments of advances and loans may take of the wage (Labour Law 14/2025 Art. 113: 10%;
  // owner, 18 October 2026, after reading the law: "Block above 10%"); set lower if the company wants, never higher.
  // Until then a warning at a share of the pay (1–100, none: no warning)
  installmentLimitPercent Decimal  @default(10) @map("installment_limit_percent") @db.Decimal(5, 2)
  // the office's addresses as Zoho People writes a check-in's location (owner, 19 October 2026: "13 and 17 al mahrouki
  // is also in office"): a check-in at one of them is a day at the office, anywhere else remote
  officeAddresses         String[] @default(["Trendlix", "13, Al Doctor Al Mahrouqi Street", "15, Al Doctor Al Mahrouqi Street", "17, Al Doctor Al Mahrouqi Street"]) @map("office_addresses")
  // the office's point and radius for checking in on the system (owner, 19 October 2026: "Check-in through the system
  // (phone or web with the office location check, or a device) to replace Zoho"). UNUSED since 20 October 2026 (owner:
  // "Own page, several locations"): check-ins read the locations of Attendance → Check-in Setup (CheckInLocation), the
  // migration check_in_locations copied this point into the first of them, "Office". Kept, unused, rather than dropped in
  // the same deploy; the API neither reads nor writes them any more
  officeLatitude          Decimal? @map("office_latitude") @db.Decimal(9, 6)
  officeLongitude         Decimal? @map("office_longitude") @db.Decimal(9, 6)
  officeRadiusMetres      Int      @default(150) @map("office_radius_metres")
  // check-ins locked to the office network (owner, 20 October 2026: "allow me to lock checkin's to wifi name or ip,
  // whatever is right"; Attendance → Check-in Setup): the office's public addresses, each { label, range } (an IPv4
  // address, an IPv4 range or an IPv6 range, packages/shared office-network.ts), and the switch "Lock check-ins to the
  // office network". In force only with the key the website signs the address with (WEB_KEY, deploy/web-key.sh)
  officeNetworks          Json     @default("[]") @map("office_networks")
  officeNetworkLock       Boolean  @default(false) @map("office_network_lock")
  // "Refuse check-ins and check-outs without a location" (owner, 20 October 2026: "i want a flag to restrict checkin and
  // out from unknown locations", then "Company switch + exceptions"): on the website a press without a reading is refused,
  // unless HR exempts the person or it comes from an office network the website signed
  refuseWithoutLocation   Boolean  @default(false) @map("refuse_without_location")
  // "Refuse Office staff's check-ins and check-outs outside the check-in locations" (owner, 24 October 2026: "Yes, add a
  // GPS lock too"): off to start with; a reading less accurate than gps_rough_metres (50 to 500, 200 to start with) is too
  // rough to tell (packages/shared gps-lock.ts)
  gpsLock                 Boolean  @default(false) @map("gps_lock")
  gpsRoughMetres          Int      @default(200) @map("gps_rough_metres")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payroll_settings")
}

// The places a check-in on the system counts as the office at (owner, 20 October 2026: "i cant find in the system where to
// add the eligable check in locations", then "Own page, several locations"): Attendance → Check-in Setup, HR and Admin.
// Within any one's radius a check-in is at the office, outside them all remote, no reading: unknown (packages/shared
// check-in.ts checkInPlace). The first, "Office", is the point Payroll Setup → Your Rules had (the migration copied it).
// The main office and its sub-locations (owner, 20 October 2026: "main office location is the hero and other locations
// are like sub locations. shown with their name and linked users"): one is the main (isMain), within which a check-in is
// Office; within any other, a sub-location, it is remote, kept with its name ("Remote - Studio"), and flagged for anyone
// not linked to it (packages/shared sub-locations.ts). At most one main, by a partial unique index (the migration's
// "check_in_locations_one_main"); the API keeps one while there are any.
model CheckInLocation {
  id             String                  @id @default(uuid()) @db.Uuid
  name           String
  latitude       Decimal                 @db.Decimal(9, 6)
  longitude      Decimal                 @db.Decimal(9, 6)
  radiusMetres   Int                     @default(150) @map("radius_metres") // 20 to 5,000
  isMain         Boolean                 @default(false) @map("is_main") // the main office; the oldest when sub-locations came (20 October 2026)
  people         CheckInLocationPerson[] // the people linked to it, while it is a sub-location
  // a client location (owner, 24 October 2026: "all employees if a customer location"): made by the CEO's approval of a
  // request (home_location_requests.location_id), everyone's, never the main office nor linked to people; it lasts until
  // valid_until (none: no end) unless HR ends it (ended_at); the notice 7 days before its end told on ending_notice_on
  kind           String                  @default("office") // office (the main office and the sub-locations), client
  validUntil     DateTime?               @map("valid_until") @db.Date
  endedAt        DateTime?               @map("ended_at") @db.Timestamptz
  endingNoticeOn DateTime?               @map("ending_notice_on") @db.Date
  requests       HomeLocationRequest[]   @relation("HomeLocationCompanyPlace")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  @@map("check_in_locations")
}

// A person linked to a sub-location (owner, 20 October 2026: "shown with their name and linked users", "own sublocation
// shows the sub location name"): their own check-in place, where they aren't flagged, and where a locked Office person may
// check in off the office network. Linked and unlinked by HR and Admin, each in the audit log; a C-level person only by
// those who see them. Links to the main office don't count while it is the main (kept, so they count again if it is a
// sub-location again).
model CheckInLocationPerson {
  locationId String          @map("location_id") @db.Uuid
  location   CheckInLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employeeId String          @map("employee_id") @db.Uuid
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@id([locationId, employeeId])
  @@index([employeeId])
  @@map("check_in_location_people")
}

// The year's official holidays (owner's request, 16 October 2026, Payroll Setup): one day each, a holiday of several
// days a row per day. A holiday on one of a shift's working days takes that day's hours out of the expected hours a
// run works out; runs made or refreshed afterwards count it, an approved run keeps what it was worked out with.
model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @unique @db.Date
  nameEn    String   @map("name_en")
  nameAr    String?  @map("name_ar")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("holidays")
}

// One month's payroll: a run per month. Its lines are worked out again whenever their inputs change while it is a
// draft; once the CEO approves it nothing changes but its being marked paid.
model PayrollRun {
  id                String             @id @default(uuid()) @db.Uuid
  month             DateTime           @unique @db.Date // the month's first day
  status            String             @default("draft") // PAYROLL_STATUSES: draft, pending_ceo, approved, paid
  rules             Json // the PayrollRules it is worked out with: the settings', copied when made and when refreshed
  // the LawRates it is worked out with: the year's rates set by law, copied when made and when refreshed; null on runs made
  // before 17 October 2026, which were worked out with the built-in rates (the same as the rows the law rates migration added)
  lawRates          Json?              @map("law_rates")
  exclusions        Json               @default("[]") // the people left out when made or refreshed, and why: [{ employeeId, employeeCode, name, reason }]
  createdById       String?            @map("created_by") @db.Uuid
  createdBy         User?              @relation("PayrollCreation", fields: [createdById], references: [id], onDelete: SetNull)
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz // sent to the CEO, last
  approvedById      String?            @map("approved_by") @db.Uuid
  approvedBy        User?              @relation("PayrollApproval", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?          @map("approved_at") @db.Timestamptz
  returnedReason    String?            @map("returned_reason") // why the CEO sent it back to HR, until it is sent again
  paidOn            DateTime?          @map("paid_on") @db.Date
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  lines             PayrollLine[]
  attendanceImports AttendanceImport[] // the attendance files read on it (Zoho People, 19 October 2026)

  @@map("payroll_runs")
}

// One employee's pay in a run: what it is worked out from (the contract in force and the profile, as they were when
// the run was made or last refreshed), the month's inputs HR typed, and the result step by step, with its totals in
// columns of their own for sums. RESTRICTED (HR, Finance, CEO), like the salary. The bank details are copied when the
// CEO approves the run, so the bank files pay what was approved: RESTRICTED like EmployeeBank.
model PayrollLine {
  id                String              @id @default(uuid()) @db.Uuid
  runId             String              @map("run_id") @db.Uuid
  run               PayrollRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  // kept while any run has the person: their pay stays on record
  employeeId        String              @map("employee_id") @db.Uuid
  employee          Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employmentId      String              @map("employment_id") @db.Uuid
  employment        Employment          @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  contractId        String              @map("contract_id") @db.Uuid
  contract          Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  // as they were when the run was made or refreshed
  employeeCode      String              @map("employee_code")
  nameEn            String              @map("name_en")
  department        String? // a team as "Department › Team"
  jobTitle          String?             @map("job_title")
  employmentType    EmploymentType      @map("employment_type")
  payBasis          String              @map("pay_basis") // PAY_BASES
  terms             Json // PayrollTerms
  inputs            Json // PayrollInputs
  result            Json // PayrollResult
  // the result's totals, for sums across lines and runs
  earned            Decimal             @db.Decimal(12, 2)
  allowances        Decimal             @db.Decimal(12, 2)
  employeeInsurance Decimal             @map("employee_insurance") @db.Decimal(12, 2)
  employerInsurance Decimal             @map("employer_insurance") @db.Decimal(12, 2)
  monthlyTax        Decimal             @map("monthly_tax") @db.Decimal(12, 2)
  martyrsFund       Decimal             @map("martyrs_fund") @db.Decimal(12, 2)
  deductions        Decimal             @db.Decimal(12, 2)
  net               Decimal             @db.Decimal(12, 2)
  released          Decimal             @db.Decimal(12, 2)
  transfer          Decimal             @db.Decimal(12, 2)
  companyCost       Decimal             @map("company_cost") @db.Decimal(12, 2)
  onHold            Boolean             @default(false) @map("on_hold") // not paid by the bank files this month
  comments          String?
  // the bank details as they were when the CEO approved the run
  bankShort         String?             @map("bank_short") // the EG-ACH list's short code (CIB, QNB …); a bank not on the list as typed
  accountNo         String?             @map("account_no")
  iban              String?
  holderName        String?             @map("holder_name")
  // the inputs an attendance import filled (owner, 19 October 2026: Zoho People): { source: 'zoho', importId, at, fields:
  // the inputs it filled still as it filled them }; a field HR types afterwards is no longer from it; null: none
  attendanceImport  Json?               @map("attendance_import")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  payslips          Payslip[] // the line's payslip, in English and, when asked for, in Arabic
  adjustments       PayrollAdjustment[] // the month's additions and deductions applied to it
  holdRelease       PayrollHoldRelease? // held: when and how its pay was paid out since

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([employmentId])
  @@index([contractId])
  @@map("payroll_lines")
}

// A payslip (owner's decisions, 16 October 2026): drawn by the system from an approved line, straight to a protected
// PDF, and kept. The English one is issued for every line not on hold when HR marks the run paid; the Arabic one is
// drawn the first time it is asked for. A payslip is never edited or drawn again once kept: the run is locked from the
// CEO's approval on. RESTRICTED (HR, Finance, CEO), like the line.
model Payslip {
  id            String      @id @default(uuid()) @db.Uuid
  lineId        String      @map("line_id") @db.Uuid
  line          PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  language      String // PAYSLIP_LANGUAGES: en, ar
  fileName      String      @map("file_name")
  data          Bytes // the protected PDF
  sizeBytes     Int         @map("size_bytes")
  generatedById String?     @map("generated_by") @db.Uuid
  generatedBy   User?       @relation("PayslipGeneration", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime    @default(now()) @map("generated_at") @db.Timestamptz

  @@unique([lineId, language])
  @@map("payslips")
}

// The rates set by law, by year (owner's request, 16 October 2026: "creating a setup page for payroll to enter the
// variables that might affect the sheet"; the tax brackets "editable by superadmin, to modify it if the law changed"):
// the social insurance shares, the insurable wage limits, the personal exemption, the Martyrs' Fund, comprehensive
// health insurance and the salary tax's tiers. A year's row applies from that year; a year without its own uses the
// latest earlier one (the earliest for a year before them all). The Super Admin changes them (Organization → Payroll);
// a payroll run keeps a copy of the year's it was worked out with. The law rates migration and prisma/seed.ts add 2025
// and 2026, as packages/shared law-rates.ts has them built in.
model PayrollLawYear {
  year                  Int      @id // the year these apply from
  employeeInsuranceRate Decimal  @map("employee_insurance_rate") @db.Decimal(8, 6) // fractions: 0.11 for 11%
  employerInsuranceRate Decimal  @map("employer_insurance_rate") @db.Decimal(8, 6)
  insurableWageMin      Decimal  @map("insurable_wage_min") @db.Decimal(12, 2) // a month
  insurableWageMax      Decimal  @map("insurable_wage_max") @db.Decimal(12, 2)
  personalExemption     Decimal  @map("personal_exemption") @db.Decimal(12, 2) // a year
  martyrsRate           Decimal  @map("martyrs_rate") @db.Decimal(8, 6)
  healthInsuranceRate   Decimal  @map("health_insurance_rate") @db.Decimal(8, 6)
  taxTiers              Json     @map("tax_tiers") // TaxTier[]: [{ upTo, bands: [{ upTo, rate }] }], upTo null for no limit
  // the private sector's minimum wage a month (owner, 18 October 2026), for reference (the paid trainee's last stage
  // floor, Labour Law 14/2025 Art. 29, until the trainee went on 25 October 2026); not seeded, the owner sets it; null:
  // not set, nothing checked against it
  minimumWage           Decimal? @map("minimum_wage") @db.Decimal(12, 2)
  // the most of the employee's health insurance share that lowers their taxable pay in a year (owner, 20 October 2026,
  // on the medical share: "Before Tax i think"): the recurring deductions ticked "Deducted before tax" lower a month's
  // taxable pay by at most a twelfth of it; not seeded, as the law's limit is the accountant's to give; null: no limit
  beforeTaxHealthLimit  Decimal? @map("before_tax_health_limit") @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedById           String?  @map("updated_by") @db.Uuid // null for the rows the migration added
  updatedBy             User?    @relation("LawRatesChange", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("payroll_law_years")
}

// ---------- payroll: additions and deductions, advances and loans, what is still unsettled ----------
// The owner, 17 October 2026: "make the Payroll in the side tab a main title below it - Unsettled - Additions /
// Deductions". Asked, the owner chose: Additions / Deductions are one-off amounts per employee and month (not
// recurring); Unsettled lists the runs not yet paid, the lines on hold not paid out since, the final settlements of
// people who left, and the advances and loans still being recovered. Salary data, RESTRICTED (HR, Finance, CEO) like
// the payroll lines: HR enters and changes them, Finance and the CEO read them; the audit log says only that an amount
// changed, as for a salary.

// A one-off addition or deduction on an employee's pay for a month. Additions: a bonus, commission, incentive or
// correction (taxed), a reimbursement (not taxed), or other (taxed or not, as HR chooses). Deductions, all taken after
// tax: a penalty, damage or loss, an advance's recovery or a loan's installment (linked to it), or other. Pending until
// the month's run is approved with it on the line (applied), or cancelled. HR changes and cancels one while it
// is pending and the month's run isn't with the CEO, approved or paid.
// In days (owner, 17 October 2026, the run's grid columns moved here: "instead of there, i think earnings and
// deductions will be enough"): a Bonus (days) addition and a Penalty (days) deduction have their days and no amount,
// which the month's run works out from the person's pay (packages/shared payrollLine) and keeps on the line; the amount
// it came to is copied here when the CEO's approval applies it. A Correction is an addition or a deduction.
// Installments and recurring deductions (owner, 18 October 2026: "in the deductions i might have a loan of a medical
// subscription or something that needs to be deducted as installments on the employee. how will it be managed?"): an
// advance's or a loan's installments are made at once from its plan, each linked to it; a Recurring deduction is added
// to each month's payroll for a recurring deduction (recurringId), one a month at most.
model PayrollAdjustment {
  id            String               @id @default(uuid()) @db.Uuid
  employeeId    String               @map("employee_id") @db.Uuid
  employee      Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  month         DateTime             @db.Date // the month's first day: the run it goes on
  kind          String // ADJUSTMENT_KINDS: addition, deduction
  type          String // ADDITION_TYPES or DEDUCTION_TYPES, by kind
  taxed         Boolean // an addition taxed with the pay; never a deduction (taken after tax, or before it: beforeTax)
  // a Recurring deduction of a recurring deduction ticked "Deducted before tax" (owner, 20 October 2026: "Before Tax i
  // think"): it lowers the taxable pay before the income tax; false for every other, which is after tax
  beforeTax     Boolean              @default(false) @map("before_tax")
  amount        Decimal?             @db.Decimal(12, 2) // RESTRICTED: EGP, more than 0; in days, none until applied (what the line paid)
  days          Decimal?             @db.Decimal(5, 2) // a Bonus (days) or a Penalty (days): whole or half days, up to 31 (a compensatory day's hours' pay to the hundredth, 27 October 2026); none for the others
  reason        String
  advanceId     String?              @map("advance_id") @db.Uuid // an advance's recovery or a loan's installment: which one
  advance       PayrollAdvance?      @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  recurringId   String?              @map("recurring_id") @db.Uuid // a Recurring deduction: the recurring deduction it is that month's of
  recurring     RecurringDeduction?  @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  // a Damage or loss deduction HR made from an asset returned damaged or missing (Assets step 3, owner, 21 October
  // 2026: "Record it; HR decides a deduction"): the custody item, for tracing it
  custodyItemId String?              @map("custody_item_id") @db.Uuid
  custodyItem   CustodyItem?         @relation(fields: [custodyItemId], references: [id], onDelete: SetNull)
  status        String               @default("pending") // ADJUSTMENT_STATUSES: pending, applied, cancelled
  lineId        String?              @map("line_id") @db.Uuid // applied: the run line it was paid on
  line          PayrollLine?         @relation(fields: [lineId], references: [id], onDelete: SetNull)
  appliedAt     DateTime?            @map("applied_at") @db.Timestamptz
  cancelledById String?              @map("cancelled_by") @db.Uuid
  cancelledBy   User?                @relation("AdjustmentCancel", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime?            @map("cancelled_at") @db.Timestamptz
  createdById   String?              @map("created_by") @db.Uuid
  createdBy     User?                @relation("AdjustmentEntry", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  reimbursement ReimbursementClaim? // a reimbursement addition: the claim whose approval by Finance added it
  leavePayout   LeaveBalanceYear? // an Unused leave paid addition: the balance whose closing (or leaving) paid it
  compensatory  CompensatoryRequest? // a Compensation for working addition: the compensatory request HR approved as cash instead (26 October 2026)

  @@unique([recurringId, month]) // a recurring deduction's month once, whatever became of it
  @@index([month])
  @@index([employeeId])
  @@index([advanceId])
  @@index([lineId])
  @@index([custodyItemId])
  @@map("payroll_adjustments")
}

// An advance or a loan given to an employee, recovered from their pay by deductions linked to it (an advance's
// recovery, a loan's installment): those applied count as recovered, those pending are planned. Open while something
// is outstanding (the amount less what was recovered); settled automatically once nothing is (settledById null and no
// note), or by HR with a note (e.g. paid back in cash). Since 18 October 2026 the installments are made at once from a
// plan (the total, how many months, the first month), and settledHow says how it was settled: recovered, deducted from
// the final settlement or waived on leaving (owner: "taken from the final settlement, unless waived"), or paid back.
model PayrollAdvance {
  id          String              @id @default(uuid()) @db.Uuid
  employeeId  String              @map("employee_id") @db.Uuid
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  kind        String // ADVANCE_KINDS: advance, loan
  amount      Decimal             @db.Decimal(12, 2) // RESTRICTED: EGP, more than 0
  givenOn     DateTime            @map("given_on") @db.Date
  reason      String
  plan        String? // how it is to be recovered, in HR's words: "6 installments of 1,000"
  status      String              @default("open") // ADVANCE_STATUSES: open, settled
  settledAt   DateTime?           @map("settled_at") @db.Timestamptz
  settledById String?             @map("settled_by") @db.Uuid // null when settled automatically
  settledBy   User?               @relation("AdvanceSettlement", fields: [settledById], references: [id], onDelete: SetNull)
  settledNote String?             @map("settled_note") // HR's, when HR marked it settled
  settledHow  String?             @map("settled_how") // ADVANCE_SETTLED_HOWS: recovered, final_settlement, waived, paid_back; null while open
  createdById String?             @map("created_by") @db.Uuid
  createdBy   User?               @relation("AdvanceEntry", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  recoveries  PayrollAdjustment[] // the deductions that recover it

  @@index([employeeId])
  @@index([status])
  @@map("payroll_advances")
}

// A recurring deduction (owner, 18 October 2026: "in the deductions i might have a loan of a medical subscription or
// something that needs to be deducted as installments on the employee. how will it be managed?"): an ongoing monthly
// share, e.g. the employee's share of a medical subscription, of a fixed amount from a start month to an end month or
// until HR stops it. Each month's run adds its Recurring deduction (a PayrollAdjustment linked to it) for the months it
// is due and the employee is employed. HR changes the amount from a month on (this one stopped then, a new one from
// then) or stops it; an employment ending stops it from the month after the last working day ("Left the company").
// Taken after tax unless HR ticks it "Deducted before tax" (owner, 20 October 2026: "Before Tax i think").
// RESTRICTED (HR, Finance, CEO; the employee their own), like a salary.
model RecurringDeduction {
  id                  String              @id @default(uuid()) @db.Uuid
  employeeId          String              @map("employee_id") @db.Uuid
  employee            Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  name                String // what it is for, up to 100 characters: "Medical subscription (family)"; the payslip line's
  amount              Decimal             @db.Decimal(12, 2) // RESTRICTED: EGP a month, more than 0
  startMonth          DateTime            @map("start_month") @db.Date // the first month's first day
  endMonth            DateTime?           @map("end_month") @db.Date // the last month's first day; null: until stopped
  stoppedFrom         DateTime?           @map("stopped_from") @db.Date // the first day of the first month no longer deducted, once stopped
  stopNote            String?             @map("stop_note") // why it was stopped: HR's, or "Left the company"
  // "Deducted before tax (lowers taxable pay)" (owner, 20 October 2026, asked whether the employee's medical share is
  // taken before or after tax: "Before Tax i think"), off by default: its months' Recurring deductions carry it
  beforeTax           Boolean             @default(false) @map("before_tax")
  createdById         String?             @map("created_by") @db.Uuid
  createdBy           User?               @relation("RecurringDeductionEntry", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  deductions          PayrollAdjustment[] // the months' Recurring deductions
  // The employee's written consent (Labour Law 14/2025 Art. 114; owner, 18 October 2026, after reading the law: "record
  // the consent"): when HR recorded it was on file and who; null on those set up before then until HR records it. The
  // signed consent, if HR attached it, is a paper in the employee file (kind deduction_consent).
  consentRecordedAt   DateTime?           @map("consent_recorded_at") @db.Timestamptz
  consentRecordedById String?             @map("consent_recorded_by") @db.Uuid
  consentRecordedBy   User?               @relation("RecurringDeductionConsent", fields: [consentRecordedById], references: [id], onDelete: SetNull)
  consentPaperworkId  String?             @map("consent_paperwork_id") @db.Uuid
  consentPaperwork    PaperworkItem?      @relation(fields: [consentPaperworkId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("recurring_deductions")
}

// The final settlement of an ended employment (its end date set): open from the end date until HR marks it settled,
// with the day, the amount paid and a note, and the generated "Clearance and dues" document of that ending if there is
// one. There is a row once HR has marked it settled; reopened by HR (status open), it is listed open again.
model FinalSettlement {
  id           String             @id @default(uuid()) @db.Uuid
  employmentId String             @unique @map("employment_id") @db.Uuid
  employment   Employment         @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  status       String             @default("settled") // FINAL_SETTLEMENT_STATUSES: settled, open (reopened)
  settledOn    DateTime           @map("settled_on") @db.Date
  amountPaid   Decimal            @map("amount_paid") @db.Decimal(12, 2) // RESTRICTED: EGP, 0 or more
  note         String?
  documentId   String?            @map("document_id") @db.Uuid // the clearance_dues document generated for the ending
  document     GeneratedDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  settledById  String?            @map("settled_by") @db.Uuid
  settledBy    User?              @relation("FinalSettlementBy", fields: [settledById], references: [id], onDelete: SetNull)
  settledAt    DateTime           @default(now()) @map("settled_at") @db.Timestamptz
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([documentId])
  @@map("final_settlements")
}

// A line held on an approved or paid run (the bank files left it out), recorded by HR as paid out since: the day, how
// (a bank transfer, cash, or with a later run) and a note. Without one, the held line is unsettled.
model PayrollHoldRelease {
  id           String      @id @default(uuid()) @db.Uuid
  lineId       String      @unique @map("line_id") @db.Uuid
  line         PayrollLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  paidOn       DateTime    @map("paid_on") @db.Date
  method       String // HOLD_RELEASE_METHODS: bank_transfer, cash, later_run
  note         String?
  recordedById String?     @map("recorded_by") @db.Uuid
  recordedBy   User?       @relation("HoldReleaseBy", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt   DateTime    @default(now()) @map("recorded_at") @db.Timestamptz

  @@map("payroll_hold_releases")
}

// A leave, permission, work from home or official duty change whose days fall in a month whose payroll had moved on
// (with the CEO, approved or paid) when it was made (owner's brief, 27 October 2026: allowed, never silent). The run
// keeps its lines, so HR corrects it by hand on a later payroll: listed on Unsettled until HR marks it handled, or the
// month's run returns to draft and is refilled, which handles it (handledHow refilled). A table of its own rather than a
// flag on each request: one query lists every kind, the handling is explicit, and a refill clears a month without
// touching the requests. Never the request's reason: its kind, id, days and a summary line (type and days).
model PayrollLockedChange {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month       DateTime  @db.Date // the month's first day
  runStatus   String    @map("run_status") // the run's status when the change was made: pending_ceo, approved, paid
  requestKind String    @map("request_kind") // LOCKED_CHANGE_KINDS: leave, permission, wfh, od
  requestId   String    @map("request_id") @db.Uuid // the request's id in its own table (no relation: four kinds)
  action      String // LOCKED_CHANGE_ACTIONS: recorded, approved, cancelled
  fromDate    DateTime  @map("from_date") @db.Date // the request's days
  toDate      DateTime  @map("to_date") @db.Date
  summary     String // "Annual leave, 03/07/2026–04/07/2026"
  createdById String?   @map("created_by") @db.Uuid
  createdBy   User?     @relation("LockedChangeBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  handledById String?   @map("handled_by") @db.Uuid
  handledBy   User?     @relation("LockedChangeHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime? @map("handled_at") @db.Timestamptz // null while still to handle
  handledHow  String?   @map("handled_how") // LOCKED_CHANGE_HANDLING: by_hand (HR), refilled (the run returned to draft and refilled)
  handledNote String?   @map("handled_note")

  @@index([employeeId, month])
  @@index([requestKind, requestId])
  @@index([handledAt])
  @@map("payroll_locked_changes")
}

// ---------- reimbursements ----------
// The owner, 18 October 2026: "allow the employee to add reimbursement request … for specific preset up conditions",
// and "in the setup i need to enter for it a cap". HR sets up the types in Payroll Setup with their conditions; an
// employee claims one from My Requests; their direct manager, then HR, then Finance decide it (no manager: straight to
// HR), each approving it, approving a lower amount (with a comment) or rejecting it (with one), every step logged on the
// claim. Finance's approval adds it, untaxed, to the next payroll as a Reimbursement addition. The rules are in
// packages/shared reimbursements.ts.

// A reimbursement type and its conditions: caps a claim, a calendar month and a calendar year (EGP, by the expense's
// date; empty: no cap), a receipt required or not, the days after the expense it must be claimed within (empty: no
// deadline), and who may claim it: departments (a department's teams with it), grades and employment types, empty:
// everyone. A change applies to the claims sent after it. Turned off (active false), it isn't offered; one with claims
// is never deleted.
model ReimbursementType {
  id              String               @id @default(uuid()) @db.Uuid
  nameEn          String               @unique @map("name_en") // unique whatever the case, checked by the API
  nameAr          String               @map("name_ar")
  description     String?
  receiptRequired Boolean              @default(true) @map("receipt_required")
  capPerClaim     Decimal?             @map("cap_per_claim") @db.Decimal(12, 2)
  capPerMonth     Decimal?             @map("cap_per_month") @db.Decimal(12, 2)
  capPerYear      Decimal?             @map("cap_per_year") @db.Decimal(12, 2)
  claimWithinDays Int?                 @map("claim_within_days") // 1 to 365
  departmentIds   String[]             @default([]) @map("department_ids") @db.Uuid
  gradeIds        String[]             @default([]) @map("grade_ids") @db.Uuid
  employmentTypes String[]             @default([]) @map("employment_types") // EMPLOYMENT_TYPES
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  claims          ReimbursementClaim[]

  @@map("reimbursement_types")
}

// A reimbursement claimed by an employee under their current employment: the type, the expense's date, the amount as
// claimed and as last approved (the final amount once approved), what it was for, where it is (REIMBURSEMENT_STATUSES),
// and the direct manager at the time it was sent, who decides its first stage (none: it went straight to HR). Rejected,
// it says at which stage and why. Finance's approval adds it to a month's payroll: the addition made, and that month.
model ReimbursementClaim {
  id             String                   @id @default(uuid()) @db.Uuid
  employeeId     String                   @map("employee_id") @db.Uuid
  employee       Employee                 @relation("ReimbursementClaimant", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId   String                   @map("employment_id") @db.Uuid // the current employment when it was sent
  employment     Employment               @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  typeId         String                   @map("type_id") @db.Uuid
  type           ReimbursementType        @relation(fields: [typeId], references: [id], onDelete: Restrict)
  expenseDate    DateTime                 @map("expense_date") @db.Date
  amount         Decimal                  @db.Decimal(12, 2) // EGP, as claimed
  approvedAmount Decimal?                 @map("approved_amount") @db.Decimal(12, 2) // EGP, as last approved; the final amount once approved
  description    String
  status         String // REIMBURSEMENT_STATUSES: with_manager, with_hr, with_finance, approved, rejected, cancelled
  managerId      String?                  @map("manager_id") @db.Uuid // the direct manager when it was sent, who decides the manager stage
  manager        Employee?                @relation("ReimbursementManager", fields: [managerId], references: [id], onDelete: Restrict)
  // who the manager stage's decider is (owner, 19 October 2026: "the person in charge"): APPROVER_ROLES, direct_manager,
  // or for someone without one their team_lead, else their department_head; set exactly when managerId is
  approverRole   String?                  @map("approver_role")
  rejectedStage  String?                  @map("rejected_stage") // REIMBURSEMENT_STAGES: manager, hr, finance
  rejectReason   String?                  @map("reject_reason") // the comment it was rejected with
  adjustmentId   String?                  @unique @map("adjustment_id") @db.Uuid // the Reimbursement addition Finance's approval made
  adjustment     PayrollAdjustment?       @relation(fields: [adjustmentId], references: [id], onDelete: SetNull)
  payMonth       DateTime?                @map("pay_month") @db.Date // the first day of the month whose payroll it was added to
  createdById    String?                  @map("created_by") @db.Uuid
  createdBy      User?                    @relation("ReimbursementCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz
  steps          ReimbursementClaimStep[]
  receipts       ReimbursementReceipt[]

  @@index([employeeId])
  @@index([status])
  @@index([managerId])
  @@index([typeId])
  @@map("reimbursement_claims")
}

// A step of a claim, logged on it in the order taken (like a raise request's), in the transaction the step is taken in:
// REIMBURSEMENT_STEP_KINDS. Sent with the amount claimed; each stage's decision with its decision, the amount approved
// at that step (none on a rejection) and the comment; added to payroll with the month. Ordered by id.
model ReimbursementClaimStep {
  id           BigInt             @id @default(autoincrement())
  claimId      String             @map("claim_id") @db.Uuid
  claim        ReimbursementClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  kind         String // REIMBURSEMENT_STEP_KINDS
  decision     String? // REIMBURSEMENT_DECISIONS, on the stages' decisions only
  amount       Decimal?           @db.Decimal(12, 2) // EGP: claimed (submitted), approved at that step, or added to payroll
  comment      String?
  payMonth     DateTime?          @map("pay_month") @db.Date // added_to_payroll: the first day of the month
  actorId      String?            @map("actor_id") @db.Uuid
  actor        User?              @relation("ReimbursementStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  onBehalfOfId String?            @map("on_behalf_of") @db.Uuid // the manager step decided by a stand-in: the approver they stood in for (25 October 2026)
  onBehalfOf   Employee?          @relation("ClaimStepOnBehalf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)
  at           DateTime           @default(now()) @db.Timestamptz

  @@index([claimId])
  @@map("reimbursement_claim_steps")
}

// A receipt of a claim: a photo or a PDF (REIMBURSEMENT_RECEIPT_TYPES, told by its first bytes, as paperwork is), kept in
// the database like the employee file, so the daily backup has it. Seen by those who see the claim.
model ReimbursementReceipt {
  id         String             @id @default(uuid()) @db.Uuid
  claimId    String             @map("claim_id") @db.Uuid
  claim      ReimbursementClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName   String             @map("file_name")
  mimeType   String             @map("mime_type")
  sizeBytes  Int                @map("size_bytes")
  data       Bytes
  uploadedAt DateTime           @default(now()) @map("uploaded_at") @db.Timestamptz

  @@index([claimId])
  @@map("reimbursement_receipts")
}

// ---------- leave ----------
// The owner, 18 October 2026: "if we will work on the attendance and leaves, how will we build it?" (leave first, as
// attendance needs leave to tell an absence from a leave) and "can you apply the leaves according to the law?": the
// leave types of Labour Law No. 14 of 2025 (Arts. 54–57, 124–133) as the default types, which HR may change, turn off or
// add to; requests decided by the direct manager, then HR (no manager: straight to HR), each step logged; the annual
// balance by calendar year, a joiner's first year pro-rated; and a Year Closing where HR decides how many unused days
// carry into the new year and how many are paid ("make it with decision with the year closing"). The rules themselves:
// packages/shared leaves.ts.

// A leave type (Leave Setup): the law's, by key (annual, casual, birth, exam, hajj, sick, maternity, childcare, unpaid),
// seeded by the leave migration, and HR's own (kind custom). Its pay (paid, unpaid, or partly at a percent: sick leave),
// what its days are counted against (LEAVE_BALANCES), its limits (days a year, a request, times in service, months of
// service first, days' notice), a document needed, for one gender, counted in calendar days, half days allowed. Turned
// off, it isn't offered; only a Super Admin deletes one, and only one never asked for.
model LeaveType {
  id                String         @id @default(uuid()) @db.Uuid
  key               String         @unique // the law's kind for its types; custom-… for HR's own
  kind              String // LEAVE_KINDS
  nameEn            String         @map("name_en")
  nameAr            String         @map("name_ar")
  paid              String // LEAVE_PAYS: paid, unpaid, partly
  payPercent        Decimal?       @map("pay_percent") @db.Decimal(5, 2) // partly paid: 0–100
  balance           String // LEAVE_BALANCES: annual, from_annual, yearly, per_request, none
  daysPerYear       Int?           @map("days_per_year")
  maxPerRequest     Int?           @map("max_per_request")
  maxTimesInService Int?           @map("max_times_in_service")
  minServiceMonths  Int?           @map("min_service_months")
  noticeDays        Int?           @map("notice_days")
  documentRequired  Boolean        @default(false) @map("document_required")
  gender            String? // male, female; null: everyone
  calendarDays      Boolean        @default(false) @map("calendar_days")
  halfDays          Boolean        @default(false) @map("half_days")
  active            Boolean        @default(true)
  sortOrder         Int            @default(100) @map("sort_order")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  requests          LeaveRequest[]

  @@map("leave_types")
}

// The Leave Setup's annual leave (one row, id 1; Art. 124): the days in the first year, from the second, after 10 years'
// service (with one or more employers) or over the age of 50, with a disability, the days more for hazardous work, the
// months served before the first year's leave may be used, and the years days may be carried before they are settled
// (Art. 125). The migration seeds the law's numbers; HR changes them.
model LeaveSettings {
  id                        Int      @id @default(1) // always 1
  firstYearDays             Int      @default(15) @map("first_year_days")
  standardDays              Int      @default(21) @map("standard_days")
  longServiceDays           Int      @default(30) @map("long_service_days")
  longServiceYears          Int      @default(10) @map("long_service_years")
  longServiceAge            Int      @default(50) @map("long_service_age")
  disabilityDays            Int      @default(45) @map("disability_days")
  hazardousExtraDays        Int      @default(7) @map("hazardous_extra_days")
  firstYearMinMonths        Int      @default(6) @map("first_year_min_months")
  settleWithinYears         Int      @default(3) @map("settle_within_years")
  // permission (owner, 19 October 2026: "4 hours per month with a maximum 2 hours per day", "Yes, in Leave Setup"): the
  // hours a month someone may be away for (0: none) and the most of one day, in half hours
  permissionHoursPerMonth   Decimal  @default(4) @map("permission_hours_per_month") @db.Decimal(4, 1)
  permissionMaxHoursPerDay  Decimal  @default(2) @map("permission_max_hours_per_day") @db.Decimal(3, 1)
  // working from home (owner, 21 October 2026: "its 2 days per month with a gap of 1 week between each record
  // (Biweekly)"): the days a calendar month someone may work from home (0: none), and the fewest days between two
  wfhDaysPerMonth           Int      @default(2) @map("wfh_days_per_month")
  wfhMinGapDays             Int      @default(7) @map("wfh_min_gap_days")
  // compensatory days (owner, 26 October 2026: "if paid in cash make it 1.5"): the days' pay a day worked is paid in cash
  // instead of a day off, in whole or half days
  compensatoryCashRate      Decimal  @default(1.5) @map("compensatory_cash_rate") @db.Decimal(3, 1)
  // the Compensatory Setup (owner, 27 October 2026: "minimum working hours"; "up to 4 hours to be compensated by hours -
  // minimum 6 hours can be compensated by a day"): fewer hours worked earn nothing, hours off at most so many, from so many
  // a whole day; and when the day off is taken (null: the same calendar month; else within so many days after)
  compensatoryMinHours      Decimal  @default(2) @map("compensatory_min_hours") @db.Decimal(4, 1)
  compensatoryHoursCap      Decimal  @default(4) @map("compensatory_hours_cap") @db.Decimal(4, 1)
  compensatoryFullDayHours  Decimal  @default(6) @map("compensatory_full_day_hours") @db.Decimal(4, 1)
  compensatoryOffWithinDays Int?     @map("compensatory_off_within_days")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedById               String?  @map("updated_by") @db.Uuid
  updatedBy                 User?    @relation("LeaveSettingsBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("leave_settings")
}

// A team's staffing limit for annual leave (owner, 25 October 2026: "if there are leaves applied by an employee and
// another employee in the same department is on a leave, how can we manage it without affecting the workflow?"; asked,
// "Warn and need HR"), or a department's without teams: at most so many on annual (and unpaid) leave at once, and/or at
// least so many percent at work; at least one of them (none: no row). A request that would break it on any day (counting
// approved and pending annual leave) is still sent, with a warning, and HR approves it too. Set by HR and a Super Admin
// (Organization → Leave → Staffing). Never sick or casual leave. Rules: packages/shared leave-coverage.ts.
model LeaveStaffingLimit {
  departmentId     String     @id @map("department_id") @db.Uuid
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  maxOff           Int?       @map("max_off") // 0–500
  minAtWorkPercent Int?       @map("min_at_work_percent") // 1–100
  updatedById      String?    @map("updated_by") @db.Uuid
  updatedBy        User?      @relation("StaffingLimitBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("leave_staffing_limits")
}

// A leave request: the employee and the employment it is under, the type, the first and last day, a half day, its
// days as counted when sent (LEAVE_STATUSES), the direct manager when it was sent (who decides the manager stage), and
// where it is. Rejected: at which stage, and why. Recorded by HR on the employee's behalf (e.g. sick leave reported
// after): approved at once. Cancelled by its employee (while being decided, or approved and not started) or by HR (an
// approved one, with a comment): its days are back in the balance.
model LeaveRequest {
  id                String             @id @default(uuid()) @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  employee          Employee           @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId      String             @map("employment_id") @db.Uuid
  employment        Employment         @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  typeId            String             @map("type_id") @db.Uuid
  type              LeaveType          @relation(fields: [typeId], references: [id], onDelete: Restrict)
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime           @map("end_date") @db.Date
  halfDay           Boolean            @default(false) @map("half_day")
  days              Decimal            @db.Decimal(5, 1)
  reason            String?
  status            String // LEAVE_STATUSES: with_manager, with_hr, approved, rejected, cancelled
  managerId         String?            @map("manager_id") @db.Uuid
  manager           Employee?          @relation("LeaveManager", fields: [managerId], references: [id], onDelete: Restrict)
  // who the manager stage's decider is (owner, 19 October 2026: "the person in charge"): APPROVER_ROLES, direct_manager,
  // or for someone without one their team_lead, else their department_head; set exactly when managerId is
  approverRole      String?            @map("approver_role")
  rejectedStage     String?            @map("rejected_stage") // LEAVE_STAGES: manager, hr
  rejectReason      String?            @map("reject_reason")
  recordedByHr      Boolean            @default(false) @map("recorded_by_hr")
  createdById       String?            @map("created_by") @db.Uuid
  createdBy         User?              @relation("LeaveRequestCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  steps             LeaveRequestStep[]
  documents         LeaveDocument[]
  // imported from a file (owner, 21 October 2026: "how to import bulk leaves?"): the import that made it, which Undo
  // removes it with; and a Zoho People row's ZOHO_LINK_ID, once only ("make sure there will be no duplicates from the
  // previous imported files": undoing deletes the leave, so the row can be imported again)
  importId          String?            @map("import_id") @db.Uuid
  leaveImport       LeaveImport?       @relation(fields: [importId], references: [id], onDelete: Restrict)
  zohoLinkId        String?            @unique @map("zoho_link_id")
  // leave coverage (owner, 25 October 2026; packages/shared leave-coverage.ts). The colleague who covers the work, required
  // for annual (and unpaid) leave of more than 2 working days ("Required over 2 days"), never the employee, and the
  // employee's handover note to them (free text)
  coverId           String?            @map("cover_id") @db.Uuid
  cover             Employee?          @relation("LeaveCover", fields: [coverId], references: [id], onDelete: SetNull)
  handoverNote      String?            @map("handover_note")
  // it broke the team's staffing limit on some day when sent ("Warn and need HR"): HR approves it too, marked so
  overStaffingLimit Boolean            @default(false) @map("over_staffing_limit")
  // an approver's leave ("To a stand-in"): who decides what waits at their step during its days once it is approved, a
  // person (never the employee) or HR (standInHr; never both); none for someone who approves for nobody. When the stand-in
  // was told it started (once)
  standInId         String?            @map("stand_in_id") @db.Uuid
  standIn           Employee?          @relation("LeaveStandIn", fields: [standInId], references: [id], onDelete: SetNull)
  standInHr         Boolean            @default(false) @map("stand_in_hr")
  standInToldAt     DateTime?          @map("stand_in_told_at") @db.Timestamptz

  @@index([employeeId, startDate])
  @@index([status])
  @@index([managerId])
  @@index([typeId])
  @@index([importId])
  @@index([coverId])
  @@index([standInId])
  @@map("leave_requests")
}

// Each step of a request, in the order taken (LEAVE_STEP_KINDS): sent, sent straight to HR, recorded by HR, each
// stage's decision (approve or reject, with the comment), cancelled (with HR's comment).
model LeaveRequestStep {
  id           BigInt       @id @default(autoincrement())
  requestId    String       @map("request_id") @db.Uuid
  request      LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind         String
  decision     String? // LEAVE_DECISIONS, on the stages' decisions only
  comment      String?
  actorId      String?      @map("actor_id") @db.Uuid
  actor        User?        @relation("LeaveStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  // a decision by a stand-in (25 October 2026): the approver they stood in for
  onBehalfOfId String?      @map("on_behalf_of") @db.Uuid
  onBehalfOf   Employee?    @relation("LeaveStepOnBehalf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)
  at           DateTime     @default(now()) @db.Timestamptz

  @@index([requestId])
  @@map("leave_request_steps")
}

// A permission request (owner, 19 October 2026: "this is an option given by us .. 4 hours per month with a maximum 2
// hours per day", asked "In the system, like leave"): a few hours of one working day away, in half hours, from and to
// times when given (e.g. leaving at 17:00), under the employment the day is in; decided as leave is (LEAVE_STATUSES),
// by the direct manager (else the team lead, else the department's head: approverRole) then HR, a C-level person's HR
// stage by the CEO; recorded by HR on the employee's behalf, approved at once. A table of its own rather than a leave
// type: it is counted in hours against the month, not in days against a balance, and the payroll counts it as worked,
// not as leave (packages/shared permissions.ts).
model PermissionRequest {
  id            String                  @id @default(uuid()) @db.Uuid
  employeeId    String                  @map("employee_id") @db.Uuid
  employee      Employee                @relation("PermissionRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId  String                  @map("employment_id") @db.Uuid
  employment    Employment              @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  date          DateTime                @db.Date
  hours         Decimal                 @db.Decimal(3, 1)
  fromTime      DateTime?               @map("from_time") @db.Time(0)
  toTime        DateTime?               @map("to_time") @db.Time(0)
  reason        String?
  status        String // LEAVE_STATUSES: with_manager, with_hr, approved, rejected, cancelled
  managerId     String?                 @map("manager_id") @db.Uuid
  manager       Employee?               @relation("PermissionManager", fields: [managerId], references: [id], onDelete: Restrict)
  approverRole  String?                 @map("approver_role") // APPROVER_ROLES, set exactly when managerId is
  rejectedStage String?                 @map("rejected_stage") // LEAVE_STAGES: manager, hr
  rejectReason  String?                 @map("reject_reason")
  recordedByHr  Boolean                 @default(false) @map("recorded_by_hr")
  createdById   String?                 @map("created_by") @db.Uuid
  createdBy     User?                   @relation("PermissionRequestCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  steps         PermissionRequestStep[]

  @@index([employeeId, date])
  @@index([status])
  @@index([managerId])
  @@map("permission_requests")
}

// Each step of a permission request, in the order taken (LEAVE_STEP_KINDS), as a leave request's.
model PermissionRequestStep {
  id           BigInt            @id @default(autoincrement())
  requestId    String            @map("request_id") @db.Uuid
  request      PermissionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind         String
  decision     String? // LEAVE_DECISIONS, on the stages' decisions only
  comment      String?
  actorId      String?           @map("actor_id") @db.Uuid
  actor        User?             @relation("PermissionStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  onBehalfOfId String?           @map("on_behalf_of") @db.Uuid // a decision by a stand-in: the approver they stood in for (25 October 2026)
  onBehalfOf   Employee?         @relation("PermissionStepOnBehalf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)
  at           DateTime          @default(now()) @db.Timestamptz

  @@index([requestId])
  @@map("permission_request_steps")
}

// A work from home day (owner, 21 October 2026: "think about how should we handle the working from home in out erp"): one
// working day of someone expected at the office, worked from home: not leave (no balance, no pay effect, its hours counted
// as any day's). Asked a day before at the latest ("A day before"), at most the Leave Setup's days a calendar month (2),
// any two at least its days apart (7: "its 2 days per month with a gap of 1 week between each record (Biweekly)");
// decided as leave is (LEAVE_STATUSES) by the approver in charge (approverRole), then HR, a C-level person's HR stage by
// the CEO ("Manager, then HR"); recorded by HR for someone on any day, past the limits too, with a reason and the
// warnings it was recorded past, approved at once; or brought over from Zoho People's history (source zoho). One a person
// and day while being decided or approved (a partial unique index). Rules: packages/shared wfh.ts.
model WfhRequest {
  id            String           @id @default(uuid()) @db.Uuid
  employeeId    String           @map("employee_id") @db.Uuid
  employee      Employee         @relation("WfhRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId  String           @map("employment_id") @db.Uuid
  employment    Employment       @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  date          DateTime         @db.Date
  reason        String?
  status        String // LEAVE_STATUSES: with_manager, with_hr, approved, rejected, cancelled
  managerId     String?          @map("manager_id") @db.Uuid
  manager       Employee?        @relation("WfhManager", fields: [managerId], references: [id], onDelete: Restrict)
  approverRole  String?          @map("approver_role") // APPROVER_ROLES, set exactly when managerId is
  rejectedStage String?          @map("rejected_stage") // LEAVE_STAGES: manager, hr
  rejectReason  String?          @map("reject_reason")
  recordedByHr  Boolean          @default(false) @map("recorded_by_hr")
  source        String           @default("system") // WFH_SOURCES: system, zoho
  warnings      String[]         @default([]) // what HR recorded it past (no day's notice, the limits), as said then
  createdById   String?          @map("created_by") @db.Uuid
  createdBy     User?            @relation("WfhRequestCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  steps         WfhRequestStep[]
  // brought over by a leave import (owner, 21 October 2026, of Zoho People's "Working from home" rows: "Yes, as approved
  // WFH days"): the import, which Undo removes it with; and its Zoho row's ZOHO_LINK_ID with the day, once only
  importId      String?          @map("import_id") @db.Uuid
  leaveImport   LeaveImport?     @relation(fields: [importId], references: [id], onDelete: Restrict)
  zohoLinkId    String?          @unique @map("zoho_link_id")

  @@index([employeeId, date])
  @@index([status])
  @@index([managerId])
  @@index([date])
  @@index([importId])
  @@map("wfh_requests")
}

// Each step of a work from home request, in the order taken (WFH_STEP_KINDS): leave's, and imported from Zoho People.
model WfhRequestStep {
  id           BigInt     @id @default(autoincrement())
  requestId    String     @map("request_id") @db.Uuid
  request      WfhRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind         String
  decision     String? // LEAVE_DECISIONS, on the stages' decisions only
  comment      String?
  actorId      String?    @map("actor_id") @db.Uuid
  actor        User?      @relation("WfhStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  onBehalfOfId String?    @map("on_behalf_of") @db.Uuid // a decision by a stand-in: the approver they stood in for (25 October 2026)
  onBehalfOf   Employee?  @relation("WfhStepOnBehalf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)
  at           DateTime   @default(now()) @db.Timestamptz

  @@index([requestId])
  @@map("wfh_request_steps")
}

// A compensatory day (owner, 26 October 2026: "my compensatory is a compensation with another day in the same month. and
// rarely to be compensated in cash"; packages/shared compensatory.ts): the day worked (a rest day of the shift or an
// official holiday) and the day off asked for in the same month, decided as a leave request is ("Manager, then HR": the
// same statuses, stages and steps), a C-level person's HR stage by the CEO. HR approves it as a day off (the default) or
// as cash instead, which adds "Compensation for working <day>" in days to the draft payroll of the month (adjustmentId)
// and needs no day off. A cash one recorded by HR has no day off.
model CompensatoryRequest {
  id            String             @id @default(uuid()) @db.Uuid
  employeeId    String             @map("employee_id") @db.Uuid
  employee      Employee           @relation("CompensatoryRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId  String             @map("employment_id") @db.Uuid
  employment    Employment         @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  dayWorked     DateTime           @map("day_worked") @db.Date
  dayOff        DateTime?          @map("day_off") @db.Date
  reason        String?
  status        String // LEAVE_STATUSES: with_manager, with_hr, approved, rejected, cancelled
  outcome       String? // COMPENSATORY_OUTCOMES: day_off, cash; set when approved (kept once cancelled)
  managerId     String?            @map("manager_id") @db.Uuid
  manager       Employee?          @relation("CompensatoryManager", fields: [managerId], references: [id], onDelete: Restrict)
  approverRole  String?            @map("approver_role") // APPROVER_ROLES, set exactly when managerId is
  rejectedStage String?            @map("rejected_stage") // LEAVE_STAGES: manager, hr
  rejectReason  String?            @map("reject_reason")
  recordedByHr  Boolean            @default(false) @map("recorded_by_hr")
  warnings      String[]           @default([]) // what HR recorded it past (a past day off, no check-in kept), as said then
  adjustmentId  String?            @unique @map("adjustment_id") @db.Uuid // cash instead: the addition on the month's payroll
  adjustment    PayrollAdjustment? @relation(fields: [adjustmentId], references: [id], onDelete: SetNull)
  // part of a rest day worked (owner, 27 October 2026: "Hours off for hours worked"): the hours worked (null: the whole
  // day), and the hours off they earn on the day off (null: a whole day off), by the Compensatory Setup's rules then
  hoursWorked   Decimal?           @map("hours_worked") @db.Decimal(4, 2)
  hoursOff      Decimal?           @map("hours_off") @db.Decimal(4, 2)
  // the official duty on a rest day or an official holiday it compensates (owner, 27 October 2026: "it should count in
  // the compensatories"; "One step"): asked, decided and cancelled with it
  odRequestId   String?            @unique @map("od_request_id") @db.Uuid
  odRequest     OdRequest?         @relation(fields: [odRequestId], references: [id], onDelete: Cascade)
  createdById   String?            @map("created_by") @db.Uuid
  createdBy     User?              @relation("CompensatoryCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  steps         CompensatoryStep[]

  @@index([employeeId, dayWorked])
  @@index([status])
  @@index([managerId])
  @@index([dayWorked])
  @@index([dayOff])
  @@map("compensatory_requests")
}

// Each step of a compensatory request, in the order taken: leave's (COMPENSATORY_STEP_KINDS).
model CompensatoryStep {
  id           BigInt              @id @default(autoincrement())
  requestId    String              @map("request_id") @db.Uuid
  request      CompensatoryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind         String
  decision     String? // LEAVE_DECISIONS, on the stages' decisions only
  comment      String?
  actorId      String?             @map("actor_id") @db.Uuid
  actor        User?               @relation("CompensatoryStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  onBehalfOfId String?             @map("on_behalf_of") @db.Uuid
  onBehalfOf   Employee?           @relation("CompensatoryStepOnBehalf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)
  at           DateTime            @default(now()) @db.Timestamptz

  @@index([requestId])
  @@map("compensatory_steps")
}

// An official duty, OD (owner, 23 October 2026: "Official duty (OD) requests. The plan has OD as a third attendance mode
// beside Office and WFH, needing an approved request"; packages/shared official-duty.ts): work for the company away from
// the office, a working day, not leave. One day or several in a row, a full day or part of one (from–to times, one day
// only), where and why; asked ahead or up to 3 days after ("Ahead or up to 3 days after"), `late` when asked after its
// first day; decided as a leave request is ("Manager, then HR": the same statuses, stages and steps), a C-level person's
// HR stage by the CEO. Approved, its days count as attended for its hours, and a press within it is taken from anywhere
// ("Check in from anywhere"), marked with it (AttendancePunch.odRequestId).
model OdRequest {
  id            String               @id @default(uuid()) @db.Uuid
  employeeId    String               @map("employee_id") @db.Uuid
  employee      Employee             @relation("OdRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId  String               @map("employment_id") @db.Uuid
  employment    Employment           @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  startDate     DateTime             @map("start_date") @db.Date
  endDate       DateTime             @map("end_date") @db.Date
  fullDay       Boolean              @default(true) @map("full_day")
  fromTime      DateTime?            @map("from_time") @db.Time(0) // part of a day only
  toTime        DateTime?            @map("to_time") @db.Time(0)
  place         String // where it is: free text
  reason        String
  late          Boolean              @default(false) // asked after its first day (Cairo)
  status        String // LEAVE_STATUSES: with_manager, with_hr, approved, rejected, cancelled
  managerId     String?              @map("manager_id") @db.Uuid
  manager       Employee?            @relation("OdManager", fields: [managerId], references: [id], onDelete: Restrict)
  approverRole  String?              @map("approver_role") // APPROVER_ROLES, set exactly when managerId is
  rejectedStage String?              @map("rejected_stage") // LEAVE_STAGES: manager, hr
  rejectReason  String?              @map("reject_reason")
  // recorded by HR (owner, 26 October 2026, asked what to add: "HR records it"): approved at once, past the 3-day limit
  // too, with what it was recorded past (`warnings`, as said then); or imported, history, from a leave import
  recordedByHr  Boolean              @default(false) @map("recorded_by_hr")
  warnings      String[]             @default([])
  createdById   String?              @map("created_by") @db.Uuid
  createdBy     User?                @relation("OdRequestCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  steps         OdRequestStep[]
  punches       AttendancePunch[]
  // on a rest day or an official holiday: its compensatory day (27 October 2026)
  compensatory  CompensatoryRequest?
  // brought over by a leave import (owner, 26 October 2026: "Import (template + Zoho)"): the import, which Undo removes it
  // with; and its Zoho row's ZOHO_LINK_ID, once only
  importId      String?              @map("import_id") @db.Uuid
  leaveImport   LeaveImport?         @relation(fields: [importId], references: [id], onDelete: Restrict)
  zohoLinkId    String?              @unique @map("zoho_link_id")

  @@index([employeeId, startDate])
  @@index([status])
  @@index([managerId])
  @@index([startDate, endDate])
  @@index([importId])
  @@map("od_requests")
}

// Each step of an official duty request, in the order taken (OD_STEP_KINDS), as a leave request's: each decision with its comment;
// recorded by HR, and imported (26 October 2026).
model OdRequestStep {
  id           BigInt    @id @default(autoincrement())
  requestId    String    @map("request_id") @db.Uuid
  request      OdRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind         String
  decision     String? // LEAVE_DECISIONS, on the stages' decisions only
  comment      String?
  actorId      String?   @map("actor_id") @db.Uuid
  actor        User?     @relation("OdStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  onBehalfOfId String?   @map("on_behalf_of") @db.Uuid // a decision by a stand-in: the approver they stood in for (25 October 2026)
  onBehalfOf   Employee? @relation("OdStepOnBehalf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)
  at           DateTime  @default(now()) @db.Timestamptz

  @@index([requestId])
  @@map("od_request_steps")
}

// Attendance files read on a draft payroll run (owner, 19 October 2026: attendance runs in Zoho People today, "Import
// Zoho now, replace it later"): Zoho's daily attendance entries, one file with everyone or many, kept until applied as
// each person's days (never an address: each check-in's place is kept as office or remote) and who HR matched them to.
// `people`: [{ key, zohoId, zohoName, days: ImportedDay[], pick: employee id | null, skipped, applied: [{ by, at }] }].
// `files`: [{ name, sheet, rows, people, months }]. Applying fills the run's lines and keeps the days (AttendanceDay).
model AttendanceImport {
  id          String          @id @default(uuid()) @db.Uuid
  runId       String          @map("run_id") @db.Uuid
  run         PayrollRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  month       DateTime        @db.Date // the run's month, its first day
  source      String          @default("zoho") // zoho: Zoho People's attendance entries
  files       Json
  people      Json
  createdById String?         @map("created_by") @db.Uuid
  createdBy   User?           @relation("AttendanceImportBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  appliedById String?         @map("applied_by") @db.Uuid
  appliedBy   User?           @relation("AttendanceImportAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  appliedAt   DateTime?       @map("applied_at") @db.Timestamptz // the last time it was applied
  days        AttendanceDay[]

  @@index([runId])
  @@map("attendance_imports")
}

// A day of someone's attendance (owner, 19 October 2026), kept so the system's own attendance can build on it later:
// the first check-in and the last check-out, what the day was by the system's rules (ATTENDANCE_DAY_STATUSES), Zoho's
// status as it said it, office or remote (never the address), Zoho's permission hours that day, and the hours it counts
// by the shift's rule. One a person, day and source: importing a month again replaces that month's Zoho days. Checking
// in on the system (owner, 19 October 2026: "Check-in through the system (phone or web with the office location check,
// or a device) to replace Zoho") keeps a day of source 'system' from the day's punches (AttendancePunch): its place may
// be 'unknown' (the location refused or unavailable), and `flags` says a check-in broke its work arrangement's rule
// (CHECK_IN_FLAGS: kept, never refused). 'device' is kept for a fingerprint or face device, not read yet. The day shown
// is the first of correction, system, device, zoho there is (packages/shared check-in.ts SOURCE_PRECEDENCE).
model AttendanceDay {
  id              String                @id @default(uuid()) @db.Uuid
  employeeId      String                @map("employee_id") @db.Uuid
  employee        Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime              @db.Date
  checkIn         DateTime?             @map("check_in") @db.Timestamptz
  checkOut        DateTime?             @map("check_out") @db.Timestamptz
  status          String // ATTENDANCE_DAY_STATUSES
  zohoStatus      String?               @map("zoho_status")
  place           String? // WORK_PLACES: office, remote; a check-in's day also home (its person's approved home, 20 October 2026) or unknown
  permissionHours Decimal?              @map("permission_hours") @db.Decimal(4, 2)
  hoursCounted    Decimal               @map("hours_counted") @db.Decimal(5, 2)
  source          String                @default("zoho")
  importId        String?               @map("import_id") @db.Uuid
  import          AttendanceImport?     @relation(fields: [importId], references: [id], onDelete: SetNull)
  importedById    String?               @map("imported_by") @db.Uuid
  importedBy      User?                 @relation("AttendanceDayImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  importedAt      DateTime              @default(now()) @map("imported_at") @db.Timestamptz
  flags           String[]              @default([]) // CHECK_IN_FLAGS, a 'system' day's: e.g. checked in outside the office on an office day
  // a correction approved (owner, 19 October 2026: "Attendance corrections with approval ("I forgot to check out")"):
  // a day of source 'correction' over the one it corrects, which stays as it was; the day it was applied over as it was
  // then (CorrectedFrom: its source, status, times and place; null: no day on record), and the last correction applied
  correctedFrom   Json?                 @map("corrected_from")
  correctionId    String?               @map("correction_id") @db.Uuid
  correction      AttendanceCorrection? @relation(fields: [correctionId], references: [id], onDelete: SetNull)
  // a day as the sum of its pairs (owner, 25 October 2026: "the working hours to be calculated between the checkin and
  // out only, not the first and last"): a day of the system's check-ins (or a correction's) keeps its check-in →
  // check-out pairs ([{ in, out }], moments ISO; null: not kept by pairs, as Zoho's days), the time between them within
  // the shift's window in minutes, and the moment of a last check-in without a check-out (null: none)
  pairs           Json?
  breakMinutes    Int?                  @map("break_minutes")
  openAt          DateTime?             @map("open_at") @db.Timestamptz
  // a Zoho day kept by a fetch from Zoho People's API (owner, 25 October 2026: "Yes, daily + backfill"), not by an Excel
  // import: which run kept it last. Its pairs are Zoho's entries; a draft payroll line is filled from such days.
  zohoRunId       String?               @map("zoho_run_id") @db.Uuid
  zohoRun         ZohoPeopleRun?        @relation(fields: [zohoRunId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date, source])
  @@index([date])
  @@map("attendance_days")
}

// A period exempt from check-in (owner, 25 October 2026: "allow me to select people that are not eligable for
// attendance checkins and outs, trat them as if they achived their full working hours"; asked, "Optional check-in" and
// "Profile + a list in Check-in Setup"): a person's working days from start_date to end_date (null: no end) count as
// full hours, their presses kept for reference only (packages/shared check-in-exemptions.ts). Added by HR, an Admin or
// a Super Admin with a reason (a C-level person's by the CEO or a Super Admin), several at once from Check-in Setup;
// ended by "End now" (end_date today, ended_by, ended_at); one not started yet is cancelled instead (cancelled_at, kept,
// never read: it never applied, and only a Super Admin deletes records). One person's periods never overlap, the
// cancelled ones left out (the API checks). Every change is audited.
model CheckInExemption {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason      String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdById String?   @map("created_by") @db.Uuid
  createdBy   User?     @relation("CheckInExemptionAddedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  endedById   String?   @map("ended_by") @db.Uuid
  endedBy     User?     @relation("CheckInExemptionEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz

  @@index([employeeId, startDate])
  @@map("check_in_exemptions")
}

// An attendance correction (owner, 19 October 2026, "Proceed with those": "Attendance corrections with approval ("I
// forgot to check out")"): a day of someone's attendance asked to be corrected, under the employment the day is in;
// what was wrong (CORRECTION_KINDS), the right check-in and check-out as moments (null: as on record), why (required),
// the day as it was shown when asked (dayBefore), decided as leave is (LEAVE_STATUSES) by the direct manager (else the
// team lead, else the department's head: approverRole) then HR, a C-level person's HR stage by the CEO; recorded by HR
// directly, approved at once. Approved (appliedAt), the day is kept as source 'correction' over the one it corrects
// (packages/shared attendance-corrections.ts), and the month's draft payroll line refilled.
model AttendanceCorrection {
  id            String                     @id @default(uuid()) @db.Uuid
  employeeId    String                     @map("employee_id") @db.Uuid
  employee      Employee                   @relation("AttendanceCorrectionRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId  String                     @map("employment_id") @db.Uuid
  employment    Employment                 @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  date          DateTime                   @db.Date
  kind          String // CORRECTION_KINDS
  checkIn       DateTime?                  @map("check_in") @db.Timestamptz
  checkOut      DateTime?                  @map("check_out") @db.Timestamptz
  reason        String
  dayBefore     Json?                      @map("day_before") // the day as shown when asked: { status, checkIn, checkOut, place, source }; null: none on record
  status        String // LEAVE_STATUSES: with_manager, with_hr, approved, rejected, cancelled
  managerId     String?                    @map("manager_id") @db.Uuid
  manager       Employee?                  @relation("AttendanceCorrectionManager", fields: [managerId], references: [id], onDelete: Restrict)
  approverRole  String?                    @map("approver_role") // APPROVER_ROLES, set exactly when managerId is
  rejectedStage String?                    @map("rejected_stage") // LEAVE_STAGES: manager, hr
  rejectReason  String?                    @map("reject_reason")
  recordedByHr  Boolean                    @default(false) @map("recorded_by_hr")
  appliedAt     DateTime?                  @map("applied_at") @db.Timestamptz // when its approval changed the day
  createdById   String?                    @map("created_by") @db.Uuid
  createdBy     User?                      @relation("AttendanceCorrectionCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  steps         AttendanceCorrectionStep[]
  days          AttendanceDay[] // the corrected day it was applied to last

  @@index([employeeId, date])
  @@index([status])
  @@index([managerId])
  @@map("attendance_corrections")
}

// Each step of an attendance correction, in the order taken (LEAVE_STEP_KINDS), as a leave request's.
model AttendanceCorrectionStep {
  id           BigInt               @id @default(autoincrement())
  correctionId String               @map("correction_id") @db.Uuid
  correction   AttendanceCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  kind         String
  decision     String? // LEAVE_DECISIONS, on the stages' decisions only
  comment      String?
  actorId      String?              @map("actor_id") @db.Uuid
  actor        User?                @relation("AttendanceCorrectionStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  onBehalfOfId String?              @map("on_behalf_of") @db.Uuid // a decision by a stand-in: the approver they stood in for (25 October 2026)
  onBehalfOf   Employee?            @relation("CorrectionStepOnBehalf", fields: [onBehalfOfId], references: [id], onDelete: SetNull)
  at           DateTime             @default(now()) @db.Timestamptz

  @@index([correctionId])
  @@map("attendance_correction_steps")
}

// A press of Check in or Check out on the system (owner, 19 October 2026: "Check-in through the system (phone or web
// with the office location check …)"): the working day it counts on (check-in.ts shiftDayOf), in or out, the server's
// moment (never the device's), where it was (CHECK_IN_PLACES: office, home, remote, unknown; never the coordinates, which
// are read and dropped), the reading's accuracy in metres, where the work arrangement expected them that day (office or
// anywhere) and the flags of a check-in that broke it. Several a day: the day's check-in is the first in, its check-out
// the last out (AttendanceDay, source 'system'). Who pressed (the employee, or a Super Admin acting as them).
model AttendancePunch {
  id             String     @id @default(uuid()) @db.Uuid
  employeeId     String     @map("employee_id") @db.Uuid
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime   @db.Date
  kind           String // PUNCH_KINDS: in, out
  at             DateTime   @default(now()) @db.Timestamptz
  place          String // CHECK_IN_PLACES
  accuracyMetres Int?       @map("accuracy_metres")
  // where it was pressed (owner, 20 October 2026: "Yes, keep the spot"), read only then, never tracked: 6 decimals, both
  // or neither; none from before, nor without a reading. Seen by HR, the CEO, the Super Admin and the employee only
  // (packages/shared punch-location.ts); never in the audit log
  latitude       Decimal?   @db.Decimal(9, 6)
  longitude      Decimal?   @db.Decimal(9, 6)
  expected       String // office, anywhere
  flags          String[]   @default([])
  // the check-in location it was within (owner, 20 October 2026: "Own page, several locations"), by its name then, and the
  // office network it came from, by its name (check-ins locked to the office network, 20 October 2026); never the
  // address
  locationName   String?    @map("location_name")
  // within a client location or the person's remote site (24 October 2026: "Client · Acme", "Remote site · Flat"); null
  // otherwise (a sub-location, the main office, none)
  locationKind   String?    @map("location_kind")
  officeNetwork  String?    @map("office_network")
  // pressed within an approved official duty (owner, 23 October 2026: "Check in from anywhere"): its request; the office's
  // location rule and network lock didn't apply to it
  odRequestId    String?    @map("od_request_id") @db.Uuid
  odRequest      OdRequest? @relation(fields: [odRequestId], references: [id], onDelete: SetNull)
  source         String     @default("system") // system; device for a fingerprint or face device, later
  userId         String?    @map("user_id") @db.Uuid
  user           User?      @relation("AttendancePunchBy", fields: [userId], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@map("attendance_punches")
}

// An attendance record removed by a Super Admin (owner, 31 October 2026: "is there a way to check the checkin records?
// even if imported from zoho and delete one of them?" — "as a super admin"; chose "Stays removed"): a check-in or a
// check-out, of the system's presses (the press moved here whole, `punch`, so Restore puts it back as it was) or of a
// Zoho day (its moment and kind: the nightly fetch and an import leave it out while removed). The reason, who and when;
// restored: when and by whom (the row kept). Never in a month whose payroll is with the CEO, approved or paid.
model AttendanceRecordRemoval {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  source       String // system, zoho
  kind         String // in, out
  at           DateTime  @db.Timestamptz
  punch        Json? // the system's press as it was (every column), put back on Restore; null for Zoho's
  reason       String
  removedById  String?   @map("removed_by") @db.Uuid
  removedBy    User?     @relation("AttendanceRecordRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  removedAt    DateTime  @default(now()) @map("removed_at") @db.Timestamptz
  restoredById String?   @map("restored_by") @db.Uuid
  restoredBy   User?     @relation("AttendanceRecordRestoredBy", fields: [restoredById], references: [id], onDelete: SetNull)
  restoredAt   DateTime? @map("restored_at") @db.Timestamptz

  @@index([employeeId, date])
  @@map("attendance_record_removals")
}

// Which source a day uses when it has both Zoho's and the system's (owner, 31 October 2026: "Pick which source counts",
// "zoho or system"), chosen by a Super Admin with a reason, over the usual order (a correction, the system's, a device's,
// Zoho's: packages/shared check-in.ts SOURCE_PRECEDENCE) for that one day; a correction still applies over the day
// chosen. Back to the usual order: the row removed (the audit log keeps every choice).
model AttendanceDaySource {
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  source     String // DAY_SOURCE_CHOICES: zoho, system
  reason     String
  chosenById String?  @map("chosen_by") @db.Uuid
  chosenBy   User?    @relation("AttendanceDaySourceChosenBy", fields: [chosenById], references: [id], onDelete: SetNull)
  chosenAt   DateTime @default(now()) @map("chosen_at") @db.Timestamptz

  @@id([employeeId, date])
  @@map("attendance_day_sources")
}

// A home location asked for (owner, 20 October 2026: "allow other users to request to add their home locations when
// working from home"; then "Label Home, flag elsewhere" and "then approved by the HR and CEO"): by anyone with an employee
// profile, its point (6 decimals) and radius (100 m to start with; HR may change it within 20 to 5,000), and a label or
// address if they give one; decided by HR, then the CEO (a C-level person's: both by the CEO). Approved, it is the
// person's home: a check-in within its radius is Home, a remote one elsewhere flagged (packages/shared check-in.ts). One
// approved a person (a newly approved one replaces it: 'replaced') and one being decided at a time, both kept under the
// employee's row lock. The point and the label are personal data, kept only while it is being decided or in force: once
// rejected, withdrawn, replaced or removed they are deleted (null), the request and its steps kept without them. Never in
// the audit log, nor on a punch or a day. HOME_STATUSES and the rules: packages/shared home-locations.ts.
model HomeLocationRequest {
  id             String             @id @default(uuid()) @db.Uuid
  employeeId     String             @map("employee_id") @db.Uuid
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  latitude       Decimal?           @db.Decimal(9, 6) // null once rejected, withdrawn, replaced or removed
  longitude      Decimal?           @db.Decimal(9, 6)
  radiusMetres   Int                @default(100) @map("radius_metres") // 20 to 5,000; HR's step may change it
  label          String? // up to 200 characters, e.g. "Home, Nasr City"; null once no longer decided or in force
  accuracyMetres Int?               @map("accuracy_metres") // the reading's accuracy when the point came from the device; null when picked on the map
  status         String // HOME_STATUSES: with_hr, with_ceo, approved, rejected, withdrawn, replaced, removed
  rejectedStage  String?            @map("rejected_stage") // HOME_STAGES: hr, ceo
  rejectReason   String?            @map("reject_reason")
  approvedAt     DateTime?          @map("approved_at") @db.Timestamptz // the CEO's approval: in force from then
  endedAt        DateTime?          @map("ended_at") @db.Timestamptz // rejected, withdrawn, replaced or removed
  createdById    String?            @map("created_by") @db.Uuid
  createdBy      User?              @relation("HomeLocationCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  steps          HomeLocationStep[]
  // requested check-in locations (owner, 24 October 2026: "(Home Location - Remote Site - Client Location) with a comment
  // reason"; packages/shared home-locations.ts): its type (home, remote_site, client), the label its name (a remote site's
  // or a client location's required), the employee's reason (required since; none on those of before) and the end date
  // they wished (a remote site or a client location). Its validity, set at HR's step and changed later by HR: until_date
  // (valid_until), contract (the current employment's signed contract's end, read each time), or no_end (a client
  // location, and the homes approved before, so they go on working as they did). A client location approved by the CEO is
  // a company check-in location (location_id). The notice 7 days before an end that is a date told on ending_notice_on
  type           String             @default("home")
  reason         String?
  wishedEndDate  DateTime?          @map("wished_end_date") @db.Date
  validity       String?
  validUntil     DateTime?          @map("valid_until") @db.Date
  endingNoticeOn DateTime?          @map("ending_notice_on") @db.Date
  locationId     String?            @map("location_id") @db.Uuid
  location       CheckInLocation?   @relation("HomeLocationCompanyPlace", fields: [locationId], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([status])
  @@map("home_location_requests")
}

// Each step of a home location request, in the order taken (HOME_STEP_KINDS), as a correction's: who, when, the decision
// and its comment; the radius as sent and as HR approved it. Never the point.
model HomeLocationStep {
  id           BigInt              @id @default(autoincrement())
  requestId    String              @map("request_id") @db.Uuid
  request      HomeLocationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind         String
  decision     String? // HOME_DECISIONS, on hr_decision and ceo_decision only
  radiusMetres Int?                @map("radius_metres") // submitted: as asked; hr_decision approve: as HR set it
  comment      String?
  actorId      String?             @map("actor_id") @db.Uuid
  actor        User?               @relation("HomeLocationStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  at           DateTime            @default(now()) @db.Timestamptz

  @@index([requestId])
  @@map("home_location_steps")
}

// A request's documents (a medical certificate, proof of sitting the exam): photos or PDFs, kept like the employee file.
model LeaveDocument {
  id         String       @id @default(uuid()) @db.Uuid
  requestId  String       @map("request_id") @db.Uuid
  request    LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName   String       @map("file_name")
  mimeType   String       @map("mime_type")
  sizeBytes  Int          @map("size_bytes")
  data       Bytes
  uploadedAt DateTime     @default(now()) @map("uploaded_at") @db.Timestamptz

  @@index([requestId])
  @@map("leave_documents")
}

// An employment's annual leave for a calendar year, once there is something to keep: the days carried in from the year
// before (as its Year Closing decided; by the year each was earned in, for the three years' rule of Art. 125), and how
// it was closed: at the Year Closing (the days unused, carried into the next year and paid, at the day rate then) or on
// leaving (the days unused paid with the final settlement). What is paid is an Unused leave paid addition.
model LeaveBalanceYear {
  id                 String             @id @default(uuid()) @db.Uuid
  employeeId         String             @map("employee_id") @db.Uuid
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId       String             @map("employment_id") @db.Uuid
  employment         Employment         @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  year               Int
  carriedIn          Decimal            @default(0) @map("carried_in") @db.Decimal(5, 1)
  carriedInByYear    Json               @default("{}") @map("carried_in_by_year") // { "2025": 4 }: by the year each day was earned in
  closedAt           DateTime?          @map("closed_at") @db.Timestamptz
  closedById         String?            @map("closed_by") @db.Uuid
  closedBy           User?              @relation("LeaveBalanceClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedOn           String?            @map("closed_on") // year_closing, leaving
  unused             Decimal?           @db.Decimal(5, 1) // at the closing
  carriedOut         Decimal?           @map("carried_out") @db.Decimal(5, 1)
  paidOut            Decimal?           @map("paid_out") @db.Decimal(5, 1)
  dayRate            Decimal?           @map("day_rate") @db.Decimal(12, 2) // RESTRICTED: the gross ÷ the payroll's day divisor, at the closing
  payoutAdjustmentId String?            @unique @map("payout_adjustment_id") @db.Uuid
  payoutAdjustment   PayrollAdjustment? @relation(fields: [payoutAdjustmentId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([employmentId, year])
  @@index([employeeId])
  @@map("leave_balance_years")
}

// HR's change to an employment's annual leave balance for a year: days more or fewer (whole or half), and why.
model LeaveAdjustment {
  id           String       @id @default(uuid()) @db.Uuid
  employeeId   String       @map("employee_id") @db.Uuid
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId String       @map("employment_id") @db.Uuid
  employment   Employment   @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  year         Int
  days         Decimal      @db.Decimal(5, 1)
  reason       String
  createdById  String?      @map("created_by") @db.Uuid
  createdBy    User?        @relation("LeaveAdjustmentBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  // an opening balance from a leave import (owner, 21 October 2026): the import, which Undo removes it with
  importId     String?      @map("import_id") @db.Uuid
  leaveImport  LeaveImport? @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@index([employmentId, year])
  @@index([importId])
  @@map("leave_adjustments")
}

// A leave file imported (owner, 21 October 2026: "how to import bulk leaves?"; asked, he chose "Both": the leave already
// taken and each person's balance, and "Our Excel template"; Zoho People's leave export is read too): the file as it was
// uploaded, its fingerprint (the same file again is told: "make sure there will be no duplicates from the previous
// imported files"), where it comes from (LEAVE_IMPORT_SOURCES), its rows as read, who each person of it is (HR's choices),
// a Zoho file's leave types as HR mapped them, and when it was applied and undone last. What it made is on the leave and
// the balance changes themselves (their importId); Undo removes them, and only then may a Super Admin delete it.
// `rows`: [{ sheet, row, personKey, … applied }]; `people`: [{ key, code, name, zohoId, pick, skipped }]; `typeMap`:
// { "<Zoho type>": type id | "skip" }.
model LeaveImport {
  id          String            @id @default(uuid()) @db.Uuid
  fileName    String            @map("file_name")
  fileHash    String            @map("file_hash") // SHA-256 of the file's content
  fileData    Bytes             @map("file_data")
  source      String // LEAVE_IMPORT_SOURCES: template, zoho
  rows        Json
  people      Json
  typeMap     Json              @default("{}") @map("type_map")
  createdById String?           @map("created_by") @db.Uuid
  createdBy   User?             @relation("LeaveImportBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  appliedById String?           @map("applied_by") @db.Uuid
  appliedBy   User?             @relation("LeaveImportAppliedBy", fields: [appliedById], references: [id], onDelete: SetNull)
  appliedAt   DateTime?         @map("applied_at") @db.Timestamptz // the last time it was applied
  undoneById  String?           @map("undone_by") @db.Uuid
  undoneBy    User?             @relation("LeaveImportUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)
  undoneAt    DateTime?         @map("undone_at") @db.Timestamptz // once nothing it made is left
  leaves      LeaveRequest[]
  adjustments LeaveAdjustment[]
  wfhDays     WfhRequest[]
  odRequests  OdRequest[] // official duty rows brought over (26 October 2026)

  @@index([fileHash])
  @@map("leave_imports")
}

// A year whose annual leave balances HR closed (owner, 18 October 2026: "make it with decision with the year closing"):
// when and by whom. HR may reopen it until what it paid is applied to a payroll.
model LeaveYearClosing {
  year       Int      @id
  closedAt   DateTime @default(now()) @map("closed_at") @db.Timestamptz
  closedById String?  @map("closed_by") @db.Uuid
  closedBy   User?    @relation("LeaveYearClosingBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@map("leave_year_closings")
}

// ---------- KPIs ----------
// The owner, 21 October 2026: "lets start with the KPI's First", then "Full framework per role" (four pillars with fixed
// weights; every job title a template of metrics built from its JD, each with a criteria scale, one criterion picked a
// month), "Self, manager, HR, sign-off", "Attendance: Yes, as the sheet", "Last month's KPI, this pay", "As the sheet:
// full at 80%+" and "Templates: HR". The rules: packages/shared kpis.ts; the module: apps/api/src/kpis.

// The KPI settings (one row, id 1): the days of the next month each step of a month's scorecard is due by: the
// self-rating by the 3rd, the manager's scoring by the 6th, HR's calibration by the 8th, the sign-off by the 10th. A
// reminder goes the day before each; a missed self-rating is noted and the manager goes on, and a scorecard not signed
// by the sign-off day is final anyway. HR (or a Super Admin) changes them. And Attendance in the KPI (owner, 25 October
// 2026: "Fixed cut only"): whether the Attendance metric counts in the KPI, off from then, so attendance is cut on the
// fixed part of the pay only; the scorecards not final follow it (kpi_scorecards.attendance_counted).
model KpiSettings {
  id              Int      @id @default(1) // always 1
  selfRatingDay   Int      @default(3) @map("self_rating_day")
  managerDay      Int      @default(6) @map("manager_day")
  hrDay           Int      @default(8) @map("hr_day")
  signOffDay      Int      @default(10) @map("sign_off_day")
  attendanceInKpi Boolean  @default(false) @map("attendance_in_kpi")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedById     String?  @map("updated_by") @db.Uuid
  updatedBy       User?    @relation("KpiSettingsBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("kpi_settings")
}

// A version of the KPI framework (owner, 21 October 2026: "am i able to edit the pillars of the KPIs?", "Fully
// flexible"; packages/shared kpi-framework.ts): its pillars, in order, [{ key, name, short, weight }] (1 to 8, the
// weights adding up to 100), the key of the pillar the Attendance metric counts in, and the first month whose
// scorecards it scores (applies_from, the 1st of it: they open on the 1st of the month after). The one in force is the
// newest whose month's scorecards have opened; the next (one at most, from this month on) is changed until then. The
// migration made version 1, the plan's four pillars, in force. Template versions keep the pillars they were published
// with, so a framework never changes a scorecard.
// By department (owner, 22 October 2026: "but i need pillars to each department"), and by team ("Yes, add team
// pillars"): a version is the company's (no department) or a department's or a team's own, numbered and dated within
// its department or team as the company's are (the unique indexes are NULLS NOT DISTINCT in the SQL: the company's count
// as one); a department's or team's version may take it back to the level above's pillars from its month (a team its
// department's, a department the company's; follows_company: no pillars, no Attendance pillar). Gone with it.
model KpiFramework {
  id               String        @id @default(uuid()) @db.Uuid
  departmentId     String?       @map("department_id") @db.Uuid // a department's or team's own; none: the company's
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  followsCompany   Boolean       @default(false) @map("follows_company") // a department's: the company's pillars again from its month
  version          Int // 1, 2 … the company's, or each department's own
  appliesFrom      DateTime      @map("applies_from") @db.Date // the 1st of its first scorecard month
  pillars          Json // [{ key, name, short, weight }], in order; [] when it follows the company's
  attendancePillar String        @map("attendance_pillar") // the key of the Attendance metric's pillar; '' when it follows the company's
  createdById      String?       @map("created_by") @db.Uuid
  createdBy        User?         @relation("KpiFrameworkCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedById      String?       @map("updated_by") @db.Uuid
  updatedBy        User?         @relation("KpiFrameworkChange", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  templates        KpiTemplate[] // the template versions published with its pillars

  @@unique([departmentId, version])
  @@unique([departmentId, appliesFrom])
  @@map("kpi_frameworks")
}

// A version of a job title's KPI template: its metrics and the Attendance metric's points. HR edits a draft (one a job
// title at most) and publishes it; a published version is never changed, and the scorecards opened from the 1st of the
// month after it was published use it (opens_from), each keeping the version it opened with. The versions stay, as its
// history. Only a Super Admin deletes a draft.
// Its pillars (owner, 21 October 2026: "Fully flexible"): a published version keeps those of the KPI framework it was
// published with (framework_id; pillars and attendance_pillar, a copy), and its scorecards are scored with them; it
// opens no earlier than that framework's first month's scorecards. A draft keeps the pillars its metrics were written
// for (the framework's when saved, a copied version's, the plan's four for a sample or a role of the library), and is
// placed in the newest framework's by name when opened and published.
model KpiTemplate {
  id               String         @id @default(uuid()) @db.Uuid
  jobTitleId       String         @map("job_title_id") @db.Uuid
  jobTitle         JobTitle       @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  version          Int // 1, 2 … a job title's own, the draft's the next
  status           String // draft, published
  attendancePoints Int            @default(20) @map("attendance_points") // the automatic Attendance metric's points, in its pillar (attendance_pillar)
  opensFrom        DateTime?      @map("opens_from") @db.Date // published: the 1st of the month after it was published (or its framework's first opening), from which scorecards open with it
  publishedAt      DateTime?      @map("published_at") @db.Timestamptz
  publishedById    String?        @map("published_by") @db.Uuid
  publishedBy      User?          @relation("KpiTemplatePublication", fields: [publishedById], references: [id], onDelete: SetNull)
  createdById      String?        @map("created_by") @db.Uuid
  createdBy        User?          @relation("KpiTemplateCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  frameworkId      String?        @map("framework_id") @db.Uuid // published: the KPI framework it was published with
  framework        KpiFramework?  @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  pillars          Json // its pillars, [{ key, name, short, weight }], in order
  attendancePillar String         @map("attendance_pillar") // the key of the Attendance metric's pillar
  ownWeights       Json?          @map("own_weights") // its job title's own weights for its pillars, { key: weight } (22 October 2026); none: its department's
  metrics          KpiMetric[]
  scorecards       KpiScorecard[]

  @@unique([jobTitleId, version])
  @@index([jobTitleId, status])
  @@index([frameworkId])
  @@map("kpi_templates")
}

// A metric of a template version, in its order: its pillar (the key of one of its version's pillars; a draft's in
// Unplaced: none, with the name of the pillar it was in), name, definition, how it's measured, the
// JD duty it is linked to (its words, as the duty rows are read again from the JD when it changes), the points that count
// as its target, and its criteria scale, [{ label, points }], one picked a month (by its index).
model KpiMetric {
  id           String      @id @default(uuid()) @db.Uuid
  templateId   String      @map("template_id") @db.Uuid
  template     KpiTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  position     Int
  pillar       String? // a key of its version's pillars; none: in Unplaced (a draft's only)
  wasIn        String?     @map("was_in") // in Unplaced: the name of the pillar it was in
  name         String
  definition   String?
  howMeasured  String?     @map("how_measured")
  jdDuty       String?     @map("jd_duty") // before 25 October 2026 its one duty; since, its first (none: NULL)
  jdDuties     String[]    @default([]) @map("jd_duties") // its duties (owner, 25 October 2026: "Yes, several duties"); none kept before: jd_duty's
  targetPoints Int         @map("target_points")
  criteria     Json
  scores       KpiScore[]

  @@unique([templateId, position])
  @@map("kpi_metrics")
}

// A person's KPI scorecard for a month (its first day), opened on the 1st of the next month under their employment's
// job title's template in force then (kept: the version it opened with), and where they worked. Its steps: the
// employee's self-rating, the scoring (by the manager in charge kept in manager_id; HR when nobody is in charge; the CEO
// for a C-level person; a Super Admin for the CEO's own: KPI_SCORERS), HR's calibration (after a manager's scoring
// only), the sign-off by the employee and the manager, then final and locked. The automatic Attendance metric's points
// achieved, from the month's attendance score as payroll works it out, refreshed until it is scored. The score (final %,
// level, the pillars) is the manager's picks', calibrated, kept for the lists; the payroll of the next month reads the
// final % of a final one. reminders_sent: the steps whose reminder (the day before their deadline) went.
// A practice one (owner, 22 October 2026: "i want to test the KPI's .. and it is locked to dates", "Practice
// scorecards"; packages/shared kpi-practice.ts): started by HR or a Super Admin (practice_by, practice_at) for anyone and
// any month, on a draft or a published version; no deadline moves it on, nobody is told, and it never reaches payroll,
// the reports or the exports. One real scorecard a person and month: a partial unique index (the migration's
// "kpi_scorecards_one_real_a_month", WHERE NOT practice), so practice ones never stand in the way of the real opening.
model KpiScorecard {
  id                  String             @id @default(uuid()) @db.Uuid
  employeeId          String             @map("employee_id") @db.Uuid
  employee            Employee           @relation("KpiScorecardOf", fields: [employeeId], references: [id], onDelete: Cascade)
  employmentId        String             @map("employment_id") @db.Uuid
  employment          Employment         @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  month               DateTime           @db.Date
  templateId          String             @map("template_id") @db.Uuid
  template            KpiTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  departmentId        String?            @map("department_id") @db.Uuid
  department          Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status              String // KPI_STATUSES: self_rating, manager, hr, sign_off, final
  scorer              String // KPI_SCORERS: manager, hr, ceo, super_admin
  managerId           String?            @map("manager_id") @db.Uuid // scorer manager: the person in charge when it opened
  manager             Employee?          @relation("KpiScorecardManager", fields: [managerId], references: [id], onDelete: Restrict)
  approverRole        String?            @map("approver_role") // APPROVER_ROLES, set exactly when manager_id is
  attendanceRatio     Decimal?           @map("attendance_ratio") @db.Decimal(8, 4)
  attendanceScore     Decimal?           @map("attendance_score") @db.Decimal(8, 4)
  attendanceAchieved  Int                @map("attendance_achieved")
  attendanceSource    String             @map("attendance_source") // payroll, attendance, none
  attendanceCounted   Boolean            @default(true) @map("attendance_counted") // the Attendance metric counts in its score (25 October 2026: the setting while not final, kept once final)
  selfComment         String?            @map("self_comment")
  selfSubmittedAt     DateTime?          @map("self_submitted_at") @db.Timestamptz
  selfMissed          Boolean            @default(false) @map("self_missed")
  managerComment      String?            @map("manager_comment")
  scoredAt            DateTime?          @map("scored_at") @db.Timestamptz
  scoredById          String?            @map("scored_by") @db.Uuid
  scoredBy            User?              @relation("KpiScorecardScoredBy", fields: [scoredById], references: [id], onDelete: SetNull)
  hrComment           String?            @map("hr_comment")
  calibratedAt        DateTime?          @map("calibrated_at") @db.Timestamptz
  calibratedById      String?            @map("calibrated_by") @db.Uuid
  calibratedBy        User?              @relation("KpiScorecardCalibratedBy", fields: [calibratedById], references: [id], onDelete: SetNull)
  employeeSignedAt    DateTime?          @map("employee_signed_at") @db.Timestamptz
  employeeSignComment String?            @map("employee_sign_comment")
  managerSignedAt     DateTime?          @map("manager_signed_at") @db.Timestamptz
  managerSignedById   String?            @map("manager_signed_by") @db.Uuid
  managerSignedBy     User?              @relation("KpiScorecardManagerSignedBy", fields: [managerSignedById], references: [id], onDelete: SetNull)
  managerSignComment  String?            @map("manager_sign_comment")
  finalAt             DateTime?          @map("final_at") @db.Timestamptz
  finalPercent        Decimal?           @map("final_percent") @db.Decimal(5, 1)
  level               String? // KPI_LEVELS
  pillars             Json? // its template version's pillars' percents by their keys, { "delivery": 92.5, … }, with the final %
  remindersSent       String[]           @default([]) @map("reminders_sent") // KPI_REMINDERS sent
  practice            Boolean            @default(false) // a practice scorecard (22 October 2026): not counted anywhere
  practiceById        String?            @map("practice_by") @db.Uuid // practice: who started it
  practiceBy          User?              @relation("KpiScorecardPracticeBy", fields: [practiceById], references: [id], onDelete: SetNull)
  practiceAt          DateTime?          @map("practice_at") @db.Timestamptz // practice: when it was started
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  scores              KpiScore[]
  steps               KpiScorecardStep[]

  @@index([employeeId, month])
  @@index([month])
  @@index([status])
  @@index([managerId])
  @@index([templateId])
  @@map("kpi_scorecards")
}

// A metric's picks on a scorecard (one row a metric of its version): the employee's, the manager's, each with its
// comment, and HR's calibration of the manager's pick with its reason; a criterion by its index.
model KpiScore {
  scorecardId    String       @map("scorecard_id") @db.Uuid
  scorecard      KpiScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  metricId       String       @map("metric_id") @db.Uuid
  metric         KpiMetric    @relation(fields: [metricId], references: [id], onDelete: Restrict)
  selfChoice     Int?         @map("self_choice")
  selfComment    String?      @map("self_comment")
  managerChoice  Int?         @map("manager_choice")
  managerComment String?      @map("manager_comment")
  hrChoice       Int?         @map("hr_choice")
  hrReason       String?      @map("hr_reason")

  @@id([scorecardId, metricId])
  @@index([metricId])
  @@map("kpi_scores")
}

// A step of a scorecard, logged on it in the order taken (KPI_STEP_KINDS), in the transaction the step is taken in:
// who (none: the system, on its deadline) and their comment. On a practice scorecard, for whom its starter or a Super
// Admin stood in (KPI_STAND_INS: the employee, the scorer's side, HR; 22 October 2026), the step being theirs.
model KpiScorecardStep {
  id          BigInt       @id @default(autoincrement())
  scorecardId String       @map("scorecard_id") @db.Uuid
  scorecard   KpiScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  kind        String
  comment     String?
  actorId     String?      @map("actor_id") @db.Uuid
  actor       User?        @relation("KpiScorecardStepActor", fields: [actorId], references: [id], onDelete: SetNull)
  stoodInFor  String?      @map("stood_in_for") // a practice scorecard's step taken standing in: employee, scorer, hr
  at          DateTime     @default(now()) @db.Timestamptz

  @@index([scorecardId])
  @@map("kpi_scorecard_steps")
}

// ---------- assets (owner, 21 October 2026: "i want to add this module with a special permission to the system") ----------
// The studio's assets, who holds them, their counts and their values, from the owner's "Asset Register" spec, built the
// People System's way ("use the main ERP system specs .. dont stick to the MD file"): the system's employees, users,
// audit log and file storage. The whole data model of the module's five steps, made at once in step 1 so the later steps
// don't change it much: the register (step 1), custody (step 3), kits, stock, repairs and disposal (step 4), counts and
// labels (step 5). The rules: packages/shared assets.ts; the module: apps/api/src/assets. Who may do what is each user's
// Assets access (users.assets_access: none, viewer, custodian, manager; a Super Admin always a manager); the values (the
// purchase cost, supplier and invoice, market value, disposal amounts, a custody item's value) are the CEO's, Finance's
// and a Super Admin's only ("CEO and Finance"). All money in EGP, numeric(14,2).

// The asset settings (one row, id 1): the capitalization threshold, under which an asset is Expensed (its book value 0).
model AssetSettings {
  id                      Int      @id @default(1) // always 1
  capitalizationThreshold Decimal  @default(0) @map("capitalization_threshold") @db.Decimal(14, 2)
  // the terms printed on the custody forms (step 3), as an Assets manager wrote them; none: the standard wording
  // (packages/shared custody.ts CUSTODY_TERMS_STANDARD). Each record keeps the terms it was printed with.
  custodyTerms            String[] @default([]) @map("custody_terms")
  // the Arabic terms printed beside them (owner, 24 October 2026: "Arabic and English"); none: the standard Arabic
  // wording while the English terms are the standard ones, else none (packages/shared custody.ts custodyTermsArOf)
  custodyTermsAr          String[] @default([]) @map("custody_terms_ar")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  updatedById             String?  @map("updated_by") @db.Uuid
  updatedBy               User?    @relation("AssetSettingsBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("asset_settings")
}

// A room an asset is kept in (the spec's "locations"): Studio A, the storeroom, Office 2 … Called rooms so they don't
// clash with Check-in Setup's check-in locations. Archived: no longer offered, kept on the assets and counts that name it.
// Its name is unique whatever its case. Only a Super Admin deletes one, and only while no asset or count names it.
model AssetRoom {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  notes      String?
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  assets     Asset[]
  counts     AssetCount[]

  @@map("asset_rooms")
}

// A production kit (spec §2.3: PK-KIT-A, PK-KIT-B …): production kit assets packed together, handed over and counted as
// one. Its code never changes and is never given again.
model AssetKit {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  notes       String?
  createdById String?      @map("created_by") @db.Uuid
  createdBy   User?        @relation("AssetKitCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  assets      Asset[]
  counts      AssetCount[]

  @@map("asset_kits")
}

// The last number given for each code prefix (spec §2.3): an asset's group and type ("PK-CAM-"), the kits ("PK-KIT-"),
// the custody records ("CUS-"). Raised in the transaction that gives the code (INSERT … ON CONFLICT … RETURNING), so two
// people saving at once never get the same number; never lowered, so a number is never given again.
model AssetCodeCounter {
  prefix String @id
  last   Int

  @@map("asset_code_counters")
}

// An asset (spec §2–3): its code, never changed; its group (how it is managed), type and accounting class; what it is;
// where it stands (its status: custody only through a custody record, with its holder; a consumable always available,
// kept by quantity); its room and, for a production kit asset, its kit; when it was bought and its useful life, the
// warranty; its values (the CEO's, Finance's and a Super Admin's only): the purchase cost, supplier and invoice, the
// market value (low, mid, high, a note, when it last changed); when its label was printed; its disposal (method, day,
// amount received, who approved it, the book value then, notes; a manager's, step 4). Disposed assets stay, out of every
// total. Deleted only by a Super Admin, and only if it was never in custody.
model Asset {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique // PK-CAM-0003
  name               String
  group              String             @map("asset_group") // ASSET_GROUPS: studio, kit, it, office, consumable
  type               String             @map("asset_type") // ASSET_TYPES' codes: CAM, LEN …
  assetClass         String             @map("asset_class") // ASSET_CLASSES: fixed, current
  brand              String?
  model              String?
  serial             String?
  serialKey          String?            @map("serial_key") // the serial as serials are compared (packages/shared assetSerialKey): one asset's only (22 October 2026)
  condition          String? // ASSET_CONDITIONS: new, excellent, good, used, needs_repair; none for a consumable
  status             String             @default("available") // ASSET_STATUSES: available, custody, repair, lost, disposed
  roomId             String?            @map("room_id") @db.Uuid
  room               AssetRoom?         @relation(fields: [roomId], references: [id], onDelete: Restrict)
  kitId              String?            @map("kit_id") @db.Uuid // a production kit asset's only
  kit                AssetKit?          @relation(fields: [kitId], references: [id], onDelete: SetNull)
  holderId           String?            @map("holder_id") @db.Uuid // in custody: who holds it
  holder             Employee?          @relation("AssetHolder", fields: [holderId], references: [id], onDelete: Restrict)
  custodyId          String?            @map("custody_id") @db.Uuid // in custody: the record it went out on
  custody            CustodyRecord?     @relation("AssetCustodyNow", fields: [custodyId], references: [id], onDelete: Restrict)
  quantity           Decimal?           @db.Decimal(12, 2) // a consumable's only
  unit               String? // a consumable's: roll, pack, sheet …
  reorderLevel       Decimal?           @map("reorder_level") @db.Decimal(12, 2) // reorder when the quantity is at or under it
  purchaseDate       DateTime?          @map("purchase_date") @db.Date
  usefulLifeYears    Int?               @map("useful_life_years") // none for a consumable
  warrantyEnd        DateTime?          @map("warranty_end") @db.Date
  purchasePrice      Decimal?           @map("purchase_price") @db.Decimal(14, 2)
  supplier           String?
  invoiceNo          String?            @map("invoice_no")
  priceLow           Decimal?           @map("price_low") @db.Decimal(14, 2)
  marketValue        Decimal?           @map("market_value") @db.Decimal(14, 2)
  priceHigh          Decimal?           @map("price_high") @db.Decimal(14, 2)
  priceNote          String?            @map("price_note")
  priceUpdatedAt     DateTime?          @map("price_updated_at") @db.Timestamptz
  labeledAt          DateTime?          @map("labeled_at") @db.Timestamptz
  disposalMethod     String?            @map("disposal_method") // sold, scrapped, written_off, donated (step 4)
  disposedOn         DateTime?          @map("disposed_on") @db.Date
  disposalAmount     Decimal?           @map("disposal_amount") @db.Decimal(14, 2)
  disposalBookValue  Decimal?           @map("disposal_book_value") @db.Decimal(14, 2)
  disposalApprovedBy String?            @map("disposal_approved_by") // who approved it, as written
  disposalNotes      String?            @map("disposal_notes")
  disposedById       String?            @map("disposed_by") @db.Uuid
  disposedBy         User?              @relation("AssetDisposal", fields: [disposedById], references: [id], onDelete: SetNull)
  notes              String?
  createdById        String?            @map("created_by") @db.Uuid
  createdBy          User?              @relation("AssetCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  photos             AssetPhoto[]
  custodyItems       CustodyItem[]
  maintenance        AssetMaintenance[]
  stockMoves         AssetStockMove[]
  countLines         AssetCountLine[]
  drafts             AssetDraft[] // the draft it was confirmed from (step 2, the Claude connector)
  // step 4, accessories (owner, 22 October 2026: "Both kinds"): its checklist, and the main asset it is attached to
  // (one level only: the API checks it) with the assets attached to it
  accessories        AssetAccessory[]
  parentAssetId      String?            @map("parent_asset_id") @db.Uuid
  parent             Asset?             @relation("AssetAttached", fields: [parentAssetId], references: [id], onDelete: SetNull)
  attached           Asset[]            @relation("AssetAttached")

  @@index([group, status])
  @@index([status])
  @@index([roomId])
  @@index([kitId])
  @@index([holderId])
  @@index([parentAssetId])
  @@index([serialKey])
  @@map("assets")
}

// An asset's accessories' checklist (step 4; owner, 22 October 2026: "like laptop charger under the charger, DJI ronin
// accessories"; "Both kinds"): the small things that come with it, in order, each with how many and, when it has one, a
// serial; at most 30 an asset. A custody item keeps those that went out with it (accessories_out). Deleted with it.
model AssetAccessory {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position  Int
  name      String
  quantity  Int      @default(1)
  serial    String?
  serialKey String?  @map("serial_key") // as serials are compared: no other asset's, nor another's accessory's (22 October 2026)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([assetId, position])
  @@index([serialKey])
  @@map("asset_accessories")
}

// An asset's photo, up to 6 an asset, kept in the database as the employee file's papers are (the daily backup has it),
// in order: the first is the one the lists show. Served by the API to those with Assets access. Its kind (owner, 21
// October 2026: "let the mcp connector fetch the product photo and add it"): a photo of the item itself, or the maker's
// product image a draft from Claude brought, with where it came from (badged "Product image" wherever it shows).
model AssetPhoto {
  id            String   @id @default(uuid()) @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position      Int
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  sizeBytes     Int      @map("size_bytes")
  data          Bytes
  uploadedById  String?  @map("uploaded_by") @db.Uuid
  uploadedBy    User?    @relation("AssetPhotoUpload", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt    DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  kind          String   @default("photo") // ASSET_PHOTO_KINDS: photo (of the item itself), product (the maker's image)
  sourcePageUrl String?  @map("source_page_url") // a product image's: the page it came from
  imageUrl      String?  @map("image_url") // a product image's: the link it was fetched from
  caption       String? // a product image's caption, from Claude

  @@index([assetId, position])
  @@map("asset_photos")
}

// A custody record (spec §3, step 3): CUS-0042, assets handed over to an employee, for a shoot (with its return date) or
// as a long-term assignment (back at clearance); its purpose, who recorded it and who handed it over, the notes, the
// terms printed on its form (a snapshot), open, partly returned or closed. Its signed form is attached (CustodyFile).
model CustodyRecord {
  id               String        @id @default(uuid()) @db.Uuid
  code             String        @unique // CUS-0042
  kind             String // shoot, assignment
  employeeId       String        @map("employee_id") @db.Uuid
  employee         Employee      @relation("CustodyEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  purpose          String?
  dueDate          DateTime?     @map("due_date") @db.Date // a shoot's only
  issuedById       String?       @map("issued_by") @db.Uuid // who recorded it
  issuedBy         User?         @relation("CustodyIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  handedOverById   String?       @map("handed_over_by") @db.Uuid // the employee who handed it over
  handedOverBy     Employee?     @relation("CustodyHandedOverBy", fields: [handedOverById], references: [id], onDelete: SetNull)
  // who handed it over, as written on the form (step 3: the signed-in person unless changed)
  handedOverByName String?       @map("handed_over_by_name")
  outNotes         String?       @map("out_notes")
  terms            String[] // the terms printed on its form, as they were
  termsAr          String[]      @default([]) @map("terms_ar") // the Arabic terms beside them, as they were (24 October 2026); empty: none
  status           String        @default("open") // open, partial, closed
  outAt            DateTime      @default(now()) @map("out_at") @db.Timestamptz
  closedAt         DateTime?     @map("closed_at") @db.Timestamptz
  // the daily check (step 3): the last day the employee and the custodians were told it is overdue (once a day), and
  // when the custodians were told its signed copy is still not attached 3 days on (once)
  overdueNoticeOn  DateTime?     @map("overdue_notice_on") @db.Date
  unsignedNoticeAt DateTime?     @map("unsigned_notice_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  items            CustodyItem[]
  files            CustodyFile[]
  assetsNow        Asset[]       @relation("AssetCustodyNow")

  @@index([employeeId, status])
  @@index([status])
  @@map("custody_records")
}

// An asset on a custody record (step 3): its value when it went out (a value: the CEO's, Finance's and a Super Admin's
// only), its condition and accessories then; when it came back, in what state (good, damaged, missing), received by
// whom, with notes. An asset is out on one record at a time.
model CustodyItem {
  id                 String              @id @default(uuid()) @db.Uuid
  custodyId          String              @map("custody_id") @db.Uuid
  custody            CustodyRecord       @relation(fields: [custodyId], references: [id], onDelete: Restrict)
  assetId            String              @map("asset_id") @db.Uuid
  asset              Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  valueAtOut         Decimal?            @map("value_at_out") @db.Decimal(14, 2)
  conditionOut       String?             @map("condition_out")
  accessories        String?
  // step 4 (owner, 22 October 2026: accessories): the checklist's lines that went out with it ([{ name, quantity,
  // serial }], a snapshot) and, once back, those that didn't come back (empty: all did)
  accessoriesOut     Json?               @map("accessories_out")
  accessoriesMissing Json?               @map("accessories_missing")
  returnedAt         DateTime?           @map("returned_at") @db.Timestamptz
  returnCondition    String?             @map("return_condition") // good, damaged, missing
  receivedById       String?             @map("received_by") @db.Uuid
  receivedBy         User?               @relation("CustodyReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  returnNotes        String?             @map("return_notes")
  maintenance        AssetMaintenance[]
  // the deductions HR made from it, damaged or missing (owner, 21 October 2026: "Record it; HR decides a deduction")
  deductions         PayrollAdjustment[]

  @@unique([custodyId, assetId])
  @@index([assetId])
  @@map("custody_items")
}

// A custody record's signed form, photographed or scanned (step 3), kept in the database as the other files are.
model CustodyFile {
  id           String        @id @default(uuid()) @db.Uuid
  custodyId    String        @map("custody_id") @db.Uuid
  custody      CustodyRecord @relation(fields: [custodyId], references: [id], onDelete: Restrict)
  fileName     String        @map("file_name")
  mimeType     String        @map("mime_type")
  sizeBytes    Int           @map("size_bytes")
  data         Bytes
  uploadedById String?       @map("uploaded_by") @db.Uuid
  uploadedBy   User?         @relation("CustodyFileUpload", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime      @default(now()) @map("uploaded_at") @db.Timestamptz

  @@index([custodyId])
  @@map("custody_files")
}

// An asset's maintenance log (spec §3, step 4): a repair, service, inspection, warranty claim or upgrade on a day, its
// vendor, its cost (a value: the CEO's, Finance's and a Super Admin's only) and notes; one made by a damaged return
// names the custody item it came back on ("Returned damaged on CUS-0042 by …").
model AssetMaintenance {
  id            String       @id @default(uuid()) @db.Uuid
  assetId       String       @map("asset_id") @db.Uuid
  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  on            DateTime     @map("on_date") @db.Date
  kind          String // repair, service, inspection, warranty_claim, upgrade
  // what made it, when the register did (step 3): sent_to_repair, back_from_repair, returned_damaged; none: by hand
  event         String?
  vendor        String?
  cost          Decimal?     @db.Decimal(14, 2)
  notes         String?
  custodyItemId String?      @map("custody_item_id") @db.Uuid
  custodyItem   CustodyItem? @relation(fields: [custodyItemId], references: [id], onDelete: SetNull)
  createdById   String?      @map("created_by") @db.Uuid
  createdBy     User?        @relation("AssetMaintenanceBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([assetId, on])
  @@map("asset_maintenance")
}

// A consumable's stock moving (spec §3, step 4): used (−) or restocked (+), the quantity after it (never below 0), a
// note, by whom and when.
model AssetStockMove {
  id            String   @id @default(uuid()) @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  delta         Decimal  @db.Decimal(12, 2)
  quantityAfter Decimal  @map("quantity_after") @db.Decimal(12, 2)
  note          String?
  byId          String?  @map("by_user") @db.Uuid
  by            User?    @relation("AssetStockMoveBy", fields: [byId], references: [id], onDelete: SetNull)
  at            DateTime @default(now()) @db.Timestamptz

  @@index([assetId, at])
  @@map("asset_stock_moves")
}

// A count (spec §3, step 5): of a group, a room or a kit, its words as counted, when and by whom, notes, and how many
// were expected; each asset's result on its lines.
model AssetCount {
  id          String           @id @default(uuid()) @db.Uuid
  scopeKind   String           @map("scope_kind") // group, room, kit
  scopeGroup  String?          @map("scope_group") // a group's: ASSET_GROUPS
  scopeRoomId String?          @map("scope_room_id") @db.Uuid
  scopeRoom   AssetRoom?       @relation(fields: [scopeRoomId], references: [id], onDelete: Restrict)
  scopeKitId  String?          @map("scope_kit_id") @db.Uuid
  scopeKit    AssetKit?        @relation(fields: [scopeKitId], references: [id], onDelete: Restrict)
  scopeLabel  String           @map("scope_label")
  countedAt   DateTime         @default(now()) @map("counted_at") @db.Timestamptz
  countedById String?          @map("counted_by") @db.Uuid
  countedBy   User?            @relation("AssetCountBy", fields: [countedById], references: [id], onDelete: SetNull)
  notes       String?
  expected    Int
  lines       AssetCountLine[]

  @@index([scopeKind, countedAt(sort: Desc)])
  @@map("asset_counts")
}

// An asset's result in a count (step 5): found, missing (unticked) or out (in custody); "Mark lost" on a missing one
// is a deliberate step of its own, kept here (spec §6.5).
model AssetCountLine {
  id             String     @id @default(uuid()) @db.Uuid
  countId        String     @map("count_id") @db.Uuid
  count          AssetCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  assetId        String     @map("asset_id") @db.Uuid
  asset          Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  result         String // found, missing, out
  lostMarkedAt   DateTime?  @map("lost_marked_at") @db.Timestamptz
  lostMarkedById String?    @map("lost_marked_by") @db.Uuid
  lostMarkedBy   User?      @relation("AssetCountLostBy", fields: [lostMarkedById], references: [id], onDelete: SetNull)

  @@unique([countId, assetId])
  @@index([assetId])
  @@map("asset_count_lines")
}

// An asset drafted by Claude through the connector (step 2; owner, 21 October 2026: "help in the data entry"; the spec:
// "nothing is saved until a person presses Save"): never an asset, so in no total or list but Drafts from Claude. Its
// fields as the Add form takes them (packages/shared AssetInput), its values only from the CEO, Finance or a Super Admin
// (AssetValuesInput, shown only to them). A custodian or manager confirms it in the system (its code given then, the
// asset it became kept) or discards it; both kept, for the audit log.
model AssetDraft {
  id            String            @id @default(uuid()) @db.Uuid
  status        String            @default("open") // ASSET_DRAFT_STATUSES: open, confirmed, discarded
  source        String            @default("claude") // ASSET_DRAFT_SOURCES
  fields        Json
  values        Json?
  createdById   String?           @map("created_by") @db.Uuid
  createdBy     User?             @relation("AssetDraftCreation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  confirmedAt   DateTime?         @map("confirmed_at") @db.Timestamptz
  confirmedById String?           @map("confirmed_by") @db.Uuid
  confirmedBy   User?             @relation("AssetDraftConfirmation", fields: [confirmedById], references: [id], onDelete: SetNull)
  assetId       String?           @map("asset_id") @db.Uuid
  asset         Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  discardedAt   DateTime?         @map("discarded_at") @db.Timestamptz
  discardedById String?           @map("discarded_by") @db.Uuid
  discardedBy   User?             @relation("AssetDraftDiscard", fields: [discardedById], references: [id], onDelete: SetNull)
  images        AssetDraftImage[] // the maker's product images Claude added, up to 3 (moved to the asset on confirm)

  @@index([status, createdAt(sort: Desc)])
  @@map("asset_drafts")
}

// A product image on a draft from Claude (owner, 21 October 2026: "i want claude to add product image from its specs";
// "let the mcp connector fetch the product photo and add it / yes build it"; packages/shared product-images.ts): the
// maker's image (or a reputable store's) at a link Claude found, fetched by the website's MCP endpoint and kept here, up
// to 3 a draft, a JPEG, PNG or WebP of 100 to 8000 pixels a side, at most 5 MB, with the link and its source page.
// Confirmed, each becomes one of the asset's photos (kind 'product', its source kept) and leaves here; discarded, it is
// deleted with the draft's discard.
model AssetDraftImage {
  id            String     @id @default(uuid()) @db.Uuid
  draftId       String     @map("draft_id") @db.Uuid
  draft         AssetDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  position      Int
  fileName      String     @map("file_name")
  mimeType      String     @map("mime_type")
  sizeBytes     Int        @map("size_bytes")
  width         Int
  height        Int
  data          Bytes
  sourcePageUrl String     @map("source_page_url") // the page it came from, e.g. the maker's product page
  imageUrl      String     @map("image_url") // the link it was fetched from
  caption       String?
  addedById     String?    @map("added_by") @db.Uuid
  addedBy       User?      @relation("AssetDraftImageAdd", fields: [addedById], references: [id], onDelete: SetNull)
  addedAt       DateTime   @default(now()) @map("added_at") @db.Timestamptz

  @@index([draftId, position])
  @@map("asset_draft_images")
}

// ---------- offboarding ----------
// Owner, 21 October 2026, with the Employees list: "when an employee resigns or contract ends with no renewal, where will
// the data be stored? will it be another tab?"; 22 October 2026, the full module: "Former Employees tab, clearance
// checklist (assets returned, laptop, access), exit interview, rehire eligibility, turnover numbers". The rules:
// packages/shared offboarding.ts; the module: apps/api/src/offboarding.

// The default clearance checklist, HR's to change (Clearance Checklist): copied into each case when it opens, so a change
// never alters an open case. An item taken off is kept, switched off (active false), as records are never deleted here.
model ClearanceDefault {
  id          String   @id @default(uuid()) @db.Uuid
  position    Int
  label       String
  owner       String // CLEARANCE_OWNERS: hr, manager, admin, finance, assets
  active      Boolean  @default(true)
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("ClearanceDefaultChange", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([active, position])
  @@map("clearance_defaults")
}

// An employment's offboarding case, one at most: opened when the CEO approves its ending, when it is ended by hand, or by
// HR; cancelled when its ending is withdrawn (opened again by the next one approved). Open (in clearance) until HR
// completes it, every item cleared, or a Super Admin completes it anyway with a reason. Its rehire eligibility, and when
// HR was told every item is cleared (once).
model OffboardingCase {
  id              String            @id @default(uuid()) @db.Uuid
  employmentId    String            @unique @map("employment_id") @db.Uuid
  employment      Employment        @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  endingId        String?           @map("ending_id") @db.Uuid // the ending that opened it, if one did
  ending          EmploymentEnding? @relation(fields: [endingId], references: [id], onDelete: SetNull)
  status          String            @default("open") // OFFBOARDING_STATUSES: open, completed, cancelled
  openedById      String?           @map("opened_by") @db.Uuid // none: opened by the system
  openedBy        User?             @relation("OffboardingOpening", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt        DateTime          @default(now()) @map("opened_at") @db.Timestamptz
  completedById   String?           @map("completed_by") @db.Uuid
  completedBy     User?             @relation("OffboardingCompletion", fields: [completedById], references: [id], onDelete: SetNull)
  completedAt     DateTime?         @map("completed_at") @db.Timestamptz
  overrideReason  String?           @map("override_reason") // a Super Admin completed it with items pending: why
  cancelledAt     DateTime?         @map("cancelled_at") @db.Timestamptz
  clearedNoticeAt DateTime?         @map("cleared_notice_at") @db.Timestamptz // HR told every item is cleared
  rehire          String? // REHIRE_ELIGIBILITIES: eligible, conditional, not_eligible
  rehireReason    String?           @map("rehire_reason")
  rehireSetById   String?           @map("rehire_set_by") @db.Uuid
  rehireSetBy     User?             @relation("OffboardingRehire", fields: [rehireSetById], references: [id], onDelete: SetNull)
  rehireSetAt     DateTime?         @map("rehire_set_at") @db.Timestamptz
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  items           OffboardingItem[]
  interview       ExitInterview?

  @@index([status])
  @@index([endingId])
  @@map("offboarding_cases")
}

// A clearance item of a case, in order: one cleared by its owner (manual), or one the system ticks (assets: nothing left
// in custody; final_settlement: settled in payroll's Unsettled), whose state is read live while the case is open and kept
// when it is completed.
model OffboardingItem {
  id        String          @id @default(uuid()) @db.Uuid
  caseId    String          @map("case_id") @db.Uuid
  case      OffboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  position  Int
  kind      String          @default("manual") // CLEARANCE_KINDS: manual, assets, final_settlement
  label     String
  owner     String // CLEARANCE_OWNERS
  status    String          @default("pending") // CLEARANCE_ITEM_STATUSES: pending, done, not_applicable
  doneById  String?         @map("done_by") @db.Uuid
  doneBy    User?           @relation("OffboardingItemDone", fields: [doneById], references: [id], onDelete: SetNull)
  doneAt    DateTime?       @map("done_at") @db.Timestamptz
  note      String?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([caseId, position])
  @@map("offboarding_items")
}

// A case's exit interview, once sent (by the employee, or recorded by HR) or declined: the reason for leaving, the five
// ratings (1 to 5), whether they'd recommend working here, comments. Seen by HR, the CEO and a Super Admin (a C-level
// person's by the CEO and a Super Admin only), never the manager.
model ExitInterview {
  id            String          @id @default(uuid()) @db.Uuid
  caseId        String          @unique @map("case_id") @db.Uuid
  case          OffboardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  status        String // submitted, declined
  filledBy      String          @map("filled_by") // EXIT_FILLED_BY: employee, hr
  reason        String? // EXIT_REASONS
  ratingRole    Int?            @map("rating_role")
  ratingManager Int?            @map("rating_manager")
  ratingPay     Int?            @map("rating_pay")
  ratingGrowth  Int?            @map("rating_growth")
  ratingCulture Int?            @map("rating_culture")
  recommend     String? // EXIT_RECOMMENDS
  comments      String?
  declinedNote  String?         @map("declined_note")
  recordedById  String?         @map("recorded_by") @db.Uuid
  recordedBy    User?           @relation("ExitInterviewRecording", fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt    DateTime        @default(now()) @map("recorded_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@map("exit_interviews")
}

// A set-password link (owner, 22 October 2026: "Set-password link"): the first password (invite) or a new one (reset),
// for one account, valid 7 days, used once. Only the token's SHA-256 is kept; a new link cancels the older ones waiting.
model AccessLink {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation("AccessLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  purpose     String // invite, reset
  tokenHash   String    @unique @map("token_hash")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  createdBy   User?     @relation("AccessLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  emailed     Boolean   @default(false)

  @@index([userId, createdAt])
  @@map("access_links")
}

// Forgot password's and the set-password page's requests, counted for their limits (22 October 2026): by email, by
// address. Kept a day.
// A sign-in code by email (owner, 31 October 2026: "and i can add OTP via Mail for app login if the user didn't remember
// his password", "via app and web"; packages/shared login-codes.ts): 6 digits, kept only as an HMAC with the server's
// secret, working once for 10 minutes and 5 tries; a new one ends the one before (ended_at). Never shown again.
model LoginCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz
  ip        String?

  @@index([userId, createdAt])
  @@map("login_codes")
}

model AccessLinkRequest {
  id    String   @id @default(uuid()) @db.Uuid
  kind  String // forgot, set_failed, login_code (31 October 2026)
  email String?
  ip    String?
  at    DateTime @default(now()) @db.Timestamptz

  @@index([kind, email, at])
  @@index([kind, ip, at])
  @@map("access_link_requests")
}

// A 7 days' grace (owner, 23 October 2026: "Access should be on hold with a 7 days grace period one time granted by the
// hr"; asked, "Once per contract gap"): full access while no contract is in force, to the end of `until` (the 7th day
// after it was given, Cairo time), given by HR to someone on Hold. Its gap is the contract version whose end opened it
// (the signed one that ended last): one grace a gap (unique), never extended; a later gap (a new contract that ran out)
// allows another. With no contract entered (owner, 23 October 2026: "Hold them after 7 days") the gap is the employment
// with no signed contract (`contract_id` none, `employment_id` set), or, never employed, the person (both none: one, a
// partial unique index in the migration).
model AccessGrace {
  id           String      @id @default(uuid()) @db.Uuid
  employeeId   String      @map("employee_id") @db.Uuid
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractId   String?     @map("contract_id") @db.Uuid
  contract     Contract?   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  employmentId String?     @map("employment_id") @db.Uuid
  employment   Employment? @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  until        DateTime    @db.Date
  grantedById  String?     @map("granted_by") @db.Uuid
  grantedBy    User?       @relation("AccessGraceGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt    DateTime    @default(now()) @map("granted_at") @db.Timestamptz
  // "Your grace ends tomorrow" sent, once
  remindedAt   DateTime?   @map("reminded_at") @db.Timestamptz

  @@unique([employeeId, contractId])
  @@unique([employeeId, employmentId])
  @@index([until])
  @@map("access_graces")
}

// A company HR marked a marketing agency, or not one (owner, 27 October 2026: "Name words + your list"; packages/shared
// marketing-agencies.ts): by its name as compared (companyKey), winning over the name's words wherever a CV's work
// history names it.
model AgencyMark {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // companyKey(name)
  name        String // as HR wrote it, or as the CV did
  agency      Boolean
  updatedById String?  @map("updated_by") @db.Uuid
  updatedBy   User?    @relation("AgencyMarkBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("agency_marks")
}
