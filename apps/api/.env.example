DATABASE_URL="postgresql://trendlix:CHANGE_ME@localhost:5432/trendlix_hrms?schema=public"
PORT=3001
JWT_SECRET="CHANGE_ME_long_random_string"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"
TEST_DATABASE_URL="postgresql://trendlix:CHANGE_ME@localhost:5432/trendlix_hrms_test?schema=public"
# The OCR service (services/ocr) that reads scanned paperwork. Without it, documents are stored without their text.
# OCR_URL=http://localhost:8000
# The PDF converter (Gotenberg) that turns job offers into PDFs. Without it, offers are sent as Word files.
# PDF_URL=http://localhost:3000
# Email by SMTP, for sending job offers (see deploy/.env.example). Without SMTP_HOST and MAIL_FROM nothing is emailed.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="TrendLIX HR <hr@trendlix.com>"
