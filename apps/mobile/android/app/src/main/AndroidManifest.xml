<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Phase 4 (owner, 20 October 2026: "Push notifications: yes"; apps/mobile/README.md): a notification goes to the
             channel the app makes (PUSH_CHANNEL "general", through the Push Notifications plugin's createChannel), with
             the app's icon. These also let the plugin show a notification that arrives while the app is open. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phase 2 (owner, 20 October 2026; apps/mobile/README.md): the location for a check-in, asked by the system's own
         prompt and read only while the app is open (Android offers "while using the app"), precise to tell the office
         from remote (approximate only still checks in); never in the background, whatever a library asks for. The page
         says why it is asked; Android's prompts have no text of the app's. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <!-- the camera, for a photo of a receipt or a leave document (Take a photo) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Phase 4: notifications on Android 13 and later, asked by the system's prompt through the Push Notifications
         plugin's requestPermissions, after the page has said why (Home's "Get notified on this phone?") -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- neither is needed to install the app: without GPS or a camera it still checks in (location unknown) and sends files -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
